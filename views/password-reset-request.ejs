<main class="auth-page">
	<section class="auth-panel auth-panel--compact" aria-labelledby="reset-request-heading">
		<div class="auth-actions">
			<header class="auth-actions__header">
				<p class="auth-eyebrow">Account recovery</p>
				<h1 id="reset-request-heading">Reset your password</h1>
				<p>Enter the email you use for password sign-in.</p>
			</header>
			<% if (statusMessage) { %><div class="auth-status" role="status" aria-live="polite"><%= statusMessage %></div><% } %>
			<% if (errors.length) { %><div class="form-errors auth-errors" role="alert"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
			<form class="form auth-form" method="POST" action="/auth/password-reset/request">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
				<%- include("partials/shared/components/form/field", { field: { id: "reset-email", name: "email", label: "Email address", control: "input", type: "email", required: true, value: email, attributes: { autocomplete: "email", autofocus: true } } }) %>
				<%- include("partials/shared/components/button/button", { button: { label: "Send reset link", type: "submit", variant: "primary" } }) %>
			</form>
			<p class="auth-form-link"><a href="/auth/login">Back to sign in</a></p>
		</div>
	</section>
</main>
