<%
	const arr = [
	{heading: "Oi!", renderPanel: () => "123 123 123", collapsed: true},


	{heading: "Boa noite!", renderPanel: () => "abc abc abc abc abc abc abc abc vabc abc abc abc vabc abc vabc abc vabc abc vabc abc vabc abc vabc abc vabc abc vabc abc v",collapsed: true}
	]

%>

<main class="playground">
	<h1>ACCORDION PLAYGROUND</h1>

	<div class="examples">
		<%-include("../partials/shared/components/accordion/accordion", {accordion: {id: "accordion-test-0" ,heading: 123, renderPanel: () => 456}}) %>

		<% arr.forEach((row, index) => { %>
			<%- include("../partials/shared/components/accordion/accordion", {accordion:{...row, id: `accordion-test-${index+1}` }}) %>
		<% }) %>
	</div>
</main>
