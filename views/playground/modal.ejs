<%
	const modalId = "playgroundModalId";
%>


<main class="playground">
	<h1>TABS PLAYGROUND</h1>

	<div class="examples">


		<%- include("../partials/shared/components/button/button", {button: { 
			id: "modalButtonPlayground",
			type: "button",
			label: "Open...",
			variant: "secondary",
			attributes: {
				"data-modal-open": modalId,
			}
		}}) %>
	</div>
</main>


<%- contentFor("overlays") %>

<%- include("../partials/shared/components/modal/modal", { modal: { 
	id: modalId, 
	title: "Welcome to the modal", 
	renderContent: () => `
		<div>
			<p>This is the modal content.</p>
			<a href="#">This is a link</a>
		</div>`
	}})
%>