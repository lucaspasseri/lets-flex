<%
	const modalId = "modalWithForm";
%>

<main class="playground">
	<h2>FORM</h2>

	<div class="examples">
		<%- include("../partials/shared/components/form/form", {form: {
				heading: "Heading...",
				description: "Description, description...",
				action: "/test",
				slots: {
					body: include("partials/testForm")
				}			
			}}) 
		%>

		<br/>
		<br/>

		<%- include("../partials/shared/components/button/button", {button: {
				label: "Open create User Form",
				variant: "primary",
				attributes: {
					"data-modal-open" : modalId
				}
			}}) 
		%>
	</div>
</main>


<%- contentFor("overlays") %>

<%- include("../partials/shared/components/modal/modal", { modal: { 
		id: modalId ?? "Test", 
		title: "abc" ?? "More test", 
		showTitle: false,
		renderContent: () => include("../partials/shared/components/form/form", {form: {
			heading: "User name",
			description: "It will be use to identify yourself",
			action: "/fake-path",
			slots: {
				body: include("partials/fakeUserFormBody"),
				footer: include("partials/fakeUserFormFooter", { modalId })
			}			
	}})}})
%>
