<%
const currProgramId = locals.currentProgram ? locals.currentProgram.id : null;
const currProgram = locals.currentProgram || null;

const currDay = new Date();
const activeDay = daysDifference === null ? currDay : addDays(currDay,daysDifference);
const formattedActiveDay =formatDate(activeDay, "MMM dd, yyyy");

const currWeek = [addDays(activeDay, -3), addDays(activeDay, -2), addDays(activeDay, -1), activeDay, addDays(activeDay, 1), addDays(activeDay, 2), addDays(activeDay, 3)];

const cycleArr = locals.cycleArr || [];
const activeCycleId = locals.activeCycleId || [];
%>


<main class="main dashboard">
	<% if (!currProgramId) { %>
		<div class="main-header" >
			<p>OPERATIONAL STATUS</p>
			<h1>LETS'S FLEX</h1>
		</div>
	<% } %>

	<% if (!currProgramId) { %>
		<div class="sync-status">
			<div class="title-container">
				<p class="title">TEMPORAL SYNC</p>
				<p><%= formattedActiveDay %></p>
			</div>
			<div class="current-week-container">
				<ul>
					<% currWeek.forEach((day,index) => { %>
						<li class="week-day-item <%= index === 3 ? 'active' : '' %>">
							<span><%= formatDate(day, "EEE").toUpperCase() %></span> 
							<span><%= formatDate(day, "dd") %></span> 
						</li>
					<% }) %>
				</ul>
			</div>
		</div>
	<% } %>

	<% if (!currProgramId) { %>
		<div class="no-active-program-container">
			<div class="content">
				<div class="image-container">
					<img src="../compasso.png" width="40" height="40" alt="compasso icon" />
				</div>
				<h2>NO ACTIVE PROGRAM</h2>
				<p>Your training architecture starts here. Build a custom program or choose from a professional template to begin your progression.</p>
				<a href="/programs">
					<svg class="icon">
						<use href="../plus.svg"></use>
					</svg>
					<p>CREATE YOUR FIRST PROGRAM</p>
				</a>
			</div>
		</div>
	<% } %>

	<% if (currProgramId) { %>
		<div class="active-program-container">
			<p>CURRENT PROGRAM</p>
			<h1><%= currProgram.name %></h1>
		</div>
	<% } %>

	<% if (currProgramId) { %>
		<div class="date-session-container">
			
			<div class="current-day-container">
				<a href="<%= `/differenceInCalendarDays/${daysDifference -1}` %>" class="previousDayArrow" ><</a>
				<div class="current-day">
					<span><%= formatDate(activeDay, "dd / MM") %></span>
					<span><%= formatDate(activeDay, "EEEE").toUpperCase() %></span>
				</div>
				<a href="<%= `/differenceInCalendarDays/${daysDifference +1}` %>"class="nextDayArrow" >></a>
			</div>

			<% if (cycleArr.length > 0) { %>
				<div class="cycle-list-container">
					<ul>
						<% cycleArr.forEach(cycle => { %>
							<li class="cycle-list-item <%= cycle.id === activeCycleId ? 'active' : ''  %>">
								<span>
									<%= cycle.name.substring(0,2) %>
								</span>
							</li>
						<% }) %>
					</ul>
				</div>
			<% } %>

		</div>
	<% } %>


</main>
