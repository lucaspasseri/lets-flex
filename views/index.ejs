<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? "").replace(/\{\{(\w+)\}\}/g, (_match, name) => options[name] ?? _match); const { status, programBanner, dateNavigation, currentWorkout, analyticsSummary, heatmap, barChart, workload } = locals.components; %>
<main class="main dashboard" data-dashboard-page>
	<%- include("partials/dashboardPage/noActiveProgramSection", { status, translate }) %>
	<% if (programBanner.isVisible) { %>
		<div class="dashboard__active-program">
			<%- include("partials/dashboardPage/currentProgramBanner", { programBanner, translate }) %>
			<%- include("partials/dashboardPage/dateSection", { dateNavigation, translate }) %>
			<%- include("partials/dashboardPage/currentWorkoutSession", { currentWorkout, translate }) %>
		</div>
	<% } %>
	<% if (analyticsSummary.isVisible) { %>
		<section class="dashboard-analytics" aria-labelledby="<%= analyticsSummary.headingId %>">
			<header class="dashboard-analytics__heading">
				<p class="dashboard-eyebrow"><%= analyticsSummary.eyebrow %></p>
				<h2 id="<%= analyticsSummary.headingId %>"><%= analyticsSummary.title %></h2>
				<p><%= analyticsSummary.description %></p>
			</header>
			<%- include("partials/dashboardPage/analyticsSummary", { analyticsSummary, translate }) %>
			<div class="dashboard__metrics">
				<%- include("partials/dashboardPage/heatMap", { heatmap, translate }) %>
				<%- include("partials/dashboardPage/barChart", { barChart, translate }) %>
			</div>
			<%- include("partials/dashboardPage/workload", { workload, translate }) %>
		</section>
	<% } %>
</main>
<%- contentFor("overlays") %>
<%- contentFor("scripts") %>
<% if (barChart.showChart) { %>
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% } %>
