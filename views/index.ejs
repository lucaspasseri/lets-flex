<% 
const { range, addDays, formatDate, isSameDay,differenceInCalendarDays, startOfWeek } = locals.helpers;

const daysDifference = locals?.pageState?.daysDifference ?? null; 
const currProgramId = locals?.appState?.program?.id ?? null; 
const workoutSessionId = locals?.appState?.workoutSession?.id ?? null; 
const workoutSessionPerformedPercentage = locals.appState?.workoutSessionPerformedPercentage ?? 0;
const workoutSessionArrByDay = locals?.data?.workoutSessions?.itemsByTrainingDay ?? [];
const currentWorkoutSession = locals?.appState?.workoutSession ?? null; 
const workoutSessionArr = locals.data?.workoutSessions?.items ?? [];

const currProgram = locals?.appState?.program ?? null;

const cycleArr = locals.data?.cycles?.items ?? [];  

const startDate = currProgram?.start_date ?? null;

const getDate = (startDate, cycleArr, cycleIndex, cellIndex) => {
	let accCycleSize = 0;

	const obj = cycleArr.reduce((acc, curr, index) => {
		const currCycleSize = curr.cycle_size;

		for(let i =0; i < currCycleSize; i++){
			const currDate = startDate && addDays(startDate, accCycleSize + i);

			let offset = null;

			if(i === 0){
				const startOfWeekDate = startOfWeek(currDate);

				offset = differenceInCalendarDays(currDate, startOfWeekDate)
			}

			acc[`${index}-${i}`] = {currDate, offset};
		}

		accCycleSize += currCycleSize;

		return acc;
	}, {});

	return obj[`${cycleIndex}-${cellIndex}`];
}

%>
<main class="main dashboard">
	<%- include("partials/dashboardPage/noActiveProgramSection"); %>

	<% if( currProgramId !== null) { %>

		<%- include("partials/dashboardPage/currentProgramBanner"); %>

		<%- include("partials/dashboardPage/dateSection"); %>

		<div class="sessions-section <%= workoutSessionArrByDay.length === 0 ? 'no-session' : '' %>" data-workout-session-array="<%=JSON.stringify(workoutSessionArr) %>">
			<% if (workoutSessionArrByDay.length === 0) { %>
				<h2> ( RESTING / NO-SESSION DAY )</h2>

			<% } else if (workoutSessionArrByDay.length === 1) { %>
				<div class="sessions-container">
						<%- include('partials/sessionComponent/main', {
							sessionVm: currentWorkoutSession,
							performedPercentage: workoutSessionPerformedPercentage,
						}) %>
				</div>

			<% } else { %>
				<div class="sessions-container">
					<div class="change-active-session-container">
						<ul>
							<% workoutSessionArrByDay.forEach(wSession => { %>
								<li class="<%= wSession.id === workoutSessionId ? 'active-item' : '' %>">
									<a href="<%= `/?daysDifference=${daysDifference}&workoutSessionId=${wSession.id}` %>"></a>
								</li>

						
							<% }) %>
						</ul>
					</div>

					<%- include('partials/sessionComponent/main', {
						sessionVm: currentWorkoutSession,
						performedPercentage: workoutSessionPerformedPercentage,
					}) %>
						
				</div>
			<% } %>
		</div>
 	<% } %>

	<% if(currProgramId !== null && workoutSessionArr.length > 0) { %>
		<div class="heat-map-section">
			<h2><%= `${currProgram?.name.toUpperCase() ?? "PROGRAM"}'S METRICS`%></h2>
			<div class="grid-container">
				<div class="grid">
					<div class="cell">
						<p>SUN</p>
					</div>
					<div class="cell">
						<p>MON</p>
					</div>
					<div class="cell">
						<p>TUE</p>
					</div>
					<div class="cell">
						<p>WED</p>
					</div>
					<div class="cell">
						<p>THU</p>
					</div>
					<div class="cell">
						<p>FRI</p>
					</div>
					<div class="cell">
						<p>SAT</p>
					</div>
				</div>
				<% cycleArr.forEach((cycle, cycleIndex) => {%>
					<p><%= cycle.name %></p>
					<div class="grid">
						<% range(cycle.cycle_size).forEach((_cell, cellIndex) => { %>
							<% 
								const {currDate, offset} = getDate(startDate, cycleArr, cycleIndex, cellIndex) ;
								const workoutSessionFilteredByDate = workoutSessionArr.filter(ws => ws.finished_at && isSameDay(currDate, ws.finished_at));
								const cellClass = workoutSessionFilteredByDate.length === 0 ? "no-workout-session" : (workoutSessionFilteredByDate.length === 1 ? "one-workout-session" : "many-workout-session");
							%>

							<% if(offset !== null && offset !== 0){ %>
								<% range(offset).forEach( emptyCell => { %>
									<div></div>
								<% }) %>

							<% } %>

							<div class="cell <%= cellClass %>">
								<p><%= formatDate(currDate, "dd/MM") %></p>
							</div>
						<% }) %>
					</div>
				<% }) %>
			</div>
		</div>
	<% } %>

	<% if(currProgramId !== null && workoutSessionArr.length > 0) { %>
		<div class="canvas-container">
			<canvas id="test-canvas"></canvas>
		</div>
	<% } %>

	<%- contentFor("overlays") %>

	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/@date-fns/cdn@4.4.0/cdn.min.js"></script>
	<script src="/js/canvasTest.js"></script>

</main>
