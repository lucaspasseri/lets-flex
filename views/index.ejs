<%
const currUrl = locals.page?.url ?? "";
const currPath = locals.page?.path ?? "";
const {addDays, formatDate, isSameDay} = locals.helpers;

const currUserId = locals.sessionState?.userId ?? null;
const currProgramId = locals.sessionState?.programId ?? null;
const currSessionId = locals.sessionState?.sessionId ?? null;
const daysDifference = locals.sessionState?.daysDifference ?? null;
const workoutSessionId = locals.sessionState?.workoutSessionId ?? null;

const currDay = new Date();
const activeDay = locals.sessionState?.activeDay ?? currDay;

const currProgram = locals.appState?.currentProgram ?? {};
const currTrainingDay = locals.appState?.currentTrainingDay ?? {};
const sessionArrByTrainingDay = locals?.appState?.sessionArrByTrainingDay ?? [];

const cycleArr = locals.data?.cycleArr ?? [];
const sessionArr = locals.data?.sessionArr ?? [];
const sessionStepArr = locals.data?.sessionStepArr ?? [];

const workoutSessionInProgressArr = locals.data?.workoutSessionInProgressArr ?? [];

const formattedActiveDay = formatDate && formatDate(activeDay, "MMM dd, yyyy");

const currWeek = addDays && [addDays(activeDay, -3), addDays(activeDay, -2), addDays(activeDay, -1), activeDay, addDays(activeDay, 1), addDays(activeDay, 2), addDays(activeDay, 3)];

const filterSessionsByDay = (sessionArr, day) => {
	return (isSameDay && sessionArr.filter(session => isSameDay(session.scheduled_date, day)) || []);
}
%>


<main class="main dashboard">
	<% if (!currProgramId) { %>
		<div class="main-header" >
			<p>OPERATIONAL STATUS</p>
			<h1>LETS'S FLEX</h1>
		</div>
	<% } %>

	<% if (!currProgramId) { %>
		<div class="sync-status">
			<div class="title-container">
				<p class="title">TEMPORAL SYNC</p>
				<p><%= formattedActiveDay %></p>
			</div>
			<div class="current-week-container">
				<ul>
					<% currWeek.forEach((day,index) => { %>
						<li class="week-day-item <%= index === 3 ? 'active' : '' %>">
							<span><%= formatDate(day, "EEE").toUpperCase() %></span> 
							<span><%= formatDate(day, "dd") %></span> 
						</li>
					<% }) %>
				</ul>
			</div>
		</div>
	<% } %>

	<% if (!currUserId) { %>
		<div class="no-active-program-container">
			<div class="content">
				<div class="image-container">
					<img src="../compasso.png" width="40" height="40" alt="compasso icon" />
				</div>
				<h2>NO ACTIVE USER</h2>
				<p>Your training architecture starts here. Create and activate your profile to enjoy the best features.</p>
				<a href="/profile">
					<svg class="icon">
						<use href="../plus.svg"></use>
					</svg>
					<p>CREATE YOUR USER PROFILE</p>
				</a>
			</div>
		</div>
	<% } %>

	<% if (!currProgramId) { %>
		<div class="no-active-program-container">
			<div class="content">
				<div class="image-container">
					<img src="../compasso.png" width="40" height="40" alt="compasso icon" />
				</div>
				<h2>NO ACTIVE PROGRAM</h2>
				<p>Your training architecture starts here. Build a custom program or choose from a professional template to begin your progression.</p>
				<a href="/programs">
					<svg class="icon">
						<use href="../plus.svg"></use>
					</svg>
					<p>CREATE YOUR FIRST PROGRAM</p>
				</a>
			</div>
		</div>
	<% } %>

	<% if (currProgramId) { %>
		<div class="active-program-container">
			<p>CURRENT PROGRAM</p>
			<h1><%= currProgram.name %></h1>
		</div>
	<% } %>

	<% if (currProgramId) { %>
		<div class="date-section">

			<% if (cycleArr.length > 0) { %>
				<div class="cycle-list-container">
					<ul>
						<% cycleArr.forEach(cycle => { %>
							<li class="cycle-list-item <%= cycle.id === currTrainingDay.cycle_id ? 'active' : ''  %>">
								<span>
									<%= cycle.name.substring(0,2) %>
								</span>
							</li>
						<% }) %>
					</ul>
				</div>
			<% } %>
			
			<div class="current-day-container">
				<a href="<%= `/?daysDifference=${daysDifference -1}` %>" class="previousDayArrow" ><</a>
				<div class="current-day">
					<span><%= formatDate(activeDay, "dd / MM") %></span>
					<span><%= formatDate(activeDay, "EEEE").toUpperCase() %></span>
				</div>
				<a href="<%= `/?daysDifference=${daysDifference +1}` %>"class="nextDayArrow" >></a>
			</div>

			<% if (sessionArr.length > 0) { %>
				<div class="training-day-list-container">
					<ul>
						<% currWeek.forEach( (day, index) => { %>
							<li class="<%= index === 3 ? 'active' : '' %>">
								<span><%= formatDate(day, "EEE") %></span>
								<div class="week-day <%= index === 3 ? 'active' : '' %>">
									<% const filteredSessionArr = filterSessionsByDay(sessionArr, day); %>
									<% if(filteredSessionArr.length === 0) { %>
										<p>REST</p>

									<% } else if(filteredSessionArr.length === 1) { %>
										<p>
											<%= filteredSessionArr[0].session_name.substring(0,4) %>
										</p>

									<% } else { %>
										<div class="multiple-session-container">
											<p>
												<%= filteredSessionArr[0].session_name.substring(0,4) %>
											</p>
											<% if(filteredSessionArr.length > 1) { %>
												<div class="additional-session-indicator">
													<% filteredSessionArr.forEach((session, index) => { %>
														<div class="additional-indication"></div>
													<% }) %>
												</div>
											<% } %>
										</div>
									<% } %>
								</div>
							</li>
						<% }) %>
					</ul>
				</div>
			<% } %>
		</div>
	<% } %>
	
	<% if(currProgramId) { %>
		<div class="sessions-section <%= sessionArrByTrainingDay.length === 0 ? "no-session" : "" %>">
			<% if (sessionArrByTrainingDay.length === 0) { %>
				<h2> ( RESTING / NO-SESSION DAY )</h2>

			<% } else if (sessionArrByTrainingDay.length === 1) { %>
				<div class="sessions-container">
						<%- include('partials/sessionComponent' ); %>
				</div>

			<% } else { %>
				<div class="sessions-container">
					<div class="change-active-session-container">
						<ul>
							<% sessionArrByTrainingDay.forEach(session => { %>
								<li>
									<a href="<%= `/?daysDifference=${daysDifference}&sessionId=${session.id}` %>"></a>
								</li>
							<% }) %>
						</ul>
					</div>

					<%- include('partials/sessionComponent' ); %>
				</div>
			<% } %>
		</div>
	<% } %>
</main>
