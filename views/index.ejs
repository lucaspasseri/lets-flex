<% 
const daysDifference = locals?.pageState?.daysDifference ?? null; 
const currProgramId = locals?.appState?.program?.id ?? null; 
const workoutSessionId = locals?.appState?.workoutSession?.id ?? null; 
const workoutSessionPerformedPercentage = locals.appState?.workoutSessionPerformedPercentage ?? 0;
const workoutSessionArrByDay = locals?.data?.workoutSessions?.itemsByTrainingDay ?? [];
const currentWorkoutSession = locals?.appState?.workoutSession ?? null; 

%>
<main class="main dashboard">
	<%- include("partials/dashboardPage/noActiveProgramSection"); %>

	<% if( currProgramId !== null) { %>

		<%- include("partials/dashboardPage/currentProgramBanner"); %>

		<%- include("partials/dashboardPage/dateSection"); %>

		<div class="sessions-section <%= workoutSessionArrByDay.length === 0 ? 'no-session' : '' %>">
			<% if (workoutSessionArrByDay.length === 0) { %>
				<h2> ( RESTING / NO-SESSION DAY )</h2>

			<% } else if (workoutSessionArrByDay.length === 1) { %>
				<div class="sessions-container">
						<%- include('partials/sessionComponent/main', {
							sessionVm: currentWorkoutSession,
							performedPercentage: workoutSessionPerformedPercentage,
						}) %>
				</div>

			<% } else { %>
				<div class="sessions-container">
					<div class="change-active-session-container">
						<ul>
							<% workoutSessionArrByDay.forEach(wSession => { %>
								<li class="<%= wSession.id === workoutSessionId ? 'active-item' : '' %>">
									<a href="<%= `/?daysDifference=${daysDifference}&workoutSessionId=${wSession.id}` %>"></a>
								</li>

						
							<% }) %>
						</ul>
					</div>

					<%- include('partials/sessionComponent/main', {
						sessionVm: currentWorkoutSession,
						performedPercentage: workoutSessionPerformedPercentage,
					}) %>
						
				</div>
			<% } %>
		</div>
 	<% } %>
</main>
