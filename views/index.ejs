<% 
	const currProgramId = locals?.appState?.program?.id ?? null; 
%>

<main class="main dashboard">
	<%- include("partials/dashboardPage/noActiveProgramSection"); %>

	<% if( currProgramId !== null) { %>

		<%- include("partials/dashboardPage/currentProgramBanner"); %>

		<%- include("partials/dashboardPage/dateSection"); %>

		<%- include("partials/dashboardPage/currentWorkoutSession") %>
 	<% } %>


	<%- include("partials/dashboardPage/heatMap") %>

	<%- include("partials/dashboardPage/barChart") %>

	<%- contentFor("overlays") %>

	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/@date-fns/cdn@4.4.0/cdn.min.js"></script>
	<script src="/js/barChartCanvas.js"></script>

</main>
