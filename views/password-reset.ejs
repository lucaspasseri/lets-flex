<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? "").replace(/\{\{(\w+)\}\}/g, (_match, name) => options[name] ?? _match); %>
<main class="auth-page">
	<section class="auth-panel auth-panel--compact" aria-labelledby="reset-heading">
		<div class="auth-actions">
			<header class="auth-actions__header">
				<p class="auth-eyebrow"><%= translate("auth.recovery", { defaultValue: "Account recovery" }) %></p>
				<h1 id="reset-heading"><%= translate("auth.chooseNewPassword", { defaultValue: "Choose a new password" }) %></h1>
				<p><%= translate("auth.passwordLengthHint", { defaultValue: "Use at least 12 characters." }) %></p>
			</header>
			<% if (errors.length) { %><div class="form-errors auth-errors" role="alert" aria-live="polite"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
			<% if (token) { %>
			<form class="form auth-form" method="POST" action="/auth/password-reset">
				<input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="token" value="<%= token %>" />
				<%- include("partials/shared/components/form/field", { field: { id: "reset-password", name: "password", label: translate("auth.newPassword", { defaultValue: "New password" }), control: "input", type: "password", required: true, attributes: { autocomplete: "new-password", minlength: 12, autofocus: true } } }) %>
				<%- include("partials/shared/components/form/field", { field: { id: "reset-confirm-password", name: "confirmPassword", label: translate("auth.confirmNewPassword", { defaultValue: "Confirm new password" }), control: "input", type: "password", required: true, attributes: { autocomplete: "new-password", minlength: 12 } } }) %>
				<%- include("partials/shared/components/button/button", { button: { label: translate("auth.resetPasswordSubmit", { defaultValue: "Reset password" }), type: "submit", variant: "primary" } }) %>
			</form>
			<% } %>
			<p class="auth-form-link"><a href="/auth/password-reset/request"><%= translate("auth.requestNewLink", { defaultValue: "Request a new link" }) %></a></p>
		</div>
	</section>
</main>
