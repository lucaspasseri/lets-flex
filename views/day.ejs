<%
const currDayId = locals.sessionState?.dayId ?? null;
const trainingDayArr = locals.data?.trainingDayArr ?? [];
const sessionArr = locals.data?.sessionArr ?? [];
const workoutSessionArr = locals.data?.workoutSessionArr ?? [];


const backUrl = locals.page?.backUrl ?? "";
const { formatDate, addDays } = locals.helpers;

const currProgram = locals.appState?.currentProgram ?? {};
const currTrainingDay = locals.appState?.currentTrainingDay ?? null;
const formattedScheduledDate = currTrainingDay?.scheduled_date ? (formatDate && formatDate(currTrainingDay.scheduled_date, "dd/MM/yyyy")) : "Date outside the programs's boundaries";

const startDate = currProgram?.start_date && new Date(currProgram.start_date) || new Date();

const getScheduledDate = (index) => {
	const date = formatDate && addDays && formatDate(addDays(startDate, index ), "dd/MM/yyyy");
	return date;
}

const getNavLinkHref = (dayId) => {
	return `/programs/day?dayId=${dayId}`;
}

const trainingDayIdArr = trainingDayArr.map( day => day.training_day_id);
%>
<main class="main day">

	<div class="current-day-container session-selected" data-calendar-day-id="<%= currDayId %>">
		<h1><%= formattedScheduledDate %></h1>
	</div>

	<% if(trainingDayArr.length > 0){ %>
		<nav class="day-rail-wrapper">
			<% if(trainingDayIdArr.includes(currDayId-1)) {%>
				<a href="<%= getNavLinkHref(currDayId - 1) %>" class="day-arrow" data-scroll-left><span><</span></a>
			<% } %>
			<ul class="day-rail" id="dayRail">
				<% trainingDayArr.forEach((trainingDay,index) => { %>
					<li><a href="<%= getNavLinkHref(trainingDay?.training_day_id) %>" class="day-card <%= currDayId === trainingDay.training_day_id ? 'active' : '' %>"><%= getScheduledDate(index) %></a></li>
				<% }) %>
			</ul>
			<% if(trainingDayIdArr.includes(currDayId+1)) {%>
				<a href="<%= getNavLinkHref(currDayId + 1) %>" class="day-arrow" data-scroll-right><span>></span></a>
			<% } %>
		</nav>
	<% } %>



	<div class="link-training-day-with-session-container">
		<% if(workoutSessionArr.length === 0) { %>
			<div class="no-session">
				<h2> The current day does not yet have any training sessions associated with it.</h2>
				<p>You can link a session template here.</p>
			</div>
		<% } else { %>
			<div class="at-least-one-session">
				<h2> <%= `The current day has ${workoutSessionArr.length} workout session(s) linked to it.` %> </h2>
			</div>
		<% } %>

		<form action="/workout_sessions" method="POST" class="forms">
			<input hidden type="text" name="trainingDayId" value="<%= currDayId %>" />
			<%- include("partials/select", { data: { id: "sessionSelect", label: "Session template", name: "sessionId", required: true, 
			options: sessionArr, getOptionLabel: (session) => session.name, getOptionValue: (session) => session.id  } }); %>

			<%- include('partials/simpleButton', { data: { text: "Submit", type: "submit" } }); %>
		</form>
	</div>

	<% if(workoutSessionArr.length > 0 ) { %>
		<div class="workout-session-list-container">
			<ul>
				<% workoutSessionArr.forEach(wSession => { %>
					<li>
							<%- include("partials/session/sessionCard", {session: wSession}) %>
					</li>
				<% }) %>
			</ul>
		</div>
	<% } %>


</main>

<script>
	const rail = document.getElementById("dayRail");
	const activeDay = rail?.querySelector(".day-card.active");

	activeDay?.scrollIntoView({
		behavior: "instant",
		inline: "center",
		block: "nearest",
	});

	document.querySelector("[data-scroll-left]")?.addEventListener("click", () => {
		rail.scrollBy({ left: -240, behavior: "smooth" });
	});

	document.querySelector("[data-scroll-right]")?.addEventListener("click", () => {
		rail.scrollBy({ left: 240, behavior: "smooth" });
	});
</script>
