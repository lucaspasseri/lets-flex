<%
const { formatDate, addDays } = locals.helpers;

const backUrl = locals.page?.backUrl ?? "";

const currCycleId = locals.sessionState?.cycleId || null; 
const currSessionId = locals.sessionState?.sessionId || null;
const currDayId = locals.sessionState?.dayId || null;

const currProgram = locals.appState?.currentProgram ?? {};
const scheduledDate = locals.appState?.scheduledDate ?? null;

const sessionArr = locals.data?.sessionArr ?? [];
const trainingDayArr = locals.data?.trainingDayArr ?? [];
const sessionStepArr = locals.data?.sessionStepArr ?? [];

const formattedScheduledDate = scheduledDate ? (formatDate && formatDate(scheduledDate, "dd/MM/yyyy")) : "No date";

const sessionBasicLineId = "dayPageSessionBasicLine";
const sessionBasicLineEntity = "session";
const createSessionModalId = "createSessionModal";
const chosenSessionPath = `/programs/day?dayId=${currDayId}&sessionId=`;
const createSessionStepModalId = "createSessionStepModal";


const startDate = currProgram?.start_date && new Date(currProgram.start_date) || new Date();

const getScheduledDate = (index) => {
	const date = formatDate && addDays && formatDate(addDays(startDate, index ), "dd/MM/yyyy");
	return date;
}

const getNavLinkHref = (trainingDay) => {
	return `/programs/day?dayId=${trainingDay.training_day_id}`;
}

const currSession = sessionArr.find(session => session.id === currSessionId) || {};

const renderContent = (content) => {
	return `
	<div class="session-step-accordion-content">
		<p><strong>Step order:</strong> ${content.step_order}</p>
		<p><strong>Name:</strong> ${content.name}</p>
		<p><strong>Description:</strong> ${content?.description}</p>
		<p><strong>Sets:</strong> ${content.sets}</p>
		<p><strong>Reps:</strong> ${content.reps}</p>
		<p><strong>Load:</strong> ${content.load_value} ${content.load_unit}</p>
	</div>
	`;
}
%>
<main class="main day">
	<% if(trainingDayArr.length > 0){ %>
		<nav class="day-rail-wrapper">
			<button class="day-arrow" data-scroll-left>‹</button>
			<ul class="day-rail" id="dayRail">
				<% trainingDayArr.forEach((trainingDay,index) => { %>
					<li><a href="<%= getNavLinkHref(trainingDay) %>" class="day-card <%= currDayId === trainingDay.training_day_id ? 'active' : '' %>"><%= getScheduledDate(index) %></a></li>
				<% }) %>
			</ul>
			<button class="day-arrow" data-scroll-right>›</button>
		</nav>
	<% } %>

	<div class="current-day-container training-day-item session-selected" data-calendar-day-id="<%= currDayId %>">
		<h1><%= formattedScheduledDate %></h1>
	</div>

	<div class="session-selection-container">
		<% if( sessionArr.length === 0){ %>
			<div>
				<h1>SESSION<br />INITIALIZATION</h1>
				<p>
					Enter precise baseline metric to calibrate the performance engine.
					Accuracy is required for optimal load calculation and volume prescription.
				</p>
			</div>
		<% } else { %>
				<h2>CHOOSE THE ACTIVE SESSION</h2>
		<% } %>
		<%- include("partials/newBasicLine", {line: { basicLineId: sessionBasicLineId, entity: sessionBasicLineEntity, arr: sessionArr, modalId: createSessionModalId, currentItemId: currSessionId, path: chosenSessionPath }}) %>
	</div>


	<% if(sessionArr.length > 0){ %>
		<div class="session-step-container">
			<div>
				<span>SESSION <%= currSession.session_order %>: <%= currSession.name %></span>
				<h3>Exercises</h3>
			</div>
			<% if(currSessionId && sessionStepArr.length !== 0){ %>
				<ul>
					<%- include("partials/accordion", { contentArr: sessionStepArr, renderContent: renderContent }) %>
				</ul>
			<% } %>
			<button type="button" class="button" data-modal-open="<%= createSessionStepModalId %>">ADD EXERCISE</button>
		</div>
	<% } %>
</main>

<script>
	const rail = document.getElementById("dayRail");
	const activeDay = rail?.querySelector(".day-card.active");

	activeDay?.scrollIntoView({
		behavior: "instant",
		inline: "center",
		block: "nearest",
	});

	document.querySelector("[data-scroll-left]")?.addEventListener("click", () => {
		rail.scrollBy({ left: -240, behavior: "smooth" });
	});

	document.querySelector("[data-scroll-right]")?.addEventListener("click", () => {
		rail.scrollBy({ left: 240, behavior: "smooth" });
	});
</script>

<%- contentFor("overlays") %>

<%- include("partials/basicModal", {
	modal: {
		id: createSessionModalId,
		title: "Create session",
		description: "Fill in the session information below.",
		renderContent: () => include("partials/sessionForm")
	}
}) %>

<%- include("partials/basicModal", {
	modal: {
		id: createSessionStepModalId,
		title: "Create session step",
		description: "Fill in the step information below.",
		renderContent: () => include("partials/stepForm")
	}
}) %>