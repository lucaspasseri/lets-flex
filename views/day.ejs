<%
	const { workoutFeedback, contextPath, dayHeader, dayNavigation, sessionLinkForm, workoutSessionList } = locals.components;
%>

<main class="main day-page" data-day-page data-workout-tracker>
	<% if (contextPath.isVisible) { %>
		<nav class="day-context-path" aria-label="Program hierarchy">
			<a href="<%= contextPath.backHref %>">Programs</a>
			<span aria-hidden="true">/</span>
			<span><%= contextPath.programName %></span>
			<span aria-hidden="true">/</span>
			<span><%= contextPath.cycleName %></span>
			<span aria-hidden="true">/</span>
			<strong aria-current="page"><%= contextPath.dayName %></strong>
		</nav>
	<% } %>
	<% if (workoutFeedback) { %>
		<%- include("partials/sessionComponent/feedback", { feedback: workoutFeedback }) %>
	<% } %>
	<header
		class="day-page__hero"
		data-calendar-day-id="<%= dayHeader.dayId ?? "" %>"
		<% if (dayHeader.viewTransitionName) { %>
			style="view-transition-name: <%= dayHeader.viewTransitionName %>; view-transition-class: program-calendar-day"
		<% } %>
	>
		<p class="day-page__eyebrow">Level 3 · Training day</p>
		<h1><%= dayHeader.title %></h1>
		<p class="day-page__date"><%= dayHeader.dateLabel %></p>
		<p class="day-page__status"><%= dayHeader.statusLabel %></p>
		<p class="day-page__intro"><%= dayHeader.intro %></p>
	</header>

	<%- include("partials/dayPage/dayNavigation", { dayNavigation }) %>

	<div class="day-page__content">
		<%- include("partials/dayPage/sessionLinkPanel", { sessionLinkForm }) %>
		<%- include("partials/dayPage/workoutSessionList", { workoutSessionList }) %>
	</div>
</main>

<%- contentFor("overlays") %>
<% workoutSessionList.cancelModals.forEach(cancelModal => { %>
	<%- include("partials/shared/components/modal/modal", { modal: {
		id: cancelModal.id,
		title: cancelModal.title,
		renderContent: () => include("partials/deleteSessionWorkoutForm", { form: cancelModal.form, modalId: cancelModal.id }),
	} }) %>
<% }) %>

<%- contentFor("scripts") %>
<script type="module" src="/js/pages/day/index.js"></script>
