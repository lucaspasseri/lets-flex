<% 
const exerciseArr = locals.data?.exerciseVariantArr ?? []; 

const sessionArr = locals.data?.sessionArr?.filter(session => session.isArchived === false) ?? [];

const createSessionModalId = "createSessionModal";
const createExerciseModalId = "createExerciseModal"; 
const deleteExerciseModalId = "deleteExerciseModalId";
const deleteSessionModalId = "deleteSessionModalId";

const pairedSessionArr = sessionArr.reduce((acc, session, index) => {
	if(index %2 === 0) {
		acc.push([session]);
	} else {
		acc[acc.length - 1].push(session);
	}
	return acc;
}, []);

const {currentSession } = locals?.appState ?? null;
%>

<main class="main library">
	<div class="main-header">
		<div class="title-container">
			<p>ASSET MANAGER</p>
			<h1>Library</h1>
		</div>
		<div class="button-container">
			<button type="button" data-modal-open="<%= createSessionModalId %>">+</button>
		</div>
	</div>

	<div class="search-container">
		<div>
			<label for="search">Q</label>
			<input
				id="libraryPageSearchInput"
				name="search"
				class="search-exercise-input"
				type="search"
				placeholder="SEARCH EXERCISES..."
			/>
		</div>
	</div>

	<div class="session-template-container">
		<div class="header">
			<h2>Session Templates</h2>
			<p id="sessionArrSizeIndication"><%=`${sessionArr.length} TOTAL` %></p>
		</div>
		<div class="list-container">
			<ul class="session-template-list">
				<% sessionArr.forEach(session => { %>
					<li>
						<%- include("partials/libraryPage/sessionTemplateArticle", {sessionTemplate: session}) %>
					</li>
				<% }) %>
			</ul>
		</div>
	</div>

	<% if(currentSession !== null){ %>
		<div class="active-session-template-container">
			<h3>SESSION DETAILS</h3>

			<%- include("partials/session/sessionCard", { session: currentSession, modalId: deleteSessionModalId }) %>
		</div>
	<% } %>

	<div class="exercise-variants-container">
		<div class="header">
			<h2>Exercise Templates</h2>
			<p id="exerciseArrSizeIndication"><%=`${exerciseArr.length} TOTAL` %></p>
		</div>
		<div class="list-container">
			<ul class="accordion">
				<% exerciseArr.forEach(exercise => { %>
					<li>
						<%- include("partials/libraryPage/exerciseTemplateArticle", {exerciseTemplate: exercise, deleteExerciseModalId}) %>
					</li>
				<% }) %>
			</ul>
		</div>
	<div class="custom-exercise-button-container">
		<button type="button" class="button" data-modal-open="<%= createExerciseModalId %>">ADD NEW</button>
	</div>
</main>

<script>

const searchInput = document.getElementById("libraryPageSearchInput");

const searchSessionItemArr = Array.from(document.querySelectorAll("article[data-search-session-item]"));
const searchExerciseItemArr = Array.from(document.querySelectorAll("article[data-search-exercise-item]"));

const sessionArrSizeIndication = document.getElementById("sessionArrSizeIndication");
const exerciseArrSizeIndication = document.getElementById("exerciseArrSizeIndication");

searchInput.addEventListener("input", (ev) => {
	const queryText = ev.target.value.trim().toLowerCase();

	let sessionArrSize = searchSessionItemArr.length;
	let exerciseArrSize = searchExerciseItemArr.length;

	searchSessionItemArr.forEach(item => {
		const searchText = item.dataset.searchText ?? "";

		const shouldBeHidden = !searchText.toLowerCase().includes(queryText);

		item.closest("li").hidden = shouldBeHidden;

		if (shouldBeHidden) {
			sessionArrSize -= 1;
		}
	});

	searchExerciseItemArr.forEach(item => {
		const searchText = item.dataset.searchText ?? "";

		const shouldBeHidden = !searchText.toLowerCase().includes(queryText);

		item.closest("li").hidden = shouldBeHidden;

		if (shouldBeHidden) {
			exerciseArrSize -= 1;
		}
	});

	sessionArrSizeIndication.textContent = `${sessionArrSize} TOTAL`;
	exerciseArrSizeIndication.textContent = `${exerciseArrSize} TOTAL`;
});
</script>

<%- contentFor("overlays") %>

<%- include("partials/basicModal", {
	modal: {
		id: createSessionModalId,
		title: "Create session",
		description: "Fill in the session information below.",
		renderContent: () => include("partials/sessionForm")
	}
}) %>

<%- include("partials/basicModal", {
	modal: {
		id: createExerciseModalId,
		title: "Create exercise",
		description: "Fill in the exercise information below.",
		renderContent: () => include("partials/exerciseClusterForm")
	}
}) 
%>

<%- include("partials/basicModal", {
	modal: {
		id: deleteExerciseModalId,
		title: "Delete exercise",
		description: "",
		renderContent: () => include("partials/deleteExerciseForm")
	}
}) 
%>

<%- include("partials/basicModal", {
	modal: {
		id: deleteSessionModalId,
		title: "Delete session template",
		description: "",
		renderContent: () => include("partials/deleteSessionForm", {currSessionId: currentSession?.id ?? null})
	}
}) 
%>


