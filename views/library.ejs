<%
	const {
		sessionWorkspace,
		exerciseTemplates,
		createSessionForm,
		updateSessionForm,
		createExerciseForm,
		updateExerciseForm,
		deleteExerciseForm,
		archiveSessionForm
	} = locals.components;
	const managementMode = Boolean(locals.managementMode);
	const privateVariantForm = locals.components.privateVariantForm;
%>

<main class="main library" data-library-page>
	<div class="main-header">
		<div class="title-container">
			<p>ASSET MANAGER</p>
			<h1>Library</h1>
		</div>
	</div>
	<%- include("partials/libraryPage/librarySearch") %>
	<%- include("partials/libraryPage/sessionWorkspace/base", { sessionWorkspace }) %>
	<%- include("partials/libraryPage/exerciseTemplates", { exerciseTemplates }) %>
	<% if (!managementMode) { %>
		<section aria-labelledby="create-private-variant-heading">
			<h2 id="create-private-variant-heading">Create your own exercise variant</h2>
			<p>Your variant is private to this account.</p>
			<form class="form" method="POST" action="/exercises/0/variants" data-private-variant-form>
				<input type="hidden" name="_csrf" value="<%= locals?.csrfToken ?? '' %>">
				<label>Exercise<select name="exerciseId" required><option value="">Choose exercise</option><% privateVariantForm.exercises.forEach(exercise => { %><option value="<%= exercise.id %>"><%= exercise.name %></option><% }) %></select></label>
				<label>Variant name<input name="name" maxlength="100" required></label>
				<label>Equipment<select name="equipmentId"><option value="">None</option><% privateVariantForm.equipments.forEach(equipment => { %><option value="<%= equipment.id %>"><%= equipment.name %></option><% }) %></select></label>
				<button type="submit">Create private variant</button>
			</form>
		</section>
	<% } %>
	<% if (managementMode) { %>
		<section aria-labelledby="create-global-variant-heading">
			<h2 id="create-global-variant-heading">Create global variant</h2>
			<form class="form" method="POST" action="/admin/library/exercises/0/variants" data-global-variant-form>
				<input type="hidden" name="_csrf" value="<%= locals?.csrfToken ?? '' %>">
				<label>Exercise<select name="exerciseId" required><option value="">Choose exercise</option><% privateVariantForm.exercises.forEach(exercise => { %><option value="<%= exercise.id %>"><%= exercise.name %></option><% }) %></select></label>
				<label>Variant name<input name="name" maxlength="100" required></label>
				<label>Equipment<select name="equipmentId"><option value="">None</option><% privateVariantForm.equipments.forEach(equipment => { %><option value="<%= equipment.id %>"><%= equipment.name %></option><% }) %></select></label>
				<button type="submit">Create global variant</button>
			</form>
		</section>
	<% } %>
</main>

<%- contentFor("overlays") %>
<% if (!managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: createSessionForm.modal.id,
	title: createSessionForm.modal.title,
	showTitle: false,
	openOnLoad: createSessionForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...createSessionForm.form,
		attributes: { "data-create-session-form": true },
		slots: {
			body: include("partials/libraryPage/createSessionForm/createSessionFormBody", { sessionForm: createSessionForm }),
			footer: include("partials/libraryPage/createSessionForm/createSessionFormFooter", { sessionForm: createSessionForm })
		}
	}})
} }) %><% } %>

<% if (!managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: archiveSessionForm.modal.id,
	title: archiveSessionForm.modal.title,
	showTitle: false,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...archiveSessionForm.form,
		attributes: { "data-archive-session-form": true },
		slots: {
			footer: include("partials/libraryPage/archiveSessionTemplateForm/archiveSessionFormFooter", { archiveSessionForm })
		}
	}})
} }) %><% } %>

<% if (!managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: updateSessionForm.modal.id,
	title: updateSessionForm.modal.title,
	showTitle: false,
	openOnLoad: updateSessionForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...updateSessionForm.form,
		attributes: { "data-update-session-form": true },
		slots: {
			body: include("partials/libraryPage/createSessionForm/createSessionFormBody", { sessionForm: updateSessionForm }),
			footer: include("partials/libraryPage/createSessionForm/createSessionFormFooter", { sessionForm: updateSessionForm })
		}
	}})
} }) %><% } %>

<% if (managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: updateExerciseForm.modal.id,
	title: updateExerciseForm.modal.title,
	showTitle: false,
	openOnLoad: updateExerciseForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...updateExerciseForm.form,
		attributes: { "data-update-exercise-form": true },
		slots: {
			body: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormBody", { exerciseForm: updateExerciseForm }),
			footer: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormFooter", { exerciseForm: updateExerciseForm })
		}
	}})
} }) %><% } %>

<% if (managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: deleteExerciseForm.modal.id,
	title: deleteExerciseForm.modal.title,
	showTitle: false,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...deleteExerciseForm.form,
		attributes: { "data-delete-exercise-form": true },
		slots: {
			footer: include("partials/libraryPage/deleteExerciseTemplateForm/deleteExerciseFormFooter", { deleteExerciseForm })
		}
	}})
} }) %><% } %>

<% if (managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: createExerciseForm.modal.id,
	title: createExerciseForm.modal.title,
	showTitle: false,
	openOnLoad: createExerciseForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...createExerciseForm.form,
		attributes: { "data-create-exercise-form": true },
		slots: {
			body: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormBody", { exerciseForm: createExerciseForm }),
			footer: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormFooter", { exerciseForm: createExerciseForm })
		}
	}})
} }) %><% } %>

<%- contentFor("scripts") %>
<script type="module" src="/js/pages/library/index.js"></script>
<script>document.querySelector('[data-private-variant-form]')?.addEventListener('submit', event => { const form = event.currentTarget; form.action = `/exercises/${form.elements.exerciseId.value}/variants`; });</script>
<script>document.querySelector('[data-global-variant-form]')?.addEventListener('submit', event => { const form = event.currentTarget; form.action = `/admin/library/exercises/${form.elements.exerciseId.value}/variants`; });</script>
