<%
	const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? "").replace(/\{\{(\w+)\}\}/g, (_match, name) => options[name] ?? _match);
	const {
		pageFeedback,
		sessionWorkspace,
		exerciseTemplates,
		createSessionForm,
		updateSessionForm,
		createExerciseForm,
		updateExerciseForm,
		deleteExerciseForm,
		deleteSessionForm
	} = locals.components;
	const managementMode = Boolean(locals.managementMode);
	const privateVariantForm = locals.components.privateVariantForm;
	const pageHeading = locals.components.pageHeading;
	const planningContext = locals.components.planningContext;
%>

<main class="main library<%= managementMode ? ' library--admin' : '' %>" data-library-page data-library-mode="<%= managementMode ? 'admin' : 'personal' %>">
	<%- include("partials/shared/components/pageHeading", { heading: pageHeading }) %>
	<%- include("partials/shared/components/pageFeedback", { pageFeedback }) %>

	<% if (planningContext.isVisible) { %>
		<aside class="library-planning-context" aria-labelledby="library-planning-context-title">
			<span class="library-planning-context__icon" aria-hidden="true"><%- include("partials/shared/components/icons/namedIcon", { name: "calendar-range" }) %></span>
			<div>
				<p class="library-planning-context__eyebrow"><%= translate("library.trainingDayContext", { defaultValue: "Training day context" }) %></p>
				<h2 id="library-planning-context-title"><%= planningContext.title %></h2>
				<p><%= planningContext.pathLabel %> · <%= planningContext.dateLabel %></p>
				<p><%= planningContext.description %></p>
			</div>
			<a href="<%= planningContext.backHref %>"><%= translate("library.returnWithoutCreating", { defaultValue: "Return without creating" }) %></a>
		</aside>
	<% } %>

	<% if (managementMode) { %>
		<aside class="library-admin-scope" aria-label="<%= translate("library.adminScope", { defaultValue: "Administrator access scope" }) %>">
			<span class="library-admin-scope__icon" aria-hidden="true"><%- include("partials/shared/components/icons/namedIcon", { name: "wrench" }) %></span>
			<div><strong><%= translate("library.globalCatalogAccess", { defaultValue: "Global catalog access" }) %></strong><p><%= translate("library.globalCatalogPrivacy", { defaultValue: "This view does not expose member or guest profiles, sessions, or private variants." }) %></p></div>
			<div class="library-admin-scope__links">
				<a href="/admin/translations"><%= translate("translationMaintenance.openOverview", { defaultValue: "Review translations" }) %></a>
				<a href="/library"><%= translate("library.returnToLibrary", { defaultValue: "Return to personal Library" }) %></a>
			</div>
		</aside>
	<% } %>

	<% if (!managementMode) { %>
		<div class="library-discovery" data-tabs data-library-section-tabs>
			<div class="library-discovery__tabs" data-tab-list role="tablist" aria-label="<%= translate("library.content", { defaultValue: "Library content" }) %>">
				<button id="library-sessions-tab" type="button" role="tab" data-tab aria-selected="true" aria-controls="library-sessions-panel" tabindex="0">
					<span><%= translate("library.sessions", { defaultValue: "Sessions" }) %></span>
					<small><%= sessionWorkspace.summaries.countLabel %></small>
				</button>
				<button id="library-exercises-tab" type="button" role="tab" data-tab aria-selected="false" aria-controls="library-exercises-panel" tabindex="-1">
					<span><%= translate("library.exercises", { defaultValue: "Exercises" }) %></span>
					<small><%= exerciseTemplates.countLabel %></small>
				</button>
			</div>

			<section id="library-sessions-panel" class="library-discovery__panel" data-tab-panel role="tabpanel" aria-labelledby="library-sessions-tab" tabindex="0">
				<%- include("partials/libraryPage/sessionWorkspace/base", { sessionWorkspace, t: translate }) %>
			</section>

			<section id="library-exercises-panel" class="library-discovery__panel" data-tab-panel role="tabpanel" aria-labelledby="library-exercises-tab" tabindex="0">
				<%- include("partials/libraryPage/exerciseTemplates", { exerciseTemplates, t: translate }) %>
				<%- include("partials/libraryPage/createVariantForm", { variantForm: privateVariantForm, t: translate }) %>
			</section>
		</div>
	<% } else { %>
		<%- include("partials/libraryPage/exerciseTemplates", { exerciseTemplates, t: translate }) %>
		<%- include("partials/libraryPage/createVariantForm", { variantForm: privateVariantForm, t: translate }) %>
	<% } %>
</main>

<%- contentFor("overlays") %>
<% if (!managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: createSessionForm.modal.id,
	title: createSessionForm.modal.title,
	showTitle: false,
	openOnLoad: createSessionForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...createSessionForm.form,
		attributes: { "data-create-session-form": true },
		slots: {
			body: include("partials/libraryPage/createSessionForm/createSessionFormBody", { sessionForm: createSessionForm, t: translate }),
			footer: include("partials/libraryPage/createSessionForm/createSessionFormFooter", { sessionForm: createSessionForm })
		}
	}})
} }) %><% } %>

<% if (!managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: deleteSessionForm.modal.id,
	title: deleteSessionForm.modal.title,
	showTitle: false,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...deleteSessionForm.form,
		attributes: { "data-delete-session-form": true },
		slots: {
			footer: include("partials/libraryPage/deleteSessionForm/deleteSessionFormFooter", { deleteSessionForm })
		}
	}})
} }) %><% } %>

<% if (!managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: updateSessionForm.modal.id,
	title: updateSessionForm.modal.title,
	showTitle: false,
	openOnLoad: updateSessionForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...updateSessionForm.form,
		attributes: { "data-update-session-form": true },
		slots: {
			body: include("partials/libraryPage/createSessionForm/createSessionFormBody", { sessionForm: updateSessionForm, t: translate }),
			footer: include("partials/libraryPage/createSessionForm/createSessionFormFooter", { sessionForm: updateSessionForm })
		}
	}})
} }) %><% } %>

<% if (managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: updateExerciseForm.modal.id,
	title: updateExerciseForm.modal.title,
	showTitle: false,
	openOnLoad: updateExerciseForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...updateExerciseForm.form,
		attributes: { "data-update-exercise-form": true },
		slots: {
			body: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormBody", { exerciseForm: updateExerciseForm, t: translate }),
			footer: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormFooter", { exerciseForm: updateExerciseForm })
		}
	}})
} }) %><% } %>

<% if (managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: deleteExerciseForm.modal.id,
	title: deleteExerciseForm.modal.title,
	showTitle: false,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...deleteExerciseForm.form,
		attributes: { "data-delete-exercise-form": true },
		slots: {
			footer: include("partials/libraryPage/deleteExerciseTemplateForm/deleteExerciseFormFooter", { deleteExerciseForm })
		}
	}})
} }) %><% } %>

<% if (managementMode) { %><%- include("partials/shared/components/modal/modal", { modal: {
	id: createExerciseForm.modal.id,
	title: createExerciseForm.modal.title,
	showTitle: false,
	openOnLoad: createExerciseForm.modal.openOnLoad,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...createExerciseForm.form,
		attributes: { "data-create-exercise-form": true },
		slots: {
			body: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormBody", { exerciseForm: createExerciseForm, t: translate }),
			footer: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormFooter", { exerciseForm: createExerciseForm })
		}
	}})
} }) %><% } %>

<%- contentFor("scripts") %>
<script type="module" src="/js/pages/library/index.js"></script>
