<% 
	const sessionWorkspace = locals?.features?.sessionWorkspace ?? {};
	const exerciseTemplates = locals?.features?.exerciseTemplates ?? {};
%>

<main class="main library">
	<div class="main-header">
		<div class="title-container">
			<p>ASSET MANAGER</p>
			<h1>Library</h1>
		</div>
	</div>

	<%- include("partials/libraryPage/librarySearch") %>

	<%- include("partials/libraryPage/sessionWorkspace/base", { sessionWorkspace: {}}) %>

	<%- include("partials/libraryPage/exerciseTemplates", {exerciseTemplates }) %>

</main>

<%- contentFor("overlays") %>

<script type="module" src="/js/pages/library.js"></script>

<%- include("partials/shared/components/modal/modal", { modal: { 
		id: sessionWorkspace?.createAction?.modalId ?? null, 
		title:sessionWorkspace?.createAction?.modalId ?? "Create session template", 
		renderContent: () => include("partials/libraryPage/sessionForm")
	}}) 
%>

// hard coded values

<%- include("partials/shared/components/modal/modal", { modal: { 
		id: exerciseTemplates?.actions?.create?.modalId ?? "createExerciseModalId", 
		title: exerciseTemplates?.actions?.create?.label ?? "Create exercise template", 
		showTitle: false,
		renderContent: () => include("partials/shared/components/form/form", {form: {
			id: "create-exercise-template-form",
			heading: "Create exercise template",
			description: "Define a reusable exercise template.",
			action: "/exerciseTemplates",
			slots: {
				body: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormBody"),
				footer: include("partials/libraryPage/createExerciseTemplateForm/createExerciseFormFooter", {modalId: exerciseTemplates?.actions?.create?.modalId ?? "createExerciseModalId"}),
			}			
	}})}})
%>