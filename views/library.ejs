<% 
const exerciseArr = locals.data?.exerciseVariantArr ?? []; 
const createExerciseModalId = "createExerciseModal"; 
const sessionArr = locals.data?.sessionArr ?? [];





const createSessionModalId = "createSessionModal";

const pairedSessionArr = sessionArr.reduce((acc, session, index) => {
		if(index %2 === 0) {
			acc.push([session]);
		} else {
			acc[acc.length - 1].push(session);
		}
		return acc;
	}, []);

const renderContent = (content) => {
	return `
	<div class="session-step-accordion-content">
		<p><strong>Name:</strong> ${content.name}</p>
		<p><strong>Movement pattern:</strong> ${content.movement_pattern_name}</p>
		<p><strong>Equipment name:</strong> ${content.equipment_name}</p>			
		<p><strong>Setup description:</strong> ${content.setup_description}</p>
		<p><strong>Environment:</strong> ${content.environment}</p>
		<p><strong>Notes:</strong> ${content.notes}</p>
	</div>
	`;
}

const getMuscleListBySession = (session) => {
	const distinctSessions = new Set();

	session.steps.forEach(step => {
		step.muscles.forEach(muscle => {
			distinctSessions.add(muscle.common_name)
		})
	});

	const iterator = distinctSessions.values();
	let output = "";
	let condition = true;
	while(condition){
		const currValue = iterator.next().value;
		if(currValue === undefined){
			condition = false;
			continue;
		}
		
		if(output === ""){
			output = currValue;
		} else {
			output += ` ${currValue}`
		}
	}

	return output;
}
%>

<main class="main library">
	<div class="main-header">
		<div class="title-container">
			<p>ASSET MANAGER</p>
			<h1>Library</h1>
		</div>
		<div class="button-container">
			<button type="button"  data-modal-open="<%= createSessionModalId %>">+</button>
			
		</div>
	</div>

	<div class="search-container">
		<form>
			<label for="search">Q</label>
			<input
				id="search"
				name="search"
				class="search-exercise"
				type="search"
				placeholder="SEARCH EXERCISES..."
			/>
		</form>
	</div>

	<div class="session-template-container">
		<div class="header">
			<h2>Session Templates</h2>
			<p><%=`${sessionArr.length} TOTAL` %></p>
		</div>
		<div class="list-container">
			<ul>
				<% pairedSessionArr.forEach(sessionPair => { %>
					<div class="paired-session-card">
						<li>
							<div class="session-card">
								<div class="header">
								<div>
										<p class="title"><%= sessionPair[0].name %></p>
									<p class="subtitle"><%= sessionPair[0].notes %></p>
								</div>
									<div class="settings">
											<span>
												♤
											</span>
											<span>
												♧
											</span>
									</div>
								</div>
								<div class="body">
									<div class="status">
										<p> <%= getMuscleListBySession(sessionPair[0]) %></p>
									</div>
								</div>
							</div>
						</li>

						<% if(sessionPair[1]) { %>
							<li>
								<div class="session-card">
									<div class="header">
										<div>
											<p class="title"><%= sessionPair[1].name %></p>
											<p class="subtitle"><%= sessionPair[1].notes %></p>
										</div>
										<div class="settings">
											<span>
												♤
											</span>
											<span>
												♧
											</span>
										</div>
									</div>
									<div class="body">
										<div class="status">
											<p><%= getMuscleListBySession(sessionPair[1]) %></p>
										</div>
									</div>
								</div>
							</li>
						<% } %>
					</div>
				<% }) %>
			</ul>
		</div>
	</div>

	<div class="active-session-template-container"></div>

	<div class="exercise-variants-container">
		<div class="header">
			<h2>Exercise Templates</h2>
			<p><%=`${exerciseArr.length} TOTAL` %></p>
		</div>
		<div class="list-container">
			<ul>
				<%- include("partials/accordion", { contentArr: exerciseArr, renderContent: renderContent }) %>
			</ul>
	</div>
	<div class="custom-exercise-button-container">
		<button type="button" class="button" data-modal-open="<%= createExerciseModalId %>">ADD NEW</button>
	</div>
</main>

<%- contentFor("overlays") %>

<%- include("partials/basicModal", {
	modal: {
		id: createSessionModalId,
		title: "Create session",
		description: "Fill in the session information below.",
		renderContent: () => include("partials/sessionForm")
	}
}) %>

<%- include("partials/basicModal", {
	modal: {
		id: createExerciseModalId,
		title: "Create exercise",
		description: "Fill in the exercise information below.",
		renderContent: () => include("partials/exerciseClusterForm")
	}
}) 
%>
