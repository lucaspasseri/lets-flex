<% 
const sessionWorkspace = locals?.features?.sessionWorkspace ?? null;
const exerciseTemplates = locals?.features?.exerciseTemplates ?? null;

console.log({sessionWorkspace});
console.log({exerciseTemplates});
%>

<main class="main library">
	<div class="main-header">
		<div class="title-container">
			<p>ASSET MANAGER</p>
			<h1>Library</h1>
		</div>
	</div>

	<%- include("partials/libraryPage/librarySearch") %>

	<%- include("partials/libraryPage/sessionWorkspace/base", { sessionWorkspace}) %>

	<%- include("partials/libraryPage/exerciseTemplates", {exerciseTemplates}) %>

</main>

<script>

const searchInput = document.getElementById("library-search");

const searchSessionItemArr = Array.from(document.querySelectorAll("[data-search-session-item]"));
const searchExerciseItemArr = Array.from(document.querySelectorAll("[data-search-exercise-item]"));

const sessionArrSizeIndication = document.querySelector(".session-summaries__count");
const exerciseArrSizeIndication = document.querySelector(".exercise-templates__count");

searchInput.addEventListener("input", (ev) => {
	const queryText = ev.target.value.trim().toLowerCase();

	let sessionArrSize = searchSessionItemArr.length;
	let exerciseArrSize = searchExerciseItemArr.length;

	searchSessionItemArr.forEach(item => {
		const searchText = item.dataset.searchKeyWord ?? "";

		const shouldBeHidden = !searchText.toLowerCase().includes(queryText);

		item.closest("li").hidden = shouldBeHidden;

		if (shouldBeHidden) {
			sessionArrSize -= 1;
		}
	});

	searchExerciseItemArr.forEach(item => {
		const searchText = item.dataset.searchKeyWord ?? "";

		const shouldBeHidden = !searchText.toLowerCase().includes(queryText);

		item.closest("li").hidden = shouldBeHidden;

		if (shouldBeHidden) {
			exerciseArrSize -= 1;
		}
	});

	sessionArrSizeIndication.textContent = `${sessionArrSize}`;
	exerciseArrSizeIndication.textContent = `${exerciseArrSize} TEMPLATES`;
});
</script>

<%- contentFor("overlays") %>

<%- include("partials/shared/components/modal/modal", { modal: { 
		id: sessionWorkspace?.createAction?.modalId ?? null, 
		title:sessionWorkspace?.createAction?.modalId ?? "Create session template", 
		renderContent: () => include("partials/libraryPage/sessionForm")
	}}) 
%>

<%- include("partials/shared/components/modal/modal", { modal: { 
		id:exerciseTemplates?.actions?.create?.modalId ?? null, 
		title: exerciseTemplates?.actions?.create?.label ?? "Create exercise template", 
		renderContent: () => include("partials/libraryPage/exerciseClusterForm")
	}}) 
%>


