<main class="recovery-page">
	<section class="recovery-panel" aria-labelledby="recovery-title">
		<p class="recovery-eyebrow"><%= recovery.eyebrow %></p>
		<h1 id="recovery-title"><%= recovery.title %></h1>
		<p class="recovery-message"><%= recovery.message %></p>
		<a class="shared-button shared-button--primary recovery-action" href="<%= recovery.actionHref %>">
			<span class="shared-button__label"><%= recovery.actionLabel %></span>
		</a>
	</section>
</main>
