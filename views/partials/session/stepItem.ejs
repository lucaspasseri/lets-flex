

<li class="workout-step">
	<div class="workout-step__order" aria-hidden="true"><%= step.orderLabel %></div>
	<% if (step.media) { %>
		<img
			class="workout-step__media"
			data-media-fallback="true"
			src="<%= step.media.src %>"
			width="<%= step.media.width %>"
			height="<%= step.media.height %>"
			alt=""
			aria-hidden="true"
			loading="lazy"
			decoding="async"
		>
	<% } %>
	<div class="workout-step__content">
		<div class="workout-step__main">
		<strong class="workout-step__title">
			<%= step.title %>
		</strong>

		<span class="workout-step__prescription">
			<%= step.prescriptionLabel %>
		</span>

		<% if (step.loadLabel) { %>
			<span class="workout-step__load">
				<%= step.loadLabel %>
			</span>
		<% } %>
		</div>
	<div class="workout-step__details">
		<% step.details.forEach(detail => { %>
			<span><%= detail %></span>
		<% }) %>
	</div>
	</div>
</li>
