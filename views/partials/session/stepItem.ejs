

<li class="step-item">
	<div class="step-item-main">
		<strong class="step-item-title">
			<%= step.title %>
		</strong>

		<span class="step-item-meta">
			<%= step.prescriptionLabel %>
		</span>

		<% if (step.loadLabel) { %>
			<span class="step-item-load">
				<%= step.loadLabel %>
			</span>
		<% } %>
	</div>

	<div class="step-item-details">
		<% step.details.forEach(detail => { %>
			<span><%= detail %></span>
		<% }) %>
	</div>
</li>
