<header class="session-card-header">
	<div>
		<h2 class="session-card-title">
			<%= header.title %>
		</h2>

		<% if (header.notes) { %>
			<p class="session-card-notes">
				<%= header.notes %>
			</p>
		<% } %>
	</div>

	<% if (header.statusLabel) { %>
		<span class="session-card-status">
			<%= header.statusLabel %>
		</span>
	<% } %>

	<div class="settings">
		<button type="button" class="button" data-modal-open="<%= header.modalId %>" aria-label="<%= header.deleteActionLabel %>">
			<%- include("../icons/trash",  {strokeColor: "black"}) %>
		</button>
	</div>
</header>
