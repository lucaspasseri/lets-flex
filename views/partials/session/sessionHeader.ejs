<%
const modalId = locals?.modalId ?? null;
%>

<header class="session-card-header">
	<div>
		<h2 class="session-card-title">
			<%= session?.name %>
		</h2>

		<% if (session?.notes) { %>
			<p class="session-card-notes">
				<%= session?.notes %>
			</p>
		<% } %>
	</div>

	<% if (session?.type === "workout" && session?.status) { %>
		<span class="session-card-status">
			<%= session?.status %>
		</span>
	<% } %>

	<div class="settings">
		<button type="button" class="button" data-modal-open="<%= modalId %>">
			<%- include("../icons/trash") %>
		</button>
	</div>
</header>