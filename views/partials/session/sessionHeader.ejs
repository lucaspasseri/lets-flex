<header class="workout-card__header">
	<% if (header.media) { %>
		<%- include("../shared/components/media", { media: header.media, className: "workout-card__media", variant: "initial", decorative: true }) %>
	<% } %>
	<div class="workout-card__heading">
		<h3 class="workout-card__title">
			<%= header.title %>
		</h3>

		<% if (header.notes) { %>
			<p class="workout-card__notes">
				<%= header.notes %>
			</p>
		<% } %>
	</div>

	<% if (header.statusLabel) { %>
		<span class="workout-card__status workout-card__status--<%= header.statusLabel %>">
			<%= header.statusLabel %>
		</span>
	<% } %>

	<% if (header.modalId && header.deleteActionLabel) { %>
		<%- include("../shared/components/button/button", { button: {
			type: "button",
			label: header.deleteActionLabel,
			variant: "ghost",
			iconOnly: true,
			alternativeClassname: "workout-card__delete",
			attributes: { "data-modal-open": header.modalId },
			renderIcon: () => include("../shared/components/icons/namedIcon", { name: "trash" }),
		} }) %>
	<% } %>
</header>
