<%
const currDayId = locals.sessionState?.dayId ?? null;
const sessionArr = locals.data?.sessionArr ?? [];
sessionArr.push({session_order: sessionArr.length + 1});
%>

<form class="forms" action="/sessions" method="POST">

	<input hidden type="text" name="trainingDayId" value="<%= currDayId %>" />
	<%- include('olaInput', { data: { label: "Name", type: "text", name: "name", context: "sessionForm", autocomplete: "name", required: true } }); %>
	<%- include("select", { data: { id: "sessionOrderSelect", label: "Session Order", name: "sessionOrder", required: true, 
	options: sessionArr, getOptionLabel: (session) => session.session_order, getOptionValue: (session) => session.session_order  } }); %>

	<%- include('simpleButton', { data: { text: "Submit", type: "submit" } }); %>
</form>

