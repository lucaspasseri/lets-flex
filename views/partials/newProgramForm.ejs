<%
const goalArr = locals?.data?.goals?.items ?? [];
const currUser = locals?.appState?.user ?? null;
%>

<form class="forms" action="/programs" method="POST">

	<input hidden type="text" name="userId" value="<%= currUser?.id %>" />
	<%- include('olaInput', { data: { label: "Name", type: "text", name: "name", context: "programForm", autocomplete: "name", required: true } }); %>
	<%- include('select', { data: { label: "Goals", name: "goalId", options: goalArr, required: true } })	%>
	<%- include('olaInput', { data: { label: "Start date", type: "date", name: "startDate", context: "userForm" } }); %>

	<%- include('simpleButton', { data: { text: "Submit", type: "submit" } }); %>
</form>

