<%
const currWorkoutSession = locals.appState?.currentWorkoutSession ?? {};
const currSessionId = locals.sessionState?.sessionId ?? null;
const currSession = locals.appState?.currentSession ?? null;

const activeDaySessionArr = locals.data?.activeDaySessionArr ?? [];
const sessionStepArr = locals.data?.sessionStepArr ?? [];
const workoutStepLogArr = locals.data?.workoutStepLogArr ?? [];

const isWorkoutSessionActive = currWorkoutSession?.session_id === currSessionId;
const doesTheSessionHaveSteps = sessionStepArr.length > 0;
const doesTheWorkoutSessionHaveSteps = workoutStepLogArr.length > 0;
const activeSession = locals.appState?.currentSession ?? null;
%>

<div class="session-component">
	<% if(isWorkoutSessionActive ) { %>
		<div class="session-header">
			<h3>
				<%= 
					activeSession?.name
				%>
			</h3>
			<% if(doesTheSessionHaveSteps) { %>
				<div class="complete-indicator-container">
					<span>
						0% COMPLETE
					</span>
				</div>
			<% } %>
		</div>

		<h4>HAHAHAHAH AHHAHAH AHHAHHA</h4>

		<% if(doesTheWorkoutSessionHaveSteps){ %>
			<ul>
				<% workoutStepLogArr.forEach(step => { %>
					<li class="workout-step-item">
						<div>
							<span class="step-order">
								<%= step.session_step_order <= 9 ? `0${step.session_step_order}` : step.session_step_order %>
							</span>
							<p class="step-name">
							<%= step.session_name.toUpperCase() %>
							</p>
							<div class="step-status">
								<% if(step.status === "planned") { %> 
									
								<% } %>
							</div>
						</div>
					</li>
				<% }) %>
			</ul>
		<% } %>
	
	<% } else { %>
		
			<div class="session-header">
			<h3>
				<%= 
					activeSession?.name
				%>
			</h3>
			<% if(doesTheSessionHaveSteps) { %>
				<div class="complete-indicator-container">
					<span>
						0% COMPLETE
					</span>
				</div>
			<% } %>
		</div>

			<% if(doesTheSessionHaveSteps){ %>
				<div class="session-step-list-container">
					<ul>
						<% sessionStepArr.forEach(step => { %>
							<li>
								<div class="session-step-list-item">
									<span>
										<%= step.step_order <= 9 ? `0${step.step_order}` : step.step_order %>
									</span>
									<span>
										<%= step.name.toUpperCase() %>
									</span>
								</div>
							</li>
						<% }) %>
					</ul>
				</div>
			<% } else { %>
				<div class="no-session-step-container">
					<p>
						( EMPTY )
					</p>
				</div>
			<% }%>

			<% if(doesTheSessionHaveSteps){ %>
				<div class="button-container">
					<form method="POST" action="/workout_sessions">
						<input type="hidden" name="sessionId" value="<%= currSessionId %>" />
						<button type="submit">
							<svg width="40" height="40" viewBox="6 6 52 52" class="icon">
								<use href="../play-black-icon.svg"></use>
							</svg>
						</button>
					</form>
				</div>
			<% } %>

	<% } %>
</div>
