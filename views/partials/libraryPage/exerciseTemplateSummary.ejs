<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? ""); %>
<% const {baseName="", summary={}, details={}} = locals?.template %>

<% if (details.media) { %>
	<%- include("../shared/components/media", { media: details.media, className: "session-summary__media exercise-template__summary-media", variant: "icon", density: "compact", decorative: true, loading: "lazy", decoding: "async" }) %>
<% } %>
<span class="session-summary__body exercise-template__summary-body">
	<span class="exercise-template__identity">
		<span class="exercise-template__eyebrow"><%= translate("library.baseExercise", { defaultValue: "Base exercise" }) %></span>
		<strong class="exercise-template__name"><%= baseName %></strong>
		<span class="exercise-template__variant-count" data-exercise-variant-count><%= summary.variantCountLabel %></span>
	</span>

	<span class="session-summary__metadata exercise-template__metadata">
		<span><%= summary.movementPatternLabel %></span>
		<span aria-hidden="true">•</span>
		<span><%= summary.equipmentSummary %></span>
	</span>
</span>
