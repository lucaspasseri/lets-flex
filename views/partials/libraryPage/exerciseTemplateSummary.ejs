<% const {name="", baseName="", isPrivateOwner=false, summary={}} = locals?.template %>

<span class="exercise-template__summary">
	<span class="exercise-template__identity">
		<span class="exercise-template__eyebrow">Base exercise</span>
		<strong class="exercise-template__name"><%= baseName %></strong>
	</span>

	<span class="exercise-template__variant-name">
		<span><%= name %></span>
		<% if (isPrivateOwner) { %><span class="exercise-template__scope">Private</span><% } %>
	</span>

	<span class="exercise-template__metadata">
		<span><%= summary.movementPatternLabel %></span>
		<span aria-hidden="true">•</span>
		<span><%= summary.equipmentSummary %></span>
	</span>
</span>
