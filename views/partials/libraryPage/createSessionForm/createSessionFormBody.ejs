<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? ""); %>
<%
	const {
		stepTypeOptions,
		exerciseOptions,
		loadUnitOptions,
		idPrefix,
		values,
		errors,
		formErrors,
		contextDayId,
		creationContext
	} = locals.sessionForm.fields;
%>

<% if (contextDayId) { %>
	<input type="hidden" name="contextDayId" value="<%= contextDayId %>">
<% } %>

<% if (creationContext) { %>
	<div class="session-form-context" aria-label="<%= translate("library.returnDestination", { defaultValue: "Return destination" }) %>">
		<span><%= translate("library.returnDestination", { defaultValue: "Return destination" }) %></span>
		<strong><%= creationContext.pathLabel %></strong>
		<p><%= creationContext.dateLabel %></p>
	</div>
<% } %>

<% if (formErrors.length) { %>
	<div class="form-errors" role="alert">
		<% formErrors.forEach(error => { %><p><%= error %></p><% }) %>
	</div>
<% } %>

<div class="form-grid form-grid--two-columns">
<%- include("../../shared/components/form/field", {
	field: {
		id: `${idPrefix}-name-input`,
		name: "name",
		label: translate("library.sessionName", { defaultValue: "Session name" }),
		control: "input",
		type: "text",
		required: true,
		value: values.name,
		error: errors.name,
		hint: translate("library.sessionNameHint", { defaultValue: "Enter a name for the session template." }),
		t: translate,
		attributes: {
			autocomplete: "off",
			maxlength: 100
		}
	}
}) %>

<%- include("../../shared/components/form/field", {
	field: {
		id: `${idPrefix}-notes-input`,
		name: "notes",
		label: translate("library.notes", { defaultValue: "Notes" }),
		control: "textarea",
		value: values.notes,
		error: errors.notes,
		hint: translate("library.sessionNotesHint", { defaultValue: "Add any general instructions for this session." }),
		t: translate,
		attributes: {
			rows: 3,
			maxlength: 500
		}
	}
}) %>
</div>

<section class="form-section" aria-labelledby="<%= idPrefix %>-step-heading">
	<div class="form-section__header">
		<div>
			<h4 id="<%= idPrefix %>-step-heading"><%= translate("library.addStep", { defaultValue: "Add a step" }) %></h4>
			<p><%= translate("library.addStepDescription", { defaultValue: "Configure an exercise prescription, then add it to the session." }) %></p>
		</div>
	</div>

	<div class="form-grid form-grid--two-columns">
	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-type-select`,
			name: "draftStepTypeId",
			label: translate("library.stepType", { defaultValue: "Step type" }),
			control: "select",
			required: false,
			hint: translate("library.stepTypeHint", { defaultValue: "Choose the kind of step." }),
			t: translate,
			options: stepTypeOptions
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-exercise-variant-select`,
			name: "draftExerciseVariantId",
			label: translate("library.exercise", { defaultValue: "Exercise" }),
			control: "select",
			required: false,
			hint: translate("library.exerciseHint", { defaultValue: "Choose the exercise for this step." }),
			t: translate,
			options: exerciseOptions
		}
	}) %>
	</div>

	<div class="form-grid form-grid--four-columns">
	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-sets-input`,
			name: "draftSets",
			label: translate("workout.setsLabel", { defaultValue: "Sets" }),
			control: "input",
			type: "number",
			hint: translate("library.plannedSetsHint", { defaultValue: "Number of planned sets." }),
			t: translate,
			attributes: {
				min: 1,
				step: 1
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-reps-input`,
			name: "draftReps",
			label: translate("workout.repetitions", { defaultValue: "Repetitions" }),
			control: "input",
			type: "number",
			hint: translate("library.plannedRepsHint", { defaultValue: "Number of planned repetitions per set." }),
			t: translate,
			attributes: {
				min: 1,
				step: 1
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-load-input`,
			name: "draftLoadValue",
			label: translate("workout.load", { defaultValue: "Load" }),
			control: "input",
			type: "number",
			hint: translate("library.plannedLoadHint", { defaultValue: "Planned load for the exercise." }),
			t: translate,
			attributes: {
				min: 0,
				step: "any"
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-load-unit-select`,
			name: "draftLoadUnit",
			label: translate("workout.loadUnit", { defaultValue: "Load unit" }),
			control: "select",
			hint: translate("library.loadUnitHint", { defaultValue: "Choose the unit used for the load." }),
			t: translate,
			options: loadUnitOptions
		}
	}) %>
	</div>

	<p
		id="<%= idPrefix %>-step-draft-error"
		class="form-field__error"
		data-session-step-draft-error
		hidden
	></p>

	<div class="form-section__actions">
	<%- include("../../shared/components/button/button", {
		button: {
			id: `${idPrefix}-add-session-step`,
			label: locals.sessionForm.actions.addStep.label,
			variant: "secondary",
			type: "button",
			attributes: { "data-add-session-step": true }
		}
	}) %>
	</div>
</section>

<section class="form-section" aria-labelledby="<%= idPrefix %>-step-list-heading">
	<div class="form-section__header">
		<div>
			<h4 id="<%= idPrefix %>-step-list-heading"><%= translate("workout.sessionSteps", { defaultValue: "Session steps" }) %></h4>
			<p><%= translate("library.sessionStepsDescription", { defaultValue: "Steps will be performed in the order shown here." }) %></p>
		</div>
	</div>

	<div class="form-collection" aria-live="polite">
		<p id="<%= idPrefix %>-step-list-message" class="form-collection__empty" data-session-step-list-message <% if (errors.stepRow) { %>data-step-error role="alert"<% } %>>
			<%= errors.stepRow || translate("workout.noSteps", { defaultValue: "No steps added yet." }) %>
		</p>
		<ol id="<%= idPrefix %>-step-list" class="form-collection__list" data-session-step-list>
			<% values.stepRow.forEach((step, index) => {
				const stepType = stepTypeOptions.find(option => String(option.value) === String(step.stepTypeId));
				const exercise = exerciseOptions.find(option => String(option.value) === String(step.exerciseVariantId));
			%>
				<li class="form-collection__item session-step-draft">
				<p><%= stepType?.label ?? translate("library.unknownStepType", { defaultValue: "Unknown step type" }) %> — <%= exercise?.label ?? translate("library.unknownExercise", { defaultValue: "Unknown exercise" }) %></p>
					<% if (step.stepId) { %><input type="hidden" data-step-field="stepId" name="stepRow[<%= index %>][stepId]" value="<%= step.stepId %>"><% } %>
					<input type="hidden" data-step-field="stepTypeId" name="stepRow[<%= index %>][stepTypeId]" value="<%= step.stepTypeId %>">
					<input type="hidden" data-step-field="exerciseVariantId" name="stepRow[<%= index %>][exerciseVariantId]" value="<%= step.exerciseVariantId %>">
					<input type="hidden" data-step-field="sets" name="stepRow[<%= index %>][sets]" value="<%= step.sets %>">
					<input type="hidden" data-step-field="reps" name="stepRow[<%= index %>][reps]" value="<%= step.reps %>">
					<input type="hidden" data-step-field="loadValue" name="stepRow[<%= index %>][loadValue]" value="<%= step.loadValue %>">
					<input type="hidden" data-step-field="loadUnit" name="stepRow[<%= index %>][loadUnit]" value="<%= step.loadUnit %>">
					<div class="form-collection__actions">
						<button type="button" class="form-collection__move" data-move-step-up><%= translate("workout.moveUp", { defaultValue: "Move up" }) %></button>
						<button type="button" class="form-collection__move" data-move-step-down><%= translate("workout.moveDown", { defaultValue: "Move down" }) %></button>
						<button type="button" class="form-collection__remove" data-remove-session-step><%= translate("workout.remove", { defaultValue: "Remove" }) %></button>
					</div>
				</li>
			<% }) %>
		</ol>
	</div>
</section>
