<%
	const {
		stepTypeOptions,
		exerciseOptions,
		loadUnitOptions
	} = locals.createSessionForm.fields;
%>

<%- include("../../shared/components/form/field", {
	field: {
		id: "session-name-input",
		name: "name",
		label: "Session name",
		control: "input",
		type: "text",
		required: true,
		hint: "Enter a name for the session template.",
		attributes: {
			autocomplete: "off",
			maxlength: 100
		}
	}
}) %>

<%- include("../../shared/components/form/field", {
	field: {
		id: "session-notes-input",
		name: "notes",
		label: "Notes",
		control: "textarea",
		hint: "Add any general instructions for this session.",
		attributes: {
			rows: 3,
			maxlength: 500
		}
	}
}) %>

<section class="session-step-fields-container">
	<h4>Add a step</h4>
	<p>Configure a step and add it to the session.</p>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "session-step-type-select",
			name: "draftStepTypeId",
			label: "Step type",
			control: "select",
			required: false,
			hint: "Choose the kind of step.",
			options: stepTypeOptions
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "session-exercise-variant-select",
			name: "draftExerciseVariantId",
			label: "Exercise",
			control: "select",
			required: false,
			hint: "Choose the exercise for this step.",
			options: exerciseOptions
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "session-step-sets-input",
			name: "draftSets",
			label: "Sets",
			control: "input",
			type: "number",
			hint: "Number of planned sets.",
			attributes: {
				min: 1,
				step: 1
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "session-step-reps-input",
			name: "draftReps",
			label: "Repetitions",
			control: "input",
			type: "number",
			hint: "Number of planned repetitions per set.",
			attributes: {
				min: 1,
				step: 1
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "session-step-load-input",
			name: "draftLoadValue",
			label: "Load",
			control: "input",
			type: "number",
			hint: "Planned load for the exercise.",
			attributes: {
				min: 0,
				step: "any"
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "session-step-load-unit-select",
			name: "draftLoadUnit",
			label: "Load unit",
			control: "select",
			hint: "Choose the unit used for the load.",
			options: loadUnitOptions
		}
	}) %>

	<p
		id="session-step-draft-error"
		class="form-field__error"
		hidden
	></p>

	<%- include("../../shared/components/button/button", {
		button: {
			id: "add-session-step",
			label: locals.createSessionForm.actions.addStep.label,
			variant: "secondary",
			type: "button"
		}
	}) %>
</section>

<section class="current-steps-container">
	<h4>Session steps</h4>

	<p id="session-step-list-message">
		No steps have been added yet.
	</p>

	<ol id="session-step-list"></ol>
</section>
