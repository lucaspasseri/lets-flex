<%
	const {
		stepTypeOptions,
		exerciseOptions,
		loadUnitOptions,
		idPrefix,
		values,
		errors,
		formErrors
	} = locals.sessionForm.fields;
%>

<% if (formErrors.length) { %>
	<div class="form-errors" role="alert">
		<% formErrors.forEach(error => { %><p><%= error %></p><% }) %>
	</div>
<% } %>

<div class="form-grid form-grid--two-columns">
<%- include("../../shared/components/form/field", {
	field: {
		id: `${idPrefix}-name-input`,
		name: "name",
		label: "Session name",
		control: "input",
		type: "text",
		required: true,
		value: values.name,
		error: errors.name,
		hint: "Enter a name for the session template.",
		attributes: {
			autocomplete: "off",
			maxlength: 100
		}
	}
}) %>

<%- include("../../shared/components/form/field", {
	field: {
		id: `${idPrefix}-notes-input`,
		name: "notes",
		label: "Notes",
		control: "textarea",
		value: values.notes,
		error: errors.notes,
		hint: "Add any general instructions for this session.",
		attributes: {
			rows: 3,
			maxlength: 500
		}
	}
}) %>
</div>

<section class="form-section" aria-labelledby="<%= idPrefix %>-step-heading">
	<div class="form-section__header">
		<div>
			<h4 id="<%= idPrefix %>-step-heading">Add a step</h4>
			<p>Configure an exercise prescription, then add it to the session.</p>
		</div>
	</div>

	<div class="form-grid form-grid--two-columns">
	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-type-select`,
			name: "draftStepTypeId",
			label: "Step type",
			control: "select",
			required: false,
			hint: "Choose the kind of step.",
			options: stepTypeOptions
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-exercise-variant-select`,
			name: "draftExerciseVariantId",
			label: "Exercise",
			control: "select",
			required: false,
			hint: "Choose the exercise for this step.",
			options: exerciseOptions
		}
	}) %>
	</div>

	<div class="form-grid form-grid--four-columns">
	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-sets-input`,
			name: "draftSets",
			label: "Sets",
			control: "input",
			type: "number",
			hint: "Number of planned sets.",
			attributes: {
				min: 1,
				step: 1
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-reps-input`,
			name: "draftReps",
			label: "Repetitions",
			control: "input",
			type: "number",
			hint: "Number of planned repetitions per set.",
			attributes: {
				min: 1,
				step: 1
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-load-input`,
			name: "draftLoadValue",
			label: "Load",
			control: "input",
			type: "number",
			hint: "Planned load for the exercise.",
			attributes: {
				min: 0,
				step: "any"
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: `${idPrefix}-step-load-unit-select`,
			name: "draftLoadUnit",
			label: "Load unit",
			control: "select",
			hint: "Choose the unit used for the load.",
			options: loadUnitOptions
		}
	}) %>
	</div>

	<p
		id="<%= idPrefix %>-step-draft-error"
		class="form-field__error"
		data-session-step-draft-error
		hidden
	></p>

	<div class="form-section__actions">
	<%- include("../../shared/components/button/button", {
		button: {
			id: `${idPrefix}-add-session-step`,
			label: locals.sessionForm.actions.addStep.label,
			variant: "secondary",
			type: "button",
			attributes: { "data-add-session-step": true }
		}
	}) %>
	</div>
</section>

<section class="form-section" aria-labelledby="<%= idPrefix %>-step-list-heading">
	<div class="form-section__header">
		<div>
			<h4 id="<%= idPrefix %>-step-list-heading">Session steps</h4>
			<p>Steps will be performed in the order shown here.</p>
		</div>
	</div>

	<div class="form-collection" aria-live="polite">
		<p id="<%= idPrefix %>-step-list-message" class="form-collection__empty" data-session-step-list-message <% if (errors.stepRow) { %>data-step-error role="alert"<% } %>>
			<%= errors.stepRow || "No steps added yet." %>
		</p>
		<ol id="<%= idPrefix %>-step-list" class="form-collection__list" data-session-step-list>
			<% values.stepRow.forEach((step, index) => {
				const stepType = stepTypeOptions.find(option => String(option.value) === String(step.stepTypeId));
				const exercise = exerciseOptions.find(option => String(option.value) === String(step.exerciseVariantId));
			%>
				<li class="form-collection__item session-step-draft">
					<p><%= stepType?.label ?? "Unknown step type" %> — <%= exercise?.label ?? "Unknown exercise" %></p>
					<% if (step.stepId) { %><input type="hidden" data-step-field="stepId" name="stepRow[<%= index %>][stepId]" value="<%= step.stepId %>"><% } %>
					<input type="hidden" data-step-field="stepTypeId" name="stepRow[<%= index %>][stepTypeId]" value="<%= step.stepTypeId %>">
					<input type="hidden" data-step-field="exerciseVariantId" name="stepRow[<%= index %>][exerciseVariantId]" value="<%= step.exerciseVariantId %>">
					<input type="hidden" data-step-field="sets" name="stepRow[<%= index %>][sets]" value="<%= step.sets %>">
					<input type="hidden" data-step-field="reps" name="stepRow[<%= index %>][reps]" value="<%= step.reps %>">
					<input type="hidden" data-step-field="loadValue" name="stepRow[<%= index %>][loadValue]" value="<%= step.loadValue %>">
					<input type="hidden" data-step-field="loadUnit" name="stepRow[<%= index %>][loadUnit]" value="<%= step.loadUnit %>">
					<div class="form-collection__actions">
						<button type="button" class="form-collection__move" data-move-step-up>Move up</button>
						<button type="button" class="form-collection__move" data-move-step-down>Move down</button>
						<button type="button" class="form-collection__remove" data-remove-session-step>Remove</button>
					</div>
				</li>
			<% }) %>
		</ol>
	</div>
</section>
