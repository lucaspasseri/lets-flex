<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? ""); %>
<%
	const {id=null, baseName="", summary={}, details={}, actions={}} = locals?.template ?? {};
	const variants = details?.variants ?? [];
%>

<div class="exercise-template__content">
	<% if (details?.media) { %>
		<%- include("../shared/components/media", { media: details.media, className: "exercise-template__media", variant: "initial", decorative: true }) %>
	<% } %>

	<dl class="exercise-template__facts">
		<div>
			<dt class="exercise-template__field-label"><%= translate("library.movementPattern", { defaultValue: "Movement pattern" }) %></dt>
			<dd><%= details?.movementPattern?.name %></dd>
		</div>

		<div>
			<dt class="exercise-template__field-label"><%= translate("library.primaryMuscles", { defaultValue: "Primary muscles" }) %></dt>
			<dd class="exercise-template__tags">
				<% if (details?.muscleTemplates?.primary?.name) { %>
					<span class="tag"><%= details.muscleTemplates.primary.name %></span>
				<% } else { %>
					<span class="exercise-template__empty-value"><%= translate("library.notSpecified", { defaultValue: "Not specified" }) %></span>
				<% } %>
			</dd>
		</div>
	</dl>

	<section class="exercise-template__variant-section" aria-labelledby="exercise-template-<%= id %>-variants">
		<header class="exercise-template__variants-header">
			<div>
				<p class="exercise-template__eyebrow"><%= translate("library.availableSetups", { defaultValue: "Available setups" }) %></p>
				<h3 id="exercise-template-<%= id %>-variants"><%= translate("library.variantsHeading", { name: baseName, defaultValue: "{{name}} variants" }) %></h3>
			</div>
			<span data-exercise-variant-result-count><%= summary?.variantCountLabel ?? "" %></span>
		</header>

		<ul class="exercise-variants" data-exercise-variant-results>
			<% variants.forEach(variant => { %>
				<li class="exercise-variant" data-exercise-variant-item data-exercise-variant-id="<%= variant.id %>" data-search-key-word="<%= variant.searchKeyWord %>" data-filter-values="<%= JSON.stringify(variant.filters) %>">
					<%- include("../shared/components/media", { media: variant.media, className: "exercise-variant__media", variant: "initial", decorative: true }) %>
					<header class="exercise-variant__header">
						<strong><%= variant.name %></strong>
						<% if (variant.isPrivateOwner) { %><span class="exercise-template__scope"><%= translate("library.private", { defaultValue: "Private" }) %></span><% } %>
					</header>

					<dl class="exercise-variant__facts">
						<div>
							<dt><%= translate("library.equipment", { defaultValue: "Equipment" }) %></dt>
							<dd><%= variant.equipment?.name ?? translate("library.bodyweight", { defaultValue: "Bodyweight" }) %></dd>
						</div>

						<div>
							<dt><%= translate("library.environment", { defaultValue: "Environment" }) %></dt>
							<dd><%= variant.environmentLabel %></dd>
						</div>

						<div>
							<dt><%= translate("library.setup", { defaultValue: "Setup" }) %></dt>
							<dd><%= variant.setupDescription || translate("library.noSetupInstructions", { defaultValue: "No setup instructions" }) %></dd>
						</div>

						<div>
							<dt><%= translate("library.notes", { defaultValue: "Notes" }) %></dt>
							<dd><%= variant.notes || translate("library.noAdditionalNotes", { defaultValue: "No additional notes" }) %></dd>
						</div>
					</dl>

					<% if (variant.actions?.canManageGlobal || variant.actions?.canManagePrivate) { %>
						<div class="exercise-variant__actions">
							<% if (variant.actions.canManageGlobal) { %>
								<%- include("../shared/components/button/button", {button: {
									label: variant.actions.update.label,
									variant: "secondary",
									type: "button",
									attributes: {
										"data-modal-open": variant.actions.update.modalId,
										"data-update-exercise-template": JSON.stringify(variant.actions.update.values ?? {})
									}
								}}) %>
							<% } %>

							<% if (variant.actions.canManagePrivate) { %>
								<div class="exercise-template__private-actions">
									<form class="form exercise-template__inline-form" method="POST" action="/exercise-variants/<%= variant.id %>?_method=PATCH">
										<input type="hidden" name="_csrf" value="<%= locals?.csrfToken ?? '' %>">
										<input type="hidden" name="equipmentId" value="<%= variant.privateMutation?.equipmentId ?? variant.equipment?.id ?? '' %>">
										<%- include("../shared/components/form/field", { field: {
											id: `private-variant-${variant.id}-name`,
											name: "name",
											label: "Variant name",
											control: "input",
											type: "text",
											required: true,
											value: variant.privateMutation?.name ?? variant.name,
											error: variant.privateMutation?.error ?? null,
											hint: "Only you can update this private variant.",
											attributes: { maxlength: 100, autocomplete: "off" }
										} }) %>
										<%- include("../shared/components/button/button", { button: {
											label: "Save variant",
											type: "submit",
											variant: "primary"
										} }) %>
									</form>
									<form class="exercise-template__archive-form" method="POST" action="/exercise-variants/<%= variant.id %>/archive">
										<input type="hidden" name="_csrf" value="<%= locals?.csrfToken ?? '' %>">
										<%- include("../shared/components/button/button", { button: {
											label: "Archive private variant",
											type: "submit",
											variant: "dangerGhost"
										} }) %>
									</form>
								</div>
							<% } %>
						</div>
					<% } %>
				</li>
			<% }) %>
		</ul>
	</section>

	<% if (actions?.archive) { %>
		<div class="exercise-template__actions">
			<%- include("../shared/components/button/button", {button: {
				label: actions.archive.label,
				variant: "danger",
				type: "button",
				attributes: {
					"data-modal-open": actions.archive.modalId,
					"data-exercise-id": actions.archive.value
				}
			}}) %>
		</div>
	<% } %>
</div>
