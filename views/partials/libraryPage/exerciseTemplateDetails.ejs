<%
	const {id= null, details={}, actions={}, summary={}} = locals?.template ?? {};
%>

<div
	class="exercise-template__panel"
	id="exercise-template-<%= id %>-panel"
	role="region"
	aria-labelledby="exercise-template-<%= id %>-trigger"
>
	<div class="exercise-template__content">
		<div class="exercise-template__facts">
			<div>
				<span class="exercise-template__field-label">
					Movement pattern
				</span>
				<strong>
					<%= details?.movementPattern?.name %>
				</strong>
			</div>

			<div>
				<span class="exercise-template__field-label">
					Primary muscles
				</span>

				<div class="exercise-template__tags">


					<% if (details?.muscleTemplates?.primary?.name) { %>
						<span class="tag"><%= details.muscleTemplates.primary.name %></span>
					<% } else { %>
						<span class="exercise-template__empty-value">Not specified</span>
					<% } %>
				</div>
			</div>
		</div>

		<section
			class="exercise-template__variant-section"
			aria-labelledby="exercise-template-<%= id %>-variants"
		>
			<header class="exercise-template__variants-header">
				<h3 id="exercise-template-<%= id %>-variants">
					Variant
				</h3>
			</header>

			
			
			<div class="exercise-variant">
				<strong><%= details?.variant?.name %></strong>

				<dl class="exercise-variant__facts">
					<div>
						<dt>Equipment</dt>
						<dd><%= details?.variant?.equipment?.name ?? "None" %></dd>
					</div>

					<div>
						<dt>Environment</dt>
						<dd><%= details?.variant?.environmentLabel ?? "Not specified" %></dd>
					</div>

					<div>
						<dt>Setup</dt>
						<dd>
							<%= details?.variant?.setupDescription ?? "No setup instructions" %>
						</dd>
					</div>
				</dl>
			</div>

		</section>

		<div class="exercise-template__actions">
			<% if (actions?.canManageGlobal) { %>
			<%- include("../shared/components/button/button",  {button: {
					label: "Edit",
					variant: "secondary",
					type: "button",
					attributes: {
						"data-modal-open": actions?.update?.modalId,
						"data-update-exercise-template": JSON.stringify(actions?.update?.values ?? {})
					}
				}})
			%>
			<%- include("../shared/components/button/button",  {button: {
					label: "Archive",
					variant: "danger",
					attributes: {
						"data-modal-open": actions?.remove?.modalId,
						"data-exercise-id": actions?.remove?.value
					}
				}}) 
			%> 
			<% } %>
			<% if (actions?.canManagePrivate) { %>
				<div class="exercise-template__private-actions">
					<form class="form exercise-template__inline-form" method="POST" action="/exercise-variants/<%= id %>?_method=PATCH">
						<input type="hidden" name="_csrf" value="<%= locals?.csrfToken ?? '' %>">
						<input type="hidden" name="equipmentId" value="<%= details?.variant?.equipment?.id ?? '' %>">
						<%- include("../shared/components/form/field", { field: {
							id: `private-variant-${id}-name`,
							name: "name",
							label: "Variant name",
							control: "input",
							type: "text",
							required: true,
							value: details?.variant?.name,
							hint: "Only you can update this private variant.",
							attributes: { maxlength: 100, autocomplete: "off" }
						} }) %>
						<%- include("../shared/components/button/button", { button: {
							label: "Save variant",
							type: "submit",
							variant: "primary"
						} }) %>
					</form>
					<form class="exercise-template__archive-form" method="POST" action="/exercise-variants/<%= id %>/archive">
						<input type="hidden" name="_csrf" value="<%= locals?.csrfToken ?? '' %>">
						<%- include("../shared/components/button/button", { button: {
							label: "Archive private variant",
							type: "submit",
							variant: "dangerGhost"
						} }) %>
					</form>
				</div>
			<% } %>
		</div>
	</div>
</div>
