<%
	const {
		movementPatternOptions,
		equipmentOptions,
		muscleOptions,
		muscleRoleOptions
	} = locals.createExerciseForm.fields;
%>

<div class="form-grid form-grid--two-columns">
	<%- include("../../shared/components/form/field", {
		field: {
			id: "name-input",
			name: "name",
			label: "Exercise's name",
			control: "input",
			type: "text",
			required: true,
			hint: "Enter the name for the exercise template.",
			attributes: {
				autocomplete: "on",
				maxlength: 100
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "movement-pattern-select",
			name: "movementPatternId",
			label: "Movement pattern",
			control: "select",
			required: true,
			hint: "Choose a movement pattern for the exercise template.",
			options: movementPatternOptions,
			attributes: {
				autocomplete: "off"
			}
		}
	}) %>

	<%- include("../../shared/components/form/field", {
		field: {
			id: "equipment-select",
			name: "equipmentId",
			label: "Equipment",
			control: "select",
			required: true,
			hint: "Choose an equipment for the exercise template.",
			options: equipmentOptions,
			attributes: {
				autocomplete: "off"
			}
		}
	}) %>
</div>

<section class="form-section" aria-labelledby="exercise-muscles-heading">
	<div class="form-section__header">
		<div>
			<h4 id="exercise-muscles-heading">Muscle roles</h4>
			<p>Associate one or more muscles with their role in the exercise.</p>
		</div>
	</div>

	<div class="form-grid form-grid--two-columns">
		<%- include("../../shared/components/form/field", {
			field: {
				id: "muscle-select",
				name: "muscleId",
				label: "Performing muscle",
				control: "select",
				required: true,
				hint: "Choose a muscle for the exercise template.",
				options: muscleOptions,
				attributes: {
					autocomplete: "off"
				}}
			}) 
		%>

		<%- include("../../shared/components/form/field", {
			field: {
				id: "muscle-role-select",
				name: "muscleRoleId",
				label: "Performed role",
				control: "select",
				required: true,
				hint: "Choose a muscle role for the exercise template.",
				options: muscleRoleOptions,
				attributes: {
					autocomplete: "off"
				}}
			}) 
		%>

	</div>

	<div class="form-section__actions">
		<%- include("../../shared/components/button/button", {button: {
				id: "add-muscle-role-relation",
				label: locals.createExerciseForm.actions.addMuscle.label,
				variant: "primary",
			}}) 
		%>
	</div>

	<div class="form-collection" aria-live="polite">
		<p id="muscle-role-list-message" class="form-collection__empty">
			No muscles added yet.
		</p>
		<ul id="muscle-role-list" class="form-collection__list"></ul>
	</div>
</section>
