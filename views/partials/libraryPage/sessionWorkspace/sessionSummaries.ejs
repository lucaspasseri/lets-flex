<%
	const {id= null, heading="Template list", emptyState={}, items=[]} = locals.summaries;
%>

<section
	class="session-summaries"
	aria-labelledby="<%= id %>-title"
>
	<header class="session-summaries__header">
		<h3 id="<%= id %>-title">
			<%= heading %>
		</h3>

		<span class="session-summaries__count" aria-live="polite" data-library-result-count data-total-count="<%= items.length %>">
			<%= items.length %> <%= items.length === 1 ? "session" : "sessions" %>
		</span>
	</header>

	<% if (items.length === 0) { %>
		<%- include("sessionSummariesEmpty", { emptyState }) %>
	<% } else { %>
		<nav aria-label="Session templates" data-library-results>
			<ul class="session-summaries__list">
				<% items.forEach((item) => { %>
					<li
						<% if(item?.id) { %>
							<%= `id=${item.id}` %>
						<% } %>
						data-search-session-item
						data-search-key-word="<%= item.searchKeyWord %>"
						data-filter-values="<%= JSON.stringify(item.filters) %>"
					>
						<a
							class="session-summary <%= item.isCurrent
								? 'session-summary--current'
								: '' %>"
							href="<%= item.href %>"
							<% if (item.isCurrent) { %>
								aria-current="true"
							<% } %>
						>
							<% if (item.media) { %>
								<img
									class="session-summary__media"
									data-media-fallback="true"
									src="<%= item.media.src %>"
									width="<%= item.media.width %>"
									height="<%= item.media.height %>"
									alt=""
									aria-hidden="true"
									loading="lazy"
									decoding="async"
								>
							<% } %>
							<span class="session-summary__body">
								<strong class="session-summary__name">
									<%= item.name %>
								</strong>

								<% if (item.description) { %>
									<span class="session-summary__description">
										<%= item.description %>
									</span>
								<% } %>

								<span class="session-summary__metadata">
									<span><%= item.stepCountLabel %></span>
									<span aria-hidden="true">•</span>
									<span><%= item.setCountLabel %></span>
									<span aria-hidden="true">•</span>
									<span><%= item.movementPatternsLabel %></span>
								</span>
							</span>

							<%- include("../../shared/components/icons/namedIcon", { name: "chevron-right" }) %>
						</a>
					</li>
				<% }) %>
			</ul>
		</nav>
		<div class="library-filter-empty" role="status" aria-live="polite" data-library-filter-empty hidden>
			<%- include("../../shared/components/icons/namedIcon", { name: "search" }) %>
			<h4>No sessions match these filters</h4>
			<p>Try a broader search, choose fewer filters, or clear them to see every session.</p>
		</div>
	<% } %>
</section>
