<% 
	const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? "");
	const { id= null, heading="Session templates", createAction={}, summaries={}, details=null } = locals?.sessionWorkspace;
%>

<section
	class="session-workspace"
	aria-labelledby="session-workspace-title"
	<%= id ? `id=${id}` : "" %>
>
	<header class="session-workspace__header">
		<div>
			<p class="session-workspace__eyebrow"><%= translate("library.workoutLibrary", { defaultValue: "Workout library" }) %></p>
			<h2 id="session-workspace-title">
				<%= heading %>
			</h2>
		</div>

		<%- include("../../shared/components/button/button", {button: {
					id: `sessionWorkspace-${id}-addButton`,
					type: "button",
					label: createAction?.label ?? translate("library.createSessionTemplate", { defaultValue: "Create session template" }),
					variant: "secondary",
					attributes: {
						"data-modal-open": createAction.modalId
					}
				}}) 
			%>
	</header>

	<div data-library-discovery-section="sessions">
		<%- include("../librarySearch", { discovery: locals.sessionWorkspace.discovery, t: translate }) %>

		<div class="session-workspace__content">
			<%- include("./sessionSummaries", {
				summaries: summaries,
				t: locals.t
			}) %>

			<%- include("./sessionDetails", {
				session: details,
				summariesHeadingId: `${summaries.id}-title`,
				t: translate
			}) %>
		</div>
	</div>
</section>
