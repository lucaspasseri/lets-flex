<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? ""); %>
<%
	const {id = null, label="", description="", countLabel="0 exercises · 0 variants", items=[], emptyState=null, actions={}, discovery={}} = locals?.exerciseTemplates ?? {};
%>

<section
	class="exercise-templates"
	aria-labelledby="<%= id %>-heading"
	data-library-discovery-section="exercises"
>
	<header class="exercise-templates__header">
		<div>
			<p class="exercise-templates__eyebrow"><%= translate("library.exerciseLibrary", { defaultValue: "Exercise library" }) %></p>

			<h2 id="<%= id %>-heading">
				<%= label %>
			</h2>

			<% if (description) { %>
				<p class="exercise-templates__description">
					<%= description %>
				</p>
			<% } %>
		</div>

		<div class="exercise-templates__header-actions">
			<span class="exercise-templates__count" aria-live="polite" data-library-result-count data-total-count="<%= items.length %>" data-total-variant-count="<%= items.reduce((total, item) => total + item.variantCount, 0) %>">
				<%= countLabel %>
			</span>

			<% if (actions?.create?.isVisible) { %><%- include("../shared/components/button/button", {button: {
					label: actions?.create?.label ?? translate("library.createExerciseTemplate", { defaultValue: "Create exercise template" }),
					variant: "primary",
					attributes: {
						"data-modal-open" : actions?.create?.modalId ?? "createExerciseModalId"
					}
				}}) 
			%><% } %>
		</div>
	</header>

	<%- include("./librarySearch", { discovery, t: translate }) %>

	<% if (items.length > 0) { %>
		<ul class="exercise-templates__list" data-library-results>
			<% items.forEach(template => { %>
				<li
					data-search-exercise-item
					data-search-key-word="<%= template.searchKeyWord %>"
					data-base-search-key-word="<%= template.baseSearchKeyWord %>"
					data-filter-values="<%= JSON.stringify(template.filters) %>"
					data-variant-count="<%= template.variantCount %>"
				>
					<%- include("../shared/components/accordion/accordion", {
						accordion: {
							id: template.id,
							className: "exercise-template",
							headerClassName: "exercise-template__trigger",
							panelClassName: "exercise-template__panel",
							triggerId: `exercise-template-${template.id}-trigger`,
							panelId: `exercise-template-${template.id}-panel`,
							renderHeaderContent: () =>
								include("./exerciseTemplateSummary", { template }),
								renderPanel: () =>
									include("./exerciseTemplateDetails", { template, t: translate })
						}
					}) %>
				</li>
			<% }) %>
		</ul>
		<div class="library-filter-empty" role="status" aria-live="polite" data-library-filter-empty hidden>
			<%- include("../shared/components/icons/namedIcon", { name: "search" }) %>
			<h3><%= translate("library.noExercisesMatch", { defaultValue: "No exercises match these filters" }) %></h3>
			<p><%= translate("library.filterExerciseEmptyDescription", { defaultValue: "Try a broader search, choose fewer filters, or clear them to restore the catalog." }) %></p>
		</div>
	<% } else { %>
		<%- include("./exerciseTemplatesEmptyState", {
				emptyState,
			t: translate,
			createAction: actions?.create
		}) %>
	<% } %>
</section>
