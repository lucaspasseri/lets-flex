<% const label = locals.searchLabel ?? "Search sessions and exercises"; %>
<% const placeholder = locals.searchPlaceholder ?? label; %>
<div class="library-search">
	<%- include("../shared/components/icons/namedIcon", { name: "search" }) %>

	<label class="visually-hidden" for="library-search">
		<%= label %>
	</label>

	<input
		id="library-search"
		type="search"
		placeholder="<%= placeholder %>"
		autocomplete="on"
		data-library-search
	/>
</div>
