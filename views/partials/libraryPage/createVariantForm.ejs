<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? ""); %>
<% const { idPrefix, title, eyebrow, description, submitLabel, actionPrefix, exercises, equipments, values = {}, errors = {} } = locals.variantForm; %>

<section class="library-action-panel" aria-labelledby="<%= idPrefix %>-heading">
	<header class="library-action-panel__header">
		<div class="library-action-panel__icon" aria-hidden="true">
			<%- include("../shared/components/icons/namedIcon", { name: "plus-circle" }) %>
		</div>
		<div>
			<p class="library-action-panel__eyebrow"><%= eyebrow %></p>
			<h2 id="<%= idPrefix %>-heading"><%= title %></h2>
			<p><%= description %></p>
		</div>
	</header>

	<form
		class="form library-variant-form"
		method="POST"
		action="<%= actionPrefix %>/0/variants"
		data-variant-create-form
		data-action-prefix="<%= actionPrefix %>"
	>
		<input type="hidden" name="_csrf" value="<%= locals?.csrfToken ?? '' %>">
		<% if (errors.formErrors?.length) { %>
			<div class="form-errors" role="alert">
				<% errors.formErrors.forEach(error => { %><p><%= error %></p><% }) %>
			</div>
		<% } %>
		<div class="form-grid form-grid--three-columns">
			<%- include("../shared/components/form/field", { field: {
				id: `${idPrefix}-exercise`,
				name: "exerciseId",
				label: translate("library.exercise", { defaultValue: "Exercise" }),
					control: "select",
					required: true,
					value: values.exerciseId ?? "",
					error: errors.fieldErrors?.exerciseId,
				hint: translate("library.globalExerciseVariantHint", { defaultValue: "Choose the global exercise this variation belongs to." }),
				defaultOption: { label: translate("library.chooseExercise", { defaultValue: "Choose exercise" }), value: "" },
				t: translate,
				options: exercises.map(exercise => ({ value: exercise.id, label: exercise.name }))
			} }) %>
			<%- include("../shared/components/form/field", { field: {
				id: `${idPrefix}-name`,
				name: "name",
				label: translate("library.variantName", { defaultValue: "Variant name" }),
				control: "input",
					type: "text",
					required: true,
					value: values.name ?? "",
					error: errors.fieldErrors?.name,
				hint: translate("library.variantNameHint", { defaultValue: "Use a short name that describes the variation." }),
				t: translate,
				attributes: { maxlength: 100, autocomplete: "off" }
			} }) %>
			<%- include("../shared/components/form/field", { field: {
				id: `${idPrefix}-equipment`,
				name: "equipmentId",
				label: translate("library.equipment", { defaultValue: "Equipment" }),
					control: "select",
					required: false,
					value: values.equipmentId ?? "",
					error: errors.fieldErrors?.equipmentId,
				hint: translate("library.bodyweightVariantHint", { defaultValue: "Leave empty for a bodyweight variation." }),
				defaultOption: { label: translate("library.noEquipment", { defaultValue: "No equipment" }), value: "" },
				t: translate,
				options: equipments.map(equipment => ({ value: equipment.id, label: equipment.name }))
			} }) %>
		</div>
		<div class="library-variant-form__footer">
			<%- include("../shared/components/button/button", { button: {
				label: submitLabel,
				type: "submit",
				variant: "primary"
			} }) %>
		</div>
	</form>
</section>
