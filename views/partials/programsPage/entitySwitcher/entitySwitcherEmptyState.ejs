<%
	const { title, description, icon, createAction } =
		locals.entitySwitcherEmptyState;
%>
<div class="entity-switcher-empty-state">
	<div class="entity-switcher-empty-state__icon" aria-hidden="true">
		<i data-lucide="<%= icon %>"></i>
	</div>
	<h3><%= title %></h3>
	<p><%= description %></p>
	<%- include("../../shared/components/button/button", { button: {
		label: createAction.label,
		variant: "primary",
		disabled: createAction.disabled ?? false,
		renderIcon: () => include("../../icons/plus"),
		attributes: {
			"data-modal-open": createAction.modalId,
			"aria-label": createAction.accessibleLabel
		}
	} }) %>
</div>
