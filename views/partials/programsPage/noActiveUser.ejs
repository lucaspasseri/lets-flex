<% const { title, description, action } = locals.noActiveUser; %>
<section class="programs-empty-state" aria-labelledby="programs-empty-state-title">
	<div class="programs-empty-state__icon" aria-hidden="true">
		<i data-lucide="user-round-x"></i>
	</div>
	<h1 id="programs-empty-state-title"><%= title %></h1>
	<p><%= description %></p>
	<a class="programs-empty-state__action" href="<%= action.href %>">
		<%- include("../icons/plus") %>
		<span><%= action.label %></span>
	</a>
</section>
