<% const username = locals?.appState?.user?.name ?? "Guest" %>

<header class="page-header">
	<div class="logoContainer">
		<a href="/"> <%- include('logo'); %> </a>
	</div>
	<button
		type="button"
		class="avatar-container"
		data-modal-open="logoutUserModalId"
	>
		<div class="avatar"><%- include("icons/person"); %></div>
		<div class="avatar-name">
			<p><%= username %></p>
		</div>
	</button>
</header>
