<% const username = locals?.appState?.user?.name ?? "Guest" %>

<header class="page-header">
	<div class="logoContainer">
		<a href="/"> <%- include('logo'); %> </a>
	</div>
	<div>
		<div class="avatar">
			<svg width="44" height="44" viewBox="0 0 64 64" class="icon">
				<use href="/person-icon.svg"></use>
			</svg>
		</div>
		<div class="avatar-name">
			<p><%= username %></p>
		</div>
	</div>
</header>
