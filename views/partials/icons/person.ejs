<%
	const attributes = locals.svg?.attributes ?? {};
	const validAttributeName = /^[a-zA-Z_:][a-zA-Z0-9:._-]*$/;
%>

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	<% Object.entries(attributes).forEach(([name, value]) => { %>
		<% if (validAttributeName.test(name) && value === true) { %>
			<%= name %>
		<% } else if (validAttributeName.test(name) && value != null && value !== false) { %>
			<%= name %>="<%= value %>"
		<% } %>
	<% }) %>
>
	<circle cx="12" cy="8" r="5" />
	<path d="M20 21a8 8 0 0 0-16 0" />
</svg>
