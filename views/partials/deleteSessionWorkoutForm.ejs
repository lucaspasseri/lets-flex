<%
const {currWorkoutSessionId} = locals;
const action = `/workout_sessions/${currWorkoutSessionId}?_method=PATCH`;
const currDayId = locals?.appState?.day?.id ?? null;
%>

<form
  id="deleteSessionForm"
	method="POST"
  action="<%= action %>"
	class="forms"
>
  <p>Are you sure?</p>
	<input hidden type="text" name="trainingDayId" value="<%= currDayId %>" />
  <%- include('simpleButton', { data: { text: "Confirm delete", type: "submit" } }); %>
</form>

