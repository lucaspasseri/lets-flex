<% if (status.isVisible) { %>
	<section class="dashboard-onboarding" aria-labelledby="dashboard-status-title">
		<header class="dashboard-hero">
			<p class="dashboard-eyebrow">Operational status</p>
			<h1 id="dashboard-status-title">LET'S FLEX</h1>
			<p>Your training overview starts with an active profile and program.</p>
		</header>

		<section class="dashboard-status" aria-labelledby="dashboard-sync-title">
			<div class="dashboard-section-heading"><div><p class="dashboard-eyebrow">Temporal sync</p><h2 id="dashboard-sync-title"><%= status.dateLabel %></h2></div></div>
			<ul class="dashboard-status__week">
				<% status.days.forEach(day => { %>
					<li class="dashboard-status__day <%= day.isCurrent ? 'is-current' : '' %>" <%- day.isCurrent ? 'aria-current="date"' : '' %>><span><%= day.label %></span><strong><%= day.dayLabel %></strong></li>
				<% }) %>
			</ul>
		</section>

		<div class="dashboard-onboarding__cards">
			<% if (status.userEmptyState.isVisible) { %>
				<article class="dashboard-onboarding-card">
					<div class="dashboard-onboarding-card__icon"><%- include("../shared/components/icons/guestUser", { icon: { attributes: { "aria-hidden": true } } }) %></div>
					<div><p class="dashboard-eyebrow">First step</p><h2>NO ACTIVE USER</h2></div>
					<p>Create and activate your profile to personalize your training workspace.</p>
					<a class="dashboard-action-link" href="<%= status.userEmptyState.href %>"><%- include("../shared/components/icons/plusCircle", { icon: { attributes: { "aria-hidden": true } } }) %><span>Create your user profile</span></a>
				</article>
			<% } %>
			<% if (status.programEmptyState.isVisible) { %>
				<article class="dashboard-onboarding-card">
					<div class="dashboard-onboarding-card__icon"><img src="/compasso.png" width="32" height="32" alt="" /></div>
					<div><p class="dashboard-eyebrow">Build your plan</p><h2>NO ACTIVE PROGRAM</h2></div>
					<p>Build a custom program or choose a template to begin your progression.</p>
					<a class="dashboard-action-link" href="<%= status.programEmptyState.href %>"><%- include("../shared/components/icons/plusCircle", { icon: { attributes: { "aria-hidden": true } } }) %><span>Create your first program</span></a>
				</article>
			<% } %>
		</div>
	</section>
<% } %>
