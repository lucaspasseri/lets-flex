<nav class="date-section" aria-label="Training dates"><div class="training-day-list-container">
	<a href="<%= dateNavigation.previousHref %>" class="previousDayArrow" aria-label="Previous day"><span aria-hidden="true">&lt;</span></a>
	<ol><% dateNavigation.days.forEach(day => { %>
		<li class="week-day-item <%= day.isActive ? 'active' : '' %>" <%- day.isActive ? 'aria-current="date"' : '' %>>
			<div><span><%= day.weekdayLabel %></span><span><%= day.dayLabel %></span></div>
			<div class="workout-session-indication-container"><ol><% day.indicators.forEach(indicator => { %><li class="<%= indicator.isInProgress ? 'indication-in-progress' : '' %>"></li><% }) %></ol></div>
		</li>
	<% }) %></ol>
	<a href="<%= dateNavigation.nextHref %>" class="nextDayArrow" aria-label="Next day"><span aria-hidden="true">&gt;</span></a>
</div></nav>
