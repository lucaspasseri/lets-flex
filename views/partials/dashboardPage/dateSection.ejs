<nav class="dashboard-calendar" aria-label="<%= translate("dashboard.trainingDates", { defaultValue: "Training dates" }) %>">
	<div class="dashboard-section-heading">
		<div><p class="dashboard-eyebrow"><%= translate("dashboard.schedule", { defaultValue: "Schedule" }) %></p><h2><%= translate("dashboard.trainingWeek", { defaultValue: "Training week" }) %></h2></div>
		<div class="dashboard-calendar__controls">
			<a href="<%= dateNavigation.previousHref %>" class="dashboard-calendar__arrow" aria-label="<%= translate("dashboard.previousDay", { defaultValue: "Previous day" }) %>"><span aria-hidden="true">&larr;</span></a>
			<a href="<%= dateNavigation.nextHref %>" class="dashboard-calendar__arrow" aria-label="<%= translate("dashboard.nextDay", { defaultValue: "Next day" }) %>"><span aria-hidden="true">&rarr;</span></a>
		</div>
	</div>
	<ol class="dashboard-calendar__rail">
		<% dateNavigation.days.forEach(day => { %>
			<li class="dashboard-calendar__day <%= day.isActive ? 'dashboard-calendar__day--active' : '' %>" <%- day.isActive ? 'aria-current="date"' : '' %>>
				<span class="dashboard-calendar__weekday"><%= day.weekdayLabel %></span>
				<span class="dashboard-calendar__date"><%= day.dayLabel %></span>
				<%- include("../shared/components/sessionStatusMarkers/sessionStatusMarkers", { statusMarkers: day.statusMarkers }) %>
			</li>
		<% }) %>
	</ol>
</nav>
