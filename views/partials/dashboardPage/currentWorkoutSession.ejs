<section class="sessions-section <%= currentWorkout.isRestDay ? 'no-session' : '' %>">
	<% if (currentWorkout.isRestDay) { %><h2>( RESTING / NO-SESSION DAY )</h2><% } else { %>
		<div class="sessions-container">
			<% if (currentWorkout.hasMultipleSessions) { %><nav class="change-active-session-container" aria-label="Workout sessions"><ul>
				<% currentWorkout.selectors.forEach(selector => { %><li class="<%= selector.isActive ? 'active-item' : '' %>"><a href="<%= selector.href %>" <%- selector.isActive ? 'aria-current="true"' : '' %>><span class="visually-hidden">Workout session <%= selector.id %></span></a></li><% }) %>
			</ul></nav><% } %>
			<%- include('../sessionComponent/main', { workout: currentWorkout.session }) %>
		</div>
	<% } %>
</section>
