<section class="dashboard-workout <%= currentWorkout.isRestDay ? 'dashboard-workout--rest' : '' %>">
	<% if (currentWorkout.isRestDay) { %>
		<div class="dashboard-empty-state">
			<span class="dashboard-empty-state__mark" aria-hidden="true">—</span>
			<p class="dashboard-eyebrow">Recovery</p>
			<h2>Rest day</h2>
			<p>No workout sessions are scheduled for this day.</p>
		</div>
	<% } else { %>
		<% if (currentWorkout.hasMultipleSessions) { %>
			<nav class="dashboard-session-picker" aria-label="Workout sessions"><p>Choose session</p><ul>
				<% currentWorkout.selectors.forEach((selector, index) => { %>
					<li><a class="dashboard-session-picker__item <%= selector.isActive ? 'is-active' : '' %>" href="<%= selector.href %>" <%- selector.isActive ? 'aria-current="true"' : '' %>><span class="visually-hidden">Workout session </span><%= index + 1 %></a></li>
				<% }) %>
			</ul></nav>
		<% } %>
		<%- include('../sessionComponent/main', { workout: currentWorkout.session }) %>
	<% } %>
</section>
