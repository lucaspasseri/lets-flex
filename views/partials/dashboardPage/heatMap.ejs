<% if (heatmap.isVisible) { %>
	<section class="heat-map-section"><h2><%= heatmap.title %></h2><div class="grid-container">
		<div class="grid"><% heatmap.weekdays.forEach(day => { %><div class="cell"><p><%= day %></p></div><% }) %></div>
		<% heatmap.cycles.forEach(cycle => { %><p><%= cycle.name %></p><div class="grid">
			<% cycle.days.forEach(day => { %><% day.emptyCells.forEach(() => { %><div></div><% }) %><div class="cell <%= day.cellClass %>"><p><%= day.dateLabel %></p></div><% }) %>
		</div><% }) %>
	</div></section>
<% } %>
