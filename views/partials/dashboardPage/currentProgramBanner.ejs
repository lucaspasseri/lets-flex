<header class="dashboard-program <%= programBanner.isOutsideProgram ? 'dashboard-program--outside' : '' %>">
	<div class="dashboard-program__primary">
		<p class="dashboard-eyebrow">Current program</p>
		<h1><%= programBanner.isOutsideProgram ? "Outside the scope of the program" : programBanner.programName %></h1>
	</div>
	<% if (programBanner.cycleName) { %>
		<div class="dashboard-program__cycle">
			<p class="dashboard-eyebrow">Current cycle</p>
			<p class="dashboard-program__cycle-name"><%= programBanner.cycleName %></p>
		</div>
	<% } %>
</header>
