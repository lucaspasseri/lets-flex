<%
	const currProgram = locals.appState?.currentProgram ?? {};
	const currTrainingDay = locals.appState?.currentTrainingDay ?? null;
	const cycleArr = locals.data?.cycleArr ?? [];

	const filteredCycleArr = cycleArr.filter(cycle => cycle.id === currTrainingDay?.cycle_id);
	const currCycle = filteredCycleArr.length > 0 ? filteredCycleArr[0] : null;
%>

<% if( currTrainingDay !== null){ %>
	<div class="program-banner-container">
		<p>CURRENT PROGRAM</p>
		<h1><%= currProgram.name %></h1>
	</div>
<% } else { %>
	<div class="outside-scope-banner-container">
		<p>CURRENT PROGRAM</p>
		<h1>Outside the scope of the program</h1>
	</div>
<% } %>

<% if( currCycle !== null){ %>
	<div class="cycle-banner-container">
		<p>CURRENT CYCLE</p>
		<h1><%= currCycle?.name %></h1>
	</div>
<% } %>
