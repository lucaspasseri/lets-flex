<% if (programBanner.isOutsideProgram) { %>
	<div class="outside-scope-banner-container"><p>CURRENT PROGRAM</p><h1>Outside the scope of the program</h1></div>
<% } else { %>
	<div class="program-banner-container"><p>CURRENT PROGRAM</p><h1><%= programBanner.programName %></h1></div>
<% } %>
<% if (programBanner.cycleName) { %>
	<div class="cycle-banner-container"><p>CURRENT CYCLE</p><h1><%= programBanner.cycleName %></h1></div>
<% } %>
