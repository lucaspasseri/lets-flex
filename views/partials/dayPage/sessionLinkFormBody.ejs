<% const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? ""); %>
<input type="hidden" name="trainingDayId" value="<%= sessionLinkForm.fields.trainingDayId ?? "" %>">
<% if (sessionLinkForm.formErrors.length) { %>
	<div class="form-errors" role="alert">
		<% sessionLinkForm.formErrors.forEach(error => { %><p><%= error %></p><% }) %>
	</div>
<% } %>
<%- include("../shared/components/form/field", { field: {
	...sessionLinkForm.fields.session,
	control: "select",
	disabled: !sessionLinkForm.isEnabled,
		t: translate,
		hint: sessionLinkForm.isEnabled
		? translate("library.sessionTemplateHint", { defaultValue: "Only active global templates and templates owned by you are shown." })
		: sessionLinkForm.createAction.isContextual
			? translate("library.noActiveTemplatesHint", { defaultValue: "No active templates are available. Create one below, then return here to assign it." })
			: translate("library.chooseTrainingDayHint", { defaultValue: "Choose a training day before assigning a template." }),
} }) %>
