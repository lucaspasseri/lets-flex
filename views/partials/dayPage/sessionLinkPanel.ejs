<aside class="day-panel day-panel--link" aria-labelledby="session-link-title">
	<div class="day-panel__header">
		<p class="day-panel__eyebrow">Level 4 · Session</p>
		<h2 id="session-link-title">Assign a session to this day</h2>
		<p>A template is reusable. Assigning it creates the planned workout for this specific day.</p>
	</div>

	<% if (sessionLinkForm.feedback) { %>
		<div class="day-panel__feedback" role="status">
			<strong><%= sessionLinkForm.feedback.title %></strong>
			<p><%= sessionLinkForm.feedback.message %></p>
		</div>
	<% } %>

	<%- include("../shared/components/form/form", { form: {
		action: sessionLinkForm.action,
		method: sessionLinkForm.method,
		attributes: { "data-session-link-form": true },
		slots: {
			body: include("sessionLinkFormBody", { sessionLinkForm }),
			footer: include("sessionLinkFormFooter", { sessionLinkForm }),
		},
	} }) %>

	<a class="day-panel__create-link<%= sessionLinkForm.hasTemplates ? '' : ' day-panel__create-link--primary' %>" href="<%= sessionLinkForm.createAction.href %>">
		<%- include("../shared/components/icons/namedIcon", { name: "plus-circle" }) %>
		<span><%= sessionLinkForm.createAction.label %></span>
	</a>
</aside>
