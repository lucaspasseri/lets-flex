<%
  const labelArr = Array.from(data?.label ?? "");
	const context = data?.context ?? "";
	const name = data?.name ?? "";
	const id = data?.id ?? (context ? `${context}_${name}` : name);
	const autocomplete = data?.autocomplete ?? "off";
	const type = data?.type ?? "text";
	const required = data?.required ? "required" : "";
	const min = data?.min ? data.min : "";
	const max = data?.max ? data.max : "";
	const step = data?.step ? data.step : "";
	const initialValue = data?.initialValue ? data.initialValue : "";
%>

<div class="field">
	<div class="input-control">
		<input id="<%= id %>" placeholder=" " value="<%= initialValue %>" type="<%= type %>" name="<%= data?.name || '' %>" autocomplete="<%=autocomplete %>" <%= required %>
			min="<%= min %>" max="<%= max %>" step="<%= step %>"
		/>
		<label for="<%= id %>">
			<% labelArr.forEach((letter, index) => { %>
				<span style="--delay: <%= index * 50 %>ms;"><%= letter %></span>
			<% }) %>
		</label>
	</div>
</div>