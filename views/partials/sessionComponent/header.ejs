<header class="session-header">
	<% if (header.media) { %>
		<%- include("../shared/components/media", { media: header.media, className: "session-header__media", variant: "preview", decorative: true, loading: "eager", decoding: "async" }) %>
	<% } %>
	<div class="session-header-text"><p><%= header.eyebrow %></p><h2 id="current-workout-title"><%= header.title %></h2></div>
	<span class="session-status session-status--<%= header.statusModifier %>"><%= header.statusLabel %></span>
</header>
