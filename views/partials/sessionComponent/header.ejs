<%
const sessionVm = locals.sessionVm ?? null;
const performedPercentage = locals.performedPercentage ?? 0;

const isWorkout = sessionVm?.type === "workout";
const isTemplate = sessionVm?.type === "template";

const status = sessionVm?.status ?? null;

const eyebrow = isWorkout
	? "CURRENT WORKOUT SESSION"
	: isTemplate
		? "SESSION TEMPLATE"
		: "SESSION";

const getStatusLabel = () => {
	if (isTemplate) {
		return `${sessionVm?.steps?.length ?? 0} STEPS`;
	}

	if (status === "in_progress") {
		return `${Math.round(performedPercentage)}% COMPLETE`;
	}

	if (status === "finished") {
		return "SESSION FINISHED";
	}

	if (status === "planned") {
		return "SESSION NOT STARTED";
	}

	if (status === "cancelled") {
		return "SESSION CANCELLED";
	}

	return "NO STATUS";
};
%>

<div class="session-header">
	<div class="session-header-text">	
		<p><%= eyebrow %></p>

		<h3>
			<%= sessionVm?.name ?? "( NO SESSION )" %>
		</h3>
	</div>

	<div class="complete-indicator-container">
		<span>
			<%= getStatusLabel() %>
		</span>
	</div>
</div>