<div class="logs-form-container">
	<div class="sets-container">
		<form method="POST" action="<%= workoutLogForm.performAction %>" id="log-form" class="workout-log-form">
			<input type="hidden" name="daysDifference" value="<%= workoutLogForm.daysDifference ?? 0 %>">
			<input type="hidden" name="workoutSessionId" value="<%= workoutLogForm.workoutSessionId %>">
			<% if (workoutLogForm.errors?.fieldErrors?.daysDifference || workoutLogForm.errors?.fieldErrors?.workoutSessionId) { %><p class="form-field__error"><%= workoutLogForm.errors.fieldErrors.daysDifference ?? workoutLogForm.errors.fieldErrors.workoutSessionId %></p><% } %>
			<% if (workoutLogForm.errors?.fieldErrors?.logFormRows || workoutLogForm.errors?.formErrors?.length) { %><p class="form-field__error"><%= workoutLogForm.errors.fieldErrors.logFormRows ?? workoutLogForm.errors.formErrors[0] %></p><% } %>
			<% workoutLogForm.rows.forEach(row => { %><%- include("workoutLogsFormRow", { row }) %><% }) %>
		</form>
		<%- include('../shared/components/button/button', { button: { id: "add-form-row-button", label: "Add set", type: "button", variant: "secondary", alternativeClassname: "add-row" } }) %>
	</div>
	<div class="step-log-button-container">
		<%- include('../shared/components/button/button', { button: { label: "Complete step", type: "submit", attributes: { form: "log-form" }, renderIcon: () => include("../shared/components/icons/statusCircle", { status: "performed", icon: { attributes: { "aria-hidden": true } } }) } }) %>
		<form method="POST" action="<%= workoutLogForm.skipAction %>"><input type="hidden" name="daysDifference" value="<%= workoutLogForm.daysDifference ?? 0 %>"><input type="hidden" name="workoutSessionId" value="<%= workoutLogForm.workoutSessionId %>"><%- include('../shared/components/button/button', { button: { label: "Skip step", type: "submit", variant: "secondary", renderIcon: () => include("../shared/components/icons/statusCircle", { status: "skipped", icon: { attributes: { "aria-hidden": true } } }) } }) %></form>
	</div>
	<template id="set-row-template"><%- include("workoutLogsFormRow", { row: workoutLogForm.templateRow }) %></template>
</div>
<script>
	const form = document.querySelector("#log-form");
	const rowTemplate = document.querySelector("#set-row-template");
	const addSetButton = document.querySelector("#add-form-row-button");
	function reindexRows() { form.querySelectorAll(".form-row").forEach((row, index) => { row.querySelector(".set-title").textContent = `Set ${index + 1}`; row.querySelectorAll("[id], [name], label[for]").forEach(element => { if (element.id) element.id = element.id.replace(/\d+|template/, index); if (element.name) element.name = element.name.replace(/\d+|template/, index); if (element.htmlFor) element.htmlFor = element.htmlFor.replace(/\d+|template/, index); }); }); }
	addSetButton?.addEventListener("click", () => { form.append(rowTemplate.content.cloneNode(true)); reindexRows(); });
	form?.addEventListener("click", event => { const button = event.target.closest('[data-action="remove-set"]'); if (button) { button.closest(".form-row")?.remove(); reindexRows(); } });
</script>
