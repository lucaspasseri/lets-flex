<%
	const { range } = locals?.helpers ?? {};
	const { daysDifference = null } = locals?.pageState ?? {};
	const { workoutStep = null} = locals;
	const stepLog = workoutStep?.stepLog ?? null
%>

<div class="logs-form-container">
		<button type="button" id="add-form-row-button">Add set</button>
		<form method="POST" action="/workout_step_logs/<%= workoutStep?.id %>/perform" id="log-form">
		<input type="hidden" name="daysDifference" value="<%= daysDifference %>">

		<% stepLog?.plannedSets && range(stepLog?.plannedSets).forEach((set, index) => { %>
			<%- include("workoutLogsFormRow", {stepLog, index}) %>
		<% }) %>
	</form>

	<button type="submit" form="log-form">
			<%- include("../icons/check-circle") %>
		</button>

	<form method="POST" action="/workout_step_logs/<%= workoutStep?.id %>/skip">
		<input type="hidden" name="daysDifference" value="<%= daysDifference %>">
		<button type="submit">
			<%- include("../icons/skip-circle") %>
		</button>
	</form>

	<template id="set-row-template">
		<%- include("workoutLogsFormRow", {stepLog, index: "template"}) %>
	</template>

	<script>
		const form = document.querySelector("#log-form");
		const rowTemplate = document.querySelector("#set-row-template");
		const addSetButton = document.querySelector("#add-form-row-button");

		function reindexRows() {
			const rows = form.querySelectorAll(".form-row");

			rows.forEach((row, index) => {
				row.querySelector(".set-title").textContent = `Set ${index + 1}`;

				row.querySelectorAll("[id], [name], label[for]").forEach((element) => {
					if (element.id) {
						element.id = element.id.replace(/\d+|template/, index);
					}

					if (element.name) {
						element.name = element.name.replace(/\d+|template/, index);
					}

					if (element.htmlFor) {
						element.htmlFor = element.htmlFor.replace(/\d+|template/, index);
					}
				});
			});
		}

		function addRow() {
			const clone = rowTemplate.content.cloneNode(true);
			form.append(clone);
			reindexRows();
		}

		function removeRow(button) {
			button.closest(".form-row")?.remove();
			reindexRows();
		}

		addSetButton.addEventListener("click", addRow);

		form.addEventListener("click", (event) => {
			const removeButton = event.target.closest('[data-action="remove-set"]');

			if (removeButton) {
				removeRow(removeButton);
			}
		});
	</script>
</div>