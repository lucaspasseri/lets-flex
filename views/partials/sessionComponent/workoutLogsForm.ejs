<%
	const { range } = locals?.helpers ?? {};
	const { daysDifference = null } = locals?.pageState ?? {};
	const { workoutStep = null} = locals;
	const stepLog = workoutStep?.stepLog ?? null
%>

<div class="logs-form-container">
		<button type="button" id="add-set-button">Add set</button>
		<form method="POST" action="/workout_step_logs/<%= workoutStep?.id %>/perform" id="log-form">
		<input type="hidden" name="daysDifference" value="<%= daysDifference %>">

		<% stepLog?.plannedSets && range(stepLog?.plannedSets).forEach((set, index) => { %>
			<div class="session-set">
				<div class="set-title"><%= `Set ${index + 1}` %></div>
				<%- include("workoutLogsFormRow", {stepLog}) %>
			</div>
		<% }) %>
	</form>

	<button type="submit" form="log-form">
			<%- include("../icons/check-circle") %>
		</button>

	<form method="POST" action="/workout_step_logs/<%= workoutStep?.id %>/skip">
		<input type="hidden" name="daysDifference" value="<%= daysDifference %>">
		<button type="submit">
			<%- include("../icons/skip-circle") %>
		</button>
	</form>

	<template id="set-row-template">
		<div class="session-set">
			<div class="set-title">Set</div>
				<%- include("workoutLogsFormRow", {stepLog}) %>
			</div>
	</template>


	<script>
		const setsContainer = document.querySelector("#log-form");
		const setRowTemplate = document.querySelector("#set-row-template");
		const addSetButton = document.querySelector("#add-set-button");

		addSetButton.addEventListener("click", () => {

			const index = setsContainer.children.length;

			const clone = setRowTemplate.content.cloneNode(true);
			setsContainer.append(clone);

			Array.from(setsContainer.querySelectorAll(".set-title")).forEach((title, index) =>{
				title.textContent= `Set ${index + 1}`
			})
		});

		setsContainer.addEventListener("click", (event) => {
			const removeButton = event.target.closest(
				'[data-action="remove-set"]'
			);

			if (!removeButton) return;

			removeButton.closest(".session-set").remove();
		});
	</script>
</div>