<%
	const { range } = locals?.helpers ?? {};
	const { workoutStep = null} = locals;
	const { daysDifference = null } = locals?.pageState ?? {};

	const loadUnitSelectOption = [
		{name: "Kg", value: "Kilograms"},
		{name: "lb", value: "Libra"},
	]

	console.log({daysDifference})
%>

<div class="logs-form-container">
	<form method="POST" action="/workout_step_logs/<%= workoutStep?.id %>/perform">
		<input type="hidden" name="daysDifference" value="<%= daysDifference %>">

		<% workoutStep?.stepLog?.plannedSets && range(workoutStep?.stepLog?.plannedSets).forEach((set, index) => { %>
			<div class="session-set">
				<div class="set-title"><%= `Set ${index + 1}` %></div>
				<div class="set-reps">
					<%- include('../olaInput', { data: { label: "Reps", type: "number", name: "performedReps", initialValue: workoutStep?.stepLog?.plannedReps ,context: `log-form-${index}` } }); %>
				</div>
				<div class="set-load-value">
					<%- include('../olaInput', { data: { label: "Load value", type: "number", name: "performedLoadValue", initialValue: workoutStep?.stepLog?.plannedLoadValue ,context: `log-form-${index}` } }); %>
				</div>
				<div class="set-load-unit">
						<%- include("../select", { data: { id: `log-form-${index}-select`, label: "Load unit", name: "performedLoadUnit", required: true, 
	options: loadUnitSelectOption, getOptionLabel: (option) => option.name, getOptionValue: (option) => option.value  } }); %>
				</div>
			</div>
		<% }) %>

		<button type="submit">
			<%- include("../icons/check-circle") %>
		</button>
	</form>

	<form method="POST" action="/workout_step_logs/<%= workoutStep?.id %>/skip">
		<input type="hidden" name="daysDifference" value="<%= daysDifference %>">
		<button type="submit">
			<%- include("../icons/skip-circle") %>
		</button>
	</form>
</div>