<div class="form-row">
	<div class="set-title"><%= row.title %></div>
	<div class="set-reps"><%- include('../shared/components/form/field', { field: row.fields.reps }) %></div>
	<div class="set-load-value"><%- include('../shared/components/form/field', { field: row.fields.loadValue }) %></div>
	<div class="set-load-unit"><%- include('../shared/components/form/field', { field: row.fields.loadUnit }) %></div>
	<%- include('../shared/components/button/button', { button: { label: "Remove set", type: "button", iconOnly: true, variant: "ghost", attributes: { "data-action": "remove-set" }, renderIcon: () => include("../shared/components/icons/close", { icon: { attributes: { "aria-hidden": true } } }) } }) %>
</div>
