<%
const currWorkoutSession = locals.appState?.currentWorkoutSession ?? null;
const sessionStepArr = locals.data?.sessionStepArr ?? [];
const workoutStepLogArr = locals.data?.workoutStepLogArr ?? [];

const emptySession = sessionStepArr.length === 0;

const workoutStatus = currWorkoutSession?.status ?? null;
const workoutWasNotStarted = workoutStatus === "planned";
const workoutIsInProgress = workoutStatus === "in_progress";

const currWorkoutStepLog =
	workoutStepLogArr.find(log => log.status === "planned") ?? null;

const formatOrder = order => String(order).padStart(2, "0");

const getStepName = step => {
	const baseName = step.name ?? step.session_name ?? "";
	const variantName = step.exercise_variant_name;

	if (variantName) {
		return `${baseName.toUpperCase()} (${variantName})`;
	}

	return baseName.toUpperCase();
};

console.log({currWorkoutSession});
console.log({workoutStepLogArr});

%>

<div class="session-component">
	<%- include('./header'); %>

	<% if (emptySession) { %>
		<div class="no-session-step-container">
			<p>( EMPTY )</p>
		</div>

	<% } else if (workoutWasNotStarted) { %>
		<div class="no-workout-session-container">
			<div class="session-step-list-container">
				<ul>
					<% sessionStepArr.forEach(step => { %>
						<li>
							<div class="session-step-list-item">
								<span class="step-order">
									<%= formatOrder(step.step_order) %>
								</span>

								<p class="step-name">
									<%= getStepName(step) %>
								</p>
							</div>
						</li>
					<% }) %>
				</ul>
			</div>

			<% if (currWorkoutSession?.id) { %>
				<div class="button-container">
					<form method="POST" action="/workout_sessions/<%= currWorkoutSession.id %>/start">
						<button type="submit" aria-label="Start workout session">
							<svg width="40" height="40" viewBox="6 6 52 52" class="icon">
								<use href="/play-black-icon.svg"></use>
							</svg>
						</button>
					</form>
				</div>
			<% } %>
		</div>

	<% } else if (workoutIsInProgress) { %>
		<div class="workout-step-list-container">
			<ul>
				<% workoutStepLogArr.forEach(step => { %>
					<li class="workout-step-list-item">
						<span class="step-order">
							<%= formatOrder(step.session_step_order) %>
						</span>

						<p class="step-name">
							<%= getStepName(step) %>
						</p>

						<div class="step-status">
							<% if (step.status === "planned") { %>
								<svg width="64" height="64" viewBox="0 0 64 64" class="icon">
									<use href="/status-yellow.svg"></use>
								</svg>
							<% } else if (step.status === "performed") { %>
								<svg width="64" height="64" viewBox="0 0 64 64" class="icon">
									<use href="/status-green.svg"></use>
								</svg>
							<% } else { %>
								<svg width="64" height="64" viewBox="0 0 64 64" class="icon">
									<use href="/status-red.svg"></use>
								</svg>
							<% } %>
						</div>
					</li>
				<% }) %>
			</ul>
		</div>

		<% if (currWorkoutStepLog) { %>
			<div class="current-workout-step-container">
				<div class="session-header">
					<div class="session-header-text">
						<p>CURRENT STEP</p>
						<h3>
							<%= getStepName(currWorkoutStepLog) %>
						</h3>
					</div>

					<div class="button-status-container">
						<form method="POST" action="/workout_step_logs/<%= currWorkoutStepLog.id %>/skip">
							<button type="submit">Skip</button>
						</form>

						<form method="POST" action="/workout_step_logs/<%= currWorkoutStepLog.id %>/perform">
							<button type="submit">Complete</button>
						</form>
					</div>
				</div>
			</div>

		<% } else if (currWorkoutSession?.id) { %>
			<form method="POST" action="/workout_sessions/<%= currWorkoutSession.id %>/finish">
				<button type="submit">
					FINISH SESSION
				</button>
			</form>
		<% } %>

	<% } else { %>
		<div class="no-workout-session-container">
			<div class="session-step-list-container">
				<ul>
					<% sessionStepArr.forEach(step => { %>
						<li>
							<div class="session-step-list-item">
								<span class="step-order">
									<%= formatOrder(step.step_order) %>
								</span>

								<p class="step-name">
									<%= getStepName(step) %>
								</p>
							</div>
						</li>
					<% }) %>
				</ul>
			</div>
		</div>
	<% } %>
</div>