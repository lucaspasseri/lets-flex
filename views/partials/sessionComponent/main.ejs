<article class="session-component">
	<%- include('./header', { header: workout.header }) %>
	<% if (workout.isEmpty) { %>
		<div class="no-session-step-container"><p>( EMPTY )</p></div>
	<% } else if (workout.showWorkoutLogs) { %>
		<div class="workout-step-list-container"><ul><% workout.steps.forEach(step => { %>
			<li class="workout-step-list-item"><span class="step-order"><%= step.orderLabel %></span><p class="step-name"><%= step.title %></p><div class="step-status <%= step.status %>"><%- include('../shared/components/icons/statusCircle', { status: step.status, icon: { attributes: { "aria-hidden": true } } }) %></div></li>
		<% }) %></ul></div>

		<% if (workout.currentStep) { %>
			<div class="current-workout-step-container"><div class="session-header"><div class="session-header-text"><p>CURRENT STEP</p><h3><%= workout.currentStep.title %></h3></div></div>
				<%- include("workoutLogsForm", { workoutLogForm: workout.currentStep }) %>
			</div>
		<% } else if (workout.showFinish) { %>
			<div class="finish-workout-session-button-container"><form method="POST" action="<%= workout.finishForm.action %>"><input type="hidden" name="daysDifference" value="<%= workout.finishForm.daysDifference ?? 0 %>">
				<%- include('../shared/components/button/button', { button: { label: "Finish session", type: "submit" } }) %>
			</form></div>
		<% } else if (workout.showMissingLogs) { %><div class="no-session-step-container"><p>( WORKOUT LOGS NOT CREATED )</p></div><% } %>
	<% } else { %>
		<div class="no-workout-session-container"><div class="session-step-list-container"><ul><% workout.steps.forEach(step => { %>
			<li><div class="session-step-list-item"><span class="step-order"><%= step.orderLabel %></span><p class="step-name"><%= step.title %></p><div class="step-status planned"><%- include('../shared/components/icons/statusCircle', { status: "planned", icon: { attributes: { "aria-hidden": true } } }) %></div></div></li>
		<% }) %></ul></div>
		<% if (workout.showStart) { %><div class="button-container"><form method="POST" action="<%= workout.startForm.action %>"><input type="hidden" name="daysDifference" value="<%= workout.startForm.daysDifference ?? 0 %>">
			<%- include('../shared/components/button/button', { button: { label: "Start workout session", type: "submit", iconOnly: true, alternativeClassname: "session-start-button", renderIcon: () => include("../shared/components/icons/playCircle", { icon: { attributes: { "aria-hidden": true } } }) } }) %>
		</form></div><% } %></div>
	<% } %>
</article>
