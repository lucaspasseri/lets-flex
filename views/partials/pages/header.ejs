<%
	const username = locals?.shell?.currentUser?.name ?? locals?.authUser?.name ?? "Guest";
	const currentUser = locals?.shell?.currentUser ?? locals?.authUser ?? null;
	const profileAccessibleLabel = currentUser
		? `View profile for ${username}`
		: "View profile";
%>

<header class="page-header">
	<a class="page-header__home" href="/" aria-label="Let's Flex home">
		<%- include("logo"); %>
	</a>
	<a
		class="page-header__profile"
		href="/profile"
		aria-label="<%= profileAccessibleLabel %>"
		title="<%= profileAccessibleLabel %>"
	>
		<span class="page-header__avatar" aria-hidden="true">
			<%- include("../shared/components/icons/guestUser", {icon: {
				attributes: {
						"stroke-width": 3,
						"aria-hidden": "true",
						focusable: "false"
					}
				}})
			%>
		</span>
		<span class="page-header__identity">
			<span class="page-header__username"><%= username %></span>
			<% if (currentUser?.role === "guest") { %><span class="page-header__status">Temporary workspace</span><% } %>
		</span>
	</a>
</header>
