<% const username = locals?.appState?.users?.current?.name ?? "Guest" %>

<header class="page-header">
	<div class="logoContainer">
		<a href="/"> <%- include('logo'); %> </a>
	</div>
	<button
		type="button"
		class="avatar-container"
		data-modal-open="logoutUserModalId"
	>
		<div class="avatar">
			<%- include("../shared/components/icons/guestUser", {icon: {
						attributes: {
						"stroke-width": 3,
						width: 40,
						height: 40
					}
				}}) 
			%>
	</div>
		<div class="avatar-name">
			<p><%= username %></p>
		</div>
	</button>
</header>
