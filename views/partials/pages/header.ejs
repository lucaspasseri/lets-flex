<%
	const username = locals?.shell?.currentUser?.name ?? locals?.authUser?.name ?? "Guest";
	const profileAccessibleLabel = locals?.shell?.currentUser || locals?.authUser
		? `Choose profile. Current profile: ${username}`
		: "Choose a profile";
%>

<header class="page-header">
	<a class="page-header__home" href="/" aria-label="Let's Flex home">
		<%- include("logo"); %>
	</a>
	<a
		class="page-header__profile"
		href="/profile"
		aria-label="<%= profileAccessibleLabel %>"
		title="<%= profileAccessibleLabel %>"
	>
		<span class="page-header__avatar" aria-hidden="true">
			<%- include("../shared/components/icons/guestUser", {icon: {
				attributes: {
						"stroke-width": 3,
						"aria-hidden": "true",
						focusable: "false"
					}
				}})
			%>
		</span>
		<span class="page-header__username"><%= username %></span>
	</a>
</header>
<% if ((locals?.shell?.currentUser?.role ?? locals?.authUser?.role) === "guest") { %>
	<p role="status">Guest data is temporary and expires 15 days after entry.</p>
<% } %>
