<div class="brand-mark">
	<svg class="brand-mark__svg" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
		<defs>
			<linearGradient id="brand-ring" x1="50" y1="55" x2="190" y2="185" gradientUnits="userSpaceOnUse">
				<stop offset="0" stop-color="#ff3158" />
				<stop offset="0.5" stop-color="#f8fbff" />
				<stop offset="1" stop-color="#32c7ff" />
			</linearGradient>
			<linearGradient id="brand-word" x1="78" y1="0" x2="164" y2="0" gradientUnits="userSpaceOnUse">
				<stop offset="0" stop-color="#ff8ba0" />
				<stop offset="0.5" stop-color="#ffffff" />
				<stop offset="1" stop-color="#82e1ff" />
			</linearGradient>
			<radialGradient id="brand-core" cx="50%" cy="42%" r="62%">
				<stop offset="0" stop-color="#243b59" stop-opacity="0.82" />
				<stop offset="0.58" stop-color="#101827" stop-opacity="0.96" />
				<stop offset="1" stop-color="#070a11" />
			</radialGradient>
			<filter id="brand-arm-glow" x="-80%" y="-80%" width="260%" height="260%">
				<feGaussianBlur stdDeviation="3.5" result="blur" />
				<feMerge>
					<feMergeNode in="blur" />
					<feMergeNode in="SourceGraphic" />
				</feMerge>
			</filter>
			<filter id="brand-soft-glow" x="-50%" y="-50%" width="200%" height="200%">
				<feGaussianBlur stdDeviation="5" result="blur" />
				<feMerge>
					<feMergeNode in="blur" />
					<feMergeNode in="SourceGraphic" />
				</feMerge>
			</filter>
		</defs>

		<circle class="brand-mark__halo" cx="120" cy="120" r="76" />

		<!-- The forearm rotates around the elbow while the upper arm stays anchored. -->
		<g class="brand-mark__arm brand-mark__arm--red">
			<path class="brand-mark__upper-arm" d="M83 106 C68 101 53 105 40 116 L36 128 L41 140 C55 151 70 154 83 147 Z" />
			<path class="brand-mark__arm-detail" d="M47 117 C58 111 71 112 80 119" />
			<g class="brand-mark__forearm">
				<path d="M49 111 C36 108 25 109 16 113 L10 109 L5 118 L8 128 L5 138 L10 147 L16 143 C28 147 39 147 49 142 Z" />
				<path class="brand-mark__arm-detail" d="M16 115 L20 128 L16 141 M25 118 H44" />
			</g>
			<circle class="brand-mark__elbow" cx="43" cy="128" r="10.5" />
		</g>

		<g class="brand-mark__arm brand-mark__arm--blue" transform="translate(240 0) scale(-1 1)">
			<path class="brand-mark__upper-arm" d="M83 106 C68 101 53 105 40 116 L36 128 L41 140 C55 151 70 154 83 147 Z" />
			<path class="brand-mark__arm-detail" d="M47 117 C58 111 71 112 80 119" />
			<g class="brand-mark__forearm">
				<path d="M49 111 C36 108 25 109 16 113 L10 109 L5 118 L8 128 L5 138 L10 147 L16 143 C28 147 39 147 49 142 Z" />
				<path class="brand-mark__arm-detail" d="M16 115 L20 128 L16 141 M25 118 H44" />
			</g>
			<circle class="brand-mark__elbow" cx="43" cy="128" r="10.5" />
		</g>

		<circle class="brand-mark__core" cx="120" cy="120" r="63" />
		<circle class="brand-mark__ring brand-mark__ring--outer" cx="120" cy="120" r="67" />
		<circle class="brand-mark__ring brand-mark__ring--inner" cx="120" cy="120" r="59" />

		<g class="brand-mark__lettering">
			<text class="brand-mark__kicker" x="120" y="105" text-anchor="middle">LET'S</text>
			<text class="brand-mark__word" x="120" y="142" text-anchor="middle">FLEX</text>
			<path class="brand-mark__underline" d="M82 151 H158" />
		</g>
	</svg>
</div>
