<%
	const username = locals?.shell?.currentUser?.name ?? locals?.authUser?.name ?? "Guest";
	const currentUser = locals?.shell?.currentUser ?? locals?.authUser ?? null;
	const activeNavigation = locals?.shell?.activeNavigation ?? null;
	const translate = typeof locals?.t === "function"
		? locals.t
		: (_key, options = {}) => options.defaultValue ?? "";
	const profileAccessibleLabel = currentUser
		? translate("account.profileFor", {
				name: username,
				defaultValue: `View profile for ${username}`,
			})
		: translate("account.viewProfile", { defaultValue: "View profile" });
	const openNavigationLabel = translate("application.openNavigation", { defaultValue: "Open navigation menu" });
	const closeNavigationLabel = translate("application.closeNavigation", { defaultValue: "Close navigation menu" });
	const navigationItems = [
		{ id: "dashboard", href: "/", label: translate("navigation.dashboard", { defaultValue: "Dashboard" }) },
		{ id: "history", href: "/history", label: translate("navigation.history", { defaultValue: "History" }) },
		{ id: "progress", href: "/progress", label: translate("navigation.progress", { defaultValue: "Progress" }) },
		{ id: "programs", href: "/programs", label: translate("navigation.programs", { defaultValue: "Programs" }) },
		{ id: "library", href: "/library", label: translate("navigation.library", { defaultValue: "Library" }) },
		...(locals?.isAdmin ? [{ id: "admin-exercises", href: "/admin/library/exercises", label: translate("navigation.manageExercises", { defaultValue: "Manage exercises" }) }] : []),
	];
%>

<div class="application-chrome" data-application-chrome>
	<header class="page-header">
		<a class="page-header__home" href="/" aria-label="<%= translate("application.home", { defaultValue: "Let's Flex home" }) %>">
			<%- include("logo"); %>
		</a>
		<button
			type="button"
			class="page-header__menu-toggle"
			aria-label="<%= openNavigationLabel %>"
			data-open-label="<%= openNavigationLabel %>"
			data-close-label="<%= closeNavigationLabel %>"
			aria-expanded="false"
			aria-controls="application-menu"
			data-application-menu-toggle
		>
			<span class="page-header__menu-icon" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
		</button>
	</header>

	<div
		class="application-menu"
		id="application-menu"
		aria-hidden="true"
		data-application-menu
		inert
	>
		<nav class="primary-navigation" aria-label="<%= translate("navigation.primary", { defaultValue: "Primary" }) %>">
			<ul class="primary-navigation__list">
				<% navigationItems.forEach(item => { %>
					<% const isActive = item.id === activeNavigation; %>
					<li class="primary-navigation__item">
						<a
							class="primary-navigation__link"
							href="<%= item.href %>"
							<% if (isActive) { %>aria-current="page"<% } %>
							data-application-navigation-link
						>
							<span><%= item.label %></span>
							<span
								class="primary-navigation__indicator<%= isActive ? " is-active" : "" %>"
								aria-hidden="true"
							></span>
						</a>
					</li>
				<% }) %>
			</ul>
		</nav>

		<footer class="application-chrome__footer">
			<%- include("languageSwitcher") %>
			<a
				class="application-chrome__profile"
				href="/profile"
				aria-label="<%= profileAccessibleLabel %>"
				title="<%= profileAccessibleLabel %>"
				<% if (activeNavigation === "profile") { %>aria-current="page"<% } %>
				data-application-navigation-link
			>
				<span class="application-chrome__avatar" aria-hidden="true">
					<%- include("../shared/components/icons/guestUser", {icon: {
						attributes: {
								"stroke-width": 3,
								"aria-hidden": "true",
								focusable: "false"
							}
						}})
					%>
				</span>
				<span class="application-chrome__identity">
					<span class="application-chrome__username"><%= username %></span>
				<% if (currentUser?.role === "guest") { %><span class="application-chrome__status"><%= translate("account.temporaryWorkspace", { defaultValue: "Temporary workspace" }) %></span><% } %>
				</span>
			</a>
		</footer>
	</div>
</div>
