<%
		const { id, eyebrow, heading, description, items, emptyState, createAction, clearSelectionAction } = locals.profilePicker;
%>

<section class="profile-picker" id="<%= id %>" aria-labelledby="<%= id %>-heading">
	<header class="profile-picker__header">
		<div>
			<p class="profile-picker__eyebrow"><%= eyebrow %></p>
			<h1 id="<%= id %>-heading"><%= heading %></h1>
			<p class="profile-picker__description"><%= description %></p>
			</div>
			<% if (items.length > 0) { %>
				<div class="profile-picker__actions">
					<% if (clearSelectionAction.isVisible) { %>
						<%- include("../../shared/components/button/button", { button: {
							label: clearSelectionAction.label,
							variant: "ghost",
							attributes: {
								"data-modal-open": clearSelectionAction.modal.id,
								"aria-label": clearSelectionAction.accessibleLabel
							}
						} }) %>
					<% } %>
					<%- include("../../shared/components/button/button", { button: {
						label: createAction.label,
						variant: "secondary",
						renderIcon: () => include("../../icons/plus"),
						attributes: { "data-modal-open": createAction.modalId, "aria-label": createAction.accessibleLabel }
					} }) %>
				</div>
			<% } %>
	</header>

	<% if (items.length === 0) { %>
		<%- include("profilePickerEmptyState", { profilePickerEmptyState: { ...emptyState, createAction } }) %>
	<% } else { %>
		<ul class="profile-picker__list" aria-label="Available profiles">
			<% items.forEach(profileCard => { %>
				<li class="profile-picker__list-item">
					<%- include("profileCard", { profileCard }) %>
				</li>
			<% }) %>
		</ul>
	<% } %>
</section>
