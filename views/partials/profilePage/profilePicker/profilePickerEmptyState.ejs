<% const { title, description, createAction } = locals.profilePickerEmptyState; %>
<div class="profile-picker-empty-state">
	<div class="profile-picker-empty-state__icon" aria-hidden="true">
		<%- include("../../shared/components/icons/guestUser", { icon: { label: "Profile" } }) %>
	</div>
	<h2><%= title %></h2>
	<p><%= description %></p>
	<%- include("../../shared/components/button/button", { button: {
		label: createAction.label,
		variant: "primary",
		renderIcon: () => include("../../shared/components/icons/namedIcon", { name: "plus-circle" }),
		attributes: { "data-modal-open": createAction.modalId, "aria-label": createAction.accessibleLabel }
	} }) %>
</div>
