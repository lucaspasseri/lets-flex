<%
	const {id, items = [], headingLevel = 3, label = null  } = locals?.switcher;
	const {label: buttonLabel = "Add", modalId} = locals?.switcher?.addAction ?? {};
%>

<section id="<%= id %>" class="entity-switcher" data-user-switcher-id="<%= id %>"
	<% if(label){ %>
		<%= 'aria-labelledby="entity-switcher-heading"' %>
	<% } %>
>
	
	<% if(label){ %>
		<% if(headingLevel === 1) { %>
			<h1 id="entity-switcher-heading">
				<%= label %>
			</h1>
 		<% } else if(headingLevel === 2){ %>
			<h2 id="entity-switcher-heading">
				<%= label %>
			</h2>
		<% } else { %>
			<h3 id="entity-switcher-heading">
				<%= label %>
			</h3>
		<% } %>
	<% } %>

	<div>
		<ul class="entity-switcher__list">
			<% items.forEach((item, index) => { %>
				<li 
					class="entity-switcher__item<%= item.isActive ? ' isActive' : ''%>"
					data-user-switcher-item-id="<%= `userSwitcher-${item.id}` %>"
				>
					<a href="<%= item.href %>">
						<span>
							<%= `U${index+1}` %>
						</span>
						<div>
							<% if(item.isActive) { %>
								<span class="entity-switcher__active-marker">
									(ACTIVE) <br/>
								</span>
							<% } %>
							<span>
								<%= item?.name %>
							</span>
						</div>
					</a>
				</li>
			<% }) %>
		</ul>

		<% if(modalId){ %>
			<button class="entity-switcher__add-button" data-modal-open="<%= modalId%>">
				<%= buttonLabel %>
			</button>
		<% } %>
	</div>
</section>
