<%
	const {id, items = [], headingLevel = 3, label = null  } = locals?.switcher;
	const {label: buttonLabel = "Add", modalId} = locals?.switcher?.addAction ?? {};
%>

<section id="<%= id %>" class="entity-switcher"
  <% if (label) { %>
    aria-labelledby="entity-switcher-heading-<%= id %>"
  <% } %>
>
	
	<% if(label){ %>
		<% if(headingLevel === 1) { %>
			<h1 id="entity-switcher-heading-<%= id %>">
				<%= label %>
			</h1>
 		<% } else if(headingLevel === 2){ %>
			<h2 id="entity-switcher-heading-<%= id %>">
				<%= label %>
			</h2>
		<% } else { %>
			<h3 id="entity-switcher-heading-<%= id %>">
				<%= label %>
			</h3>
		<% } %>
	<% } %>

	<div>
		<ul class="entity-switcher__list">
			<% items.forEach((item, index) => { %>
				<li 
					class="entity-switcher__item<%= item.isActive ? ' is-active' : ''%>"
	
				>
					<a href="<%= item.href %>"
						<% if (item.isActive) { %>aria-current="page"<% } %>
					>
						<span>
							<%= `U${index+1}` %>
						</span>
						<div>
							<% if(item.isActive) { %>
								<span class="entity-switcher__active-marker">
									(ACTIVE) <br/>
								</span>
							<% } %>
							<span>
								<%= item?.name %>
							</span>
						</div>
					</a>
				</li>
			<% }) %>
		</ul>

		<% if(modalId){ %>
			<%- include("shared/components/button/button", {button: {
					id: `entity-switcher-add-button-${id}`,
					type: "button",
					label: buttonLabel,
					className: "entity-switcher__add-button",
					attributes: {
						"data-modal-open": modalId
					}
				}}) 
			%>
		<% } %>
	</div>
</section>
