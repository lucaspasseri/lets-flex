<% 
	const {id=null, heading="", renderPanel=null, collapsed=true, renderHeaderContent = null} = locals.accordion;
	const panelId = `accordion-panel-${id}`;
%>

<div class="shared-accordion<%= collapsed ? " collapsed" : "" %>"  data-accordion>

	<button class="header" type="button" aria-controls="<%= panelId %>" data-accordion-header>
		<div class="header-base"> 
			
			<% if(heading) { %>
				<h3><%= heading %></h3>
			<% } %>

			<% if(renderHeaderContent) { %>
				<div class="header-content">
					<%- renderHeaderContent() %>
				</div>
			<% } %>

		</div>

		<div class="icon">
			<%- include("../icons/namedIcon", { name: "chevron-down" }) %>
		</div>
	</button>

	<div class="panel" id="<%= panelId%>" <%= collapsed ? "hidden" : "" %> data-accordion-panel>
		<div class="panel-content">
			<%- renderPanel && renderPanel() %>
		</div>
	</div>
	
</div>
