<% 
	const {
		id = null,
		heading = "",
		renderPanel = null,
		collapsed = true,
		renderHeaderContent = null,
		className = "",
		headerClassName = "",
		panelClassName = "",
		triggerId = `accordion-trigger-${id}`,
		panelId = `accordion-panel-${id}`
	} = locals.accordion;
%>

<div class="shared-accordion<%= className ? ` ${className}` : "" %><%= collapsed ? " collapsed" : "" %>" data-accordion>

	<button
		class="header<%= headerClassName ? ` ${headerClassName}` : "" %>"
		id="<%= triggerId %>"
		type="button"
		aria-controls="<%= panelId %>"
		aria-expanded="<%= collapsed ? "false" : "true" %>"
		data-accordion-header
	>
		<span class="header-base">
			
			<% if(heading) { %>
				<span class="header-heading"><%= heading %></span>
			<% } %>

			<% if(renderHeaderContent) { %>
				<span class="header-content">
					<%- renderHeaderContent() %>
				</span>
			<% } %>

		</span>

		<span class="icon" aria-hidden="true">
			<%- include("../icons/namedIcon", { name: "chevron-down" }) %>
		</span>
	</button>

	<div
		class="panel<%= panelClassName ? ` ${panelClassName}` : "" %>"
		id="<%= panelId %>"
		role="region"
		aria-labelledby="<%= triggerId %>"
		<%= collapsed ? "hidden" : "" %>
		data-accordion-panel
	>
		<div class="panel-content">
			<%- renderPanel && renderPanel() %>
		</div>
	</div>
	
</div>
