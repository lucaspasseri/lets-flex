<% 
	const {id, heading, renderPanel, collapsed} = locals.accordion;
	const panelId = `accordion-panel-${id}`;
%>

<div class="shared-accordion<%= collapsed ? " collapsed" : "" %>"  data-accordion>

	<button class="header" type="button" aria-controls="<%= panelId %>" data-accordion-header>
		<h3><%= heading %></h3>
		<div class="icon">
			<%- include("../../../icons/chevron-down") %>
		</div>
	</button>

	<div class="panel" id="<%= panelId%>" <%= collapsed ? "hidden" : "" %> data-accordion-panel>
		<div class="panel-content">
			<%- renderPanel && renderPanel() %>
		</div>
	</div>
	
</div>
