<%
	const {id = null, title="Generic modal", showTitle = true, renderContent} = locals?.modal;
	const titleId = `${id}-title`;
%>

<div 
	data-modal
	<%= `id=${id}` %>
	hidden
	role="dialog"
	aria-modal="true"
	<% if (showTitle) { %>
		aria-labelledby="<%= titleId %>"
	<% } else { %>
		aria-label="<%= title %>"
	<% } %>
	class="modal"
>
	<div data-modal-backdrop class="modal__backdrop"></div>
	<div data-modal-content tabindex="-1" class="modal__content">
		<header class="modal__header">
			<% if (showTitle) { %>
				<h2 id="<%= titleId %>">
					<%= title %>
				</h2>
			<% } %>
				<%- include("../button/button", {button: { 
						type: "button",
						label: "Close modal",
						renderIcon: () => include("../icons/close"),
						variant: "secondary",
						iconOnly: true,
						attributes: {
							"data-modal-close-button": null,
						},
						alternativeClassname: "modal__close"
					}}) 
				%>
		</header>
		<div class="modal__body">
			<%- renderContent && renderContent() %>
		</div>

		<footer class="modal__footer">
		</footer>
	</div>
</div>
