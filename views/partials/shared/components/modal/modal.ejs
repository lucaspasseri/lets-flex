<%
	const translate = typeof locals?.t === "function"
		? locals.t
		: (_key, options = {}) => options.defaultValue ?? "";
	const {id = null, title = null, showTitle = true, openOnLoad = false, renderContent} = locals?.modal;
	const resolvedTitle = title ?? translate("modal.genericTitle", { defaultValue: "Generic modal" });
	const titleId = `${id}-title`;
%>

<div 
	data-modal
	<% if (openOnLoad) { %>data-modal-open-on-load<% } %>
	<%= `id=${id}` %>
	hidden
	role="dialog"
	aria-modal="true"
	<% if (showTitle) { %>
		aria-labelledby="<%= titleId %>"
	<% } else { %>
		aria-label="<%= resolvedTitle %>"
	<% } %>
	class="modal"
>
	<div data-modal-backdrop class="modal__backdrop"></div>
	<div data-modal-content tabindex="-1" class="modal__content">
		<header class="modal__header">
			<% if (showTitle) { %>
				<h2 id="<%= titleId %>">
					<%= title %>
				</h2>
			<% } %>
				<%- include("../button/button", {button: { 
						type: "button",
						labelKey: "modal.close",
						label: translate("modal.close", { defaultValue: "Close modal" }),
						renderIcon: () => include("../icons/close"),
						variant: "secondary",
						iconOnly: true,
						attributes: {
							"data-modal-close-button": null,
						},
						alternativeClassname: "modal__close"
					}}) 
				%>
		</header>
		<div class="modal__body">
			<%- renderContent && renderContent() %>
		</div>

		<footer class="modal__footer">
		</footer>
	</div>
</div>
