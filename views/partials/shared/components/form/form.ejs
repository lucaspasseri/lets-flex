<%
	const { heading = "Welcome!", description = null, action="/", slots = {}} = locals?.form ?? {};
%>

<form method="POST" action="<%= action %>" class="form">
	<div class="form-header">
		<h3>
			<%= heading %>
		</h3>
		<% if(description) { %>
			<%= description %>
		<% } %>
	</div>
	<% if (slots.body) { %>
		<div class="form-body">
			<%- slots.body %>
		</div>
	<% } %>

	<% if(slots.footer) { %>
		<div class="form-footer">
			<%- slots.footer %>
		</div>
	<% } %>
</form>