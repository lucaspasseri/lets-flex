<%
	const { id = null, heading = null, description = null, action="/", method="POST", slots = {}, attributes = {}} = locals?.form ?? {};
%>

<form 
	<% if (id) { %>id="<%= id %>"<% } %>
	method="<%= method %>"
	action="<%= action %>" 
	class="form"
	<% Object.entries(attributes).forEach(([name, value]) => { %>
		<% if (value === true || value === null) { %>
			<%= name %>
		<% } else if (value !== false && value !== undefined) { %>
			<%= name %>="<%= value %>"
		<% } %>
	<% }) %>
	>
	<% if (locals.csrfToken) { %>
		<input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
	<% } %>
	<% if (heading || description) { %>
		<div class="form-header">
			<% if (heading) { %><h3><%= heading %></h3><% } %>
			<% if (description) { %><span><%= description %></span><% } %>
		</div>
	<% } %>
	<% if (slots.body) { %>
		<div class="form-body">
			<%- slots.body %>
		</div>
	<% } %>

	<% if(slots.footer) { %>
		<div class="form-footer">
			<%- slots.footer %>
		</div>
	<% } %>
</form>
