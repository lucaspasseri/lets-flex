<%
	const { heading = "Welcome!", description = null, action="/"} = locals?.form ?? {};
%>

<form method="POST" action="<%= action %>" class="form">
	<div class="form-header">
		<h3>
			<%= heading %>
		</h3>
		<% if(description) { %>
			<%= description %>
		<% } %>
	</div>
	<div class="form-body"></div>

	<div class="form-footer">
		
	</div>
</form>