<%
	const { id = null, heading = "Welcome!", description = null, action="/", slots = {}, attributes = {}} = locals?.form ?? {};
%>

<form 
	<% if (id) { %>id="<%= id %>"<% } %>
	method="POST" 
	action="<%= action %>" 
	class="form"
	<% Object.entries(attributes).forEach(([name, value]) => { %>
		<% if (value === true || value === null) { %>
			<%= name %>
		<% } else if (value !== false && value !== undefined) { %>
			<%= name %>="<%= value %>"
		<% } %>
	<% }) %>
	>
	<div class="form-header">
		<h3>
			<%= heading %>
		</h3>
		<% if(description) { %>
			<span><%= description %></span>
		<% } %>
	</div>
	<% if (slots.body) { %>
		<div class="form-body">
			<%- slots.body %>
		</div>
	<% } %>

	<% if(slots.footer) { %>
		<div class="form-footer">
			<%- slots.footer %>
		</div>
	<% } %>
</form>
