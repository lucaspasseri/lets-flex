<%
	const field = locals?.field ?? {};

	const {
		id,
		name,
		label = "",
		control = "input",
		type = "text",
		value = "",
		required = false,
		disabled = false,
		options = [],
		defaultOption = {
			label: "Select an option...",
			value: ""
		},
		hint = required ? "(required)" : "(optional)",
		error = null,
		attributes = {}
	} = field;

	const controlPaths = {
		input: "controls/input",
		select: "controls/select",
		textarea: "controls/textarea"
	};

	const controlPath = controlPaths[control];

	if (!id) {
		throw new Error("A form field requires an id.");
	}

	if (!name) {
		throw new Error(`The form field "${id}" requires a name.`);
	}

	if (!controlPath) {
		throw new Error(`Unsupported form control: "${control}".`);
	}
%>

<div class="form-field">
	<label class="form-field__label" for="<%= id %>">
		<%= label %>

		<% if (required) { %>
			<span aria-hidden="true">*</span>
		<% } %>
	</label>

	<%- include(controlPath, {
		control: {
			id,
			name,
			type,
			value,
			required,
			disabled,
			options,
			defaultOption,
			error,
			attributes
		}
	}) %>

	<p
		class="form-field__hint"
		id="<%= `${id}-hint` %>"
	>
		<%= hint %>
	</p>

	<% if (error) { %>
		<p
			class="form-field__error"
			id="<%= `${id}-error` %>"
		>
			<%= error %>
		</p>
	<% } %>
</div>