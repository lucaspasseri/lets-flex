<%
	const field = locals?.field ?? {};
	const translate = typeof locals?.t === "function"
		? locals.t
		: (_key, options = {}) => options.defaultValue ?? "";

	const {
		id,
		name,
		label = "",
		control = "input",
		type = "text",
		value = "",
		required = false,
		disabled = false,
		options = [],
		defaultOption = null,
		hint = null,
		error = null,
		attributes = {},
		className = null
	} = field;
	const resolvedDefaultOption = defaultOption ?? {
		label: translate("form.selectOption", { defaultValue: "Select an option..." }),
		value: ""
	};
	const resolvedHint = hint ?? (required
		? translate("form.requiredHint", { defaultValue: "(required)" })
		: translate("form.optionalHint", { defaultValue: "(optional)" }));

	const controlPaths = {
		input: "controls/input",
		select: "controls/select",
		textarea: "controls/textarea"
	};

	const controlPath = controlPaths[control];

	if (!id) {
		throw new Error("A form field requires an id.");
	}

	if (!name) {
		throw new Error(`The form field "${id}" requires a name.`);
	}

	if (!controlPath) {
		throw new Error(`Unsupported form control: "${control}".`);
	}
%>

<div class="form-field<%= className ? ` ${className}` : "" %>">
	<label class="form-field__label" for="<%= id %>">
		<span><%= label %></span>
		<span class="form-field__requirement">
			<%= required
				? translate("form.required", { defaultValue: "Required" })
				: translate("form.optional", { defaultValue: "Optional" }) %>
		</span>
	</label>

	<%- include(controlPath, {
		control: {
			id,
			name,
			type,
			value,
			required,
			disabled,
			options,
			defaultOption: resolvedDefaultOption,
			hint: resolvedHint,
			error,
			attributes
		}
	}) %>

	<% if (resolvedHint) { %>
		<p class="form-field__hint" id="<%= `${id}-hint` %>">
			<%= resolvedHint %>
		</p>
	<% } %>

	<% if (error) { %>
		<p
			class="form-field__error"
			id="<%= `${id}-error` %>"
		>
			<%= error %>
		</p>
	<% } %>
</div>
