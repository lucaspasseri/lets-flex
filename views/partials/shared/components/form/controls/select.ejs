<%
	const {
		id,
		name,
		value = "",
		required = false,
		disabled = false,
		hint = null,
		options = [],
		defaultOption = {
			label: "Select an option...",
			value: ""
		},
		error = null,
		attributes = {}
	} = locals?.control ?? {};

	const describedBy = [
		hint ? `${id}-hint` : null,
		error ? `${id}-error` : null
	]
		.filter(Boolean)
		.join(" ");

	const hasSelectedValue = options.some(
		option => String(option.value) === String(value)
	);

	const validAttributeName = /^[a-zA-Z_:][a-zA-Z0-9:._-]*$/;

	const reservedAttributes = new Set([
		"class",
		"id",
		"name",
		"required",
		"disabled",
		"aria-invalid",
		"aria-describedby"
	]);

	const additionalAttributes = Object.entries(attributes).filter(
		([attributeName]) =>
			validAttributeName.test(attributeName) &&
			!reservedAttributes.has(attributeName)
	);
%>

<select
	class="form-select"
	id="<%= id %>"
	name="<%= name %>"

	<% if (required) { %>
		required
	<% } %>

	<% if (disabled) { %>
		disabled
	<% } %>

	<% if (error) { %>
		aria-invalid="true"
	<% } %>

	<% if (describedBy) { %>
		aria-describedby="<%= describedBy %>"
	<% } %>

	<% additionalAttributes.forEach(([attributeName, attributeValue]) => { %>
		<% if (attributeValue === true) { %>
			<%= attributeName %>
		<% } else if (
			attributeValue !== false &&
			attributeValue !== null &&
			attributeValue !== undefined
		) { %>
			<%= attributeName %>="<%= attributeValue %>"
		<% } %>
	<% }) %>
>
	<option
		value="<%= defaultOption.value %>"

		<% if (!hasSelectedValue) { %>
			selected
		<% } %>

		<% if (required) { %>
			disabled
		<% } %>
	>
		<%= defaultOption.label %>
	</option>

	<% options.forEach(option => { %>
		<option
			value="<%= option.value %>"

			<% if (String(option.value) === String(value)) { %>
				selected
			<% } %>

			<% if (option.disabled) { %>
				disabled
			<% } %>
		>
			<%= option.label %>
		</option>
	<% }) %>
</select>
