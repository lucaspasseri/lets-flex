<%
	const {
		id,
		type = "button",
		label,
		attributes = {},
		renderIcon,
		iconAfterText = false,
		iconOnly = false,
		variant = "primary",
		disabled = false,
	} = locals.button;

	const variantClasses = {
		primary: "shared-button--primary",
		secondary: "shared-button--secondary",
		danger: "shared-button--danger",
		ghost: "shared-button--ghost",
	};

	const variantClass =
		variantClasses[variant] ?? variantClasses.primary;

	const classNames = [
		"shared-button",
		variantClass,
		iconAfterText && "shared-button--icon-after",
		iconOnly && "shared-button--icon-only",
	]
		.filter(Boolean)
		.join(" ");
%>

<button
	<% if (id) { %>
		id="<%= id %>"
	<% } %>

	type="<%= type %>"
	class="<%= classNames %>"

	<% if (iconOnly) { %>
		aria-label="<%= label %>"
	<% } %>

	<% if (disabled) { %>
		disabled
	<% } %>

	<% Object.entries(attributes).forEach(([name, value]) => { %>
		<% if (value === true || value === null) { %>
			<%= name %>
		<% } else if (value !== false && value !== undefined) { %>
			<%= name %>="<%= value %>"
		<% } %>
	<% }) %>
>
	<% if (renderIcon) { %>
		<%- renderIcon() %>
	<% } %>

	<% if (!iconOnly) { %>
		<span class="shared-button__label"><%= label %></span>
	<% } %>
</button>