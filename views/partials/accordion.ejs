<% 
const contentArr = locals?.contentArr || []; 
const renderContent = locals?.renderContent || function(content) { return `<p>${content.name}</p>` };
%>


<% if(contentArr.length === 0){ %>
	<p>No content</p>
<% } else { %>	
	<div class="accordion">
		<% contentArr.forEach(content => { %>
			<div class="accordion-item">
				<input type="radio" id="section<%= content.id %>" name="accordion" />
				<label for="section<%= content.id %>" class="accordion-header">
					<span class="accordion-title"><%= content?.step_order || "" %>: <%= content?.name || "" %></span>
					<div class="accordion-icon">
						<svg
							viewBox="0 0 16 16"
							fill="none"
							height="16"
							width="16"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M4.293 5.293a1 1 0 0 1 1.414 0L8 7.586l2.293-2.293a1 1 0 0 1 1.414 1.414l-3 3a1 1 0 0 1-1.414 0l-3-3a1 1 0 0 1 0-1.414z"
								fill="currentColor"
							></path>
						</svg>
					</div>
				</label>
				<div class="content">
					<%- renderContent(content) %>
				</div>
			</div>
		<% }) %>
	</div>
<% } %>


