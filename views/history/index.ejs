<main class="main workout-history" data-workout-history-page>
	<%- include("../partials/shared/components/pageHeading", { heading }) %>

	<section class="history-filter" aria-labelledby="history-filters-heading">
		<div class="history-section-heading">
			<div>
				<p class="history-eyebrow">Find a workout</p>
				<h2 id="history-filters-heading">Filter history</h2>
			</div>
			<% if (filters.hasFilters) { %><span class="history-filter__state">Filters applied</span><% } %>
		</div>
		<form method="GET" action="<%= filters.action %>" class="history-filter__form">
			<div class="history-filter__fields">
				<%- include("../partials/shared/components/form/field", { field: {
					id: "history-program", name: "programId", label: "Program", control: "select",
					value: filters.values.programId ?? "", defaultOption: { label: "All programs", value: "" },
					options: filters.programOptions, hint: "Show terminal sessions from one program."
				} }) %>
				<%- include("../partials/shared/components/form/field", { field: {
					id: "history-from-date", name: "fromDate", label: "From date", type: "date",
					value: filters.values.fromDate ?? "", hint: "Include sessions on this date."
				} }) %>
				<%- include("../partials/shared/components/form/field", { field: {
					id: "history-to-date", name: "toDate", label: "To date", type: "date",
					value: filters.values.toDate ?? "", hint: "Include sessions on this date."
				} }) %>
			</div>
			<div class="history-filter__actions">
				<%- include("../partials/shared/components/button/button", { button: {
					label: "Apply filters", type: "submit", variant: "primary"
				} }) %>
				<% if (filters.hasFilters) { %><a class="history-text-action" href="<%= filters.clearHref %>">Clear filters</a><% } %>
			</div>
		</form>
	</section>

	<section class="history-results" aria-labelledby="history-results-heading" aria-live="polite">
		<div class="history-section-heading history-section-heading--results">
			<div>
				<p class="history-eyebrow">Training record</p>
				<h2 id="history-results-heading">Sessions</h2>
			</div>
			<% if (pagination.totalPages > 1) { %><span class="history-results__page">Page <%= pagination.page %> of <%= pagination.totalPages %></span><% } %>
		</div>
		<% if (results.items.length) { %>
			<ol class="history-list">
				<% results.items.forEach(item => { %>
					<li class="history-list__item">
						<article class="history-card" data-status="<%= item.status %>">
							<div class="history-card__marker" aria-hidden="true"></div>
							<div class="history-card__body">
								<header class="history-card__header">
									<div class="history-card__title">
										<span class="history-status" data-status="<%= item.status %>"><span aria-hidden="true"></span><%= item.statusLabel %></span>
										<h3><a href="<%= item.href %>"><%= item.title %></a></h3>
										<p><%= item.programName %></p>
									</div>
									<div class="history-card__date">
										<span><%= item.historyDate.context %></span>
										<% if (item.historyDate.value) { %><time datetime="<%= item.historyDate.value %>"><%= item.historyDate.label %></time><% } else { %><strong><%= item.historyDate.label %></strong><% } %>
									</div>
								</header>
								<% if (item.scheduledDate) { %><p class="history-card__scheduled">Originally scheduled for <time datetime="<%= item.scheduledDate.value %>"><%= item.scheduledDate.label %></time></p><% } %>
								<ul class="history-card__metrics" aria-label="Exercise result summary">
									<% item.stepCounts.forEach(metric => { %><li><strong><%= metric.value %></strong><span><%= metric.label %></span></li><% }) %>
								</ul>
								<span class="history-card__summary"><%= item.stepSummary %></span>
							</div>
						</article>
					</li>
				<% }) %>
			</ol>
		<% } else { %>
			<div class="history-empty-state">
				<span class="history-empty-state__mark" aria-hidden="true">—</span>
				<h3><%= results.empty.title %></h3>
				<p><%= results.empty.message %></p>
				<% if (pagination.firstHref) { %><a class="history-primary-action" href="<%= pagination.firstHref %>">Return to the first page</a><% } %>
			</div>
		<% } %>
	</section>

	<% if (pagination.totalPages > 1) { %>
		<nav class="history-pagination" aria-label="Workout history pages">
			<% if (pagination.previousHref) { %><a href="<%= pagination.previousHref %>" rel="prev"><span aria-hidden="true">←</span> Previous</a><% } else { %><span></span><% } %>
			<span aria-current="page">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
			<% if (pagination.nextHref) { %><a href="<%= pagination.nextHref %>" rel="next">Next <span aria-hidden="true">→</span></a><% } else { %><span></span><% } %>
		</nav>
	<% } %>
</main>
