<main class="main profile">
	<div class="main-header">
		<div class="title-container"><p>ACCOUNT</p><h1><%= currentUser.name %></h1></div>
	</div>
	<section>
		<p>Role: <%= currentUser.role %></p>
		<% if (currentUser.email) { %><p>Email: <%= currentUser.email %></p><% } %>
		<% if (currentUser.role === "guest") { %>
			<p role="status">This guest workspace is temporary and expires on <%= new Date(currentUser.guestExpiresAt).toLocaleDateString() %>.</p>
		<% } %>
		<form method="POST" action="/auth/logout">
			<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
			<button type="submit">Sign out</button>
		</form>
	</section>
</main>
