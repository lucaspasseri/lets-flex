<% 
	const userId = locals?.appState?.users?.current?.id ?? null;
	const userArr = locals?.appState?.users?.items ?? [];
	const switcherData = locals?.features?.userSwitcher ?? {};
%>

<main class="main profile">
	<%- include("partials/entitySwitcher", {switcher: {
			id: switcherData.id,
			label: switcherData.label,
			headingLevel: switcherData.headingLevel,
			items: switcherData.items,
			addAction: switcherData.addAction,
		}}) 
	%>
</main>

<%- contentFor("overlays") %>

<%- include("partials/shared/components/modal/modal", { modal: { 
		id: switcherData.addAction?.modalId ?? "createUserModal", 
		title: switcherData.addAction?.label ?? "Add User", 
		renderContent: () => include("partials/newUserForm")
	}}) 
%>

