<%
	const translate = typeof locals?.t === "function" ? locals.t : (_key, options = {}) => String(options.defaultValue ?? "").replace(/\{\{(\w+)\}\}/g, (_match, name) => options[name] ?? _match);
	const roleLabels = { admin: translate("profile.administratorRole", { defaultValue: "Administrator" }), user: translate("profile.member", { defaultValue: "Member" }), guest: translate("profile.guest", { defaultValue: "Guest" }) };
	const roleLabel = roleLabels[currentUser.role] ?? roleLabels.user;
	const isGuest = currentUser.role === "guest";
	const isAdmin = currentUser.role === "admin";
	const methods = locals.authenticationMethods ?? {
		password: { label: "Password", status: "Not set", showAddForm: false },
		google: { label: "Google", status: "Not linked", email: null, action: null }
	};
	const linkMessage = locals.googleLinkMessage ?? null;
	const passwordMessage = locals.passwordMessage ?? null;
	const passwordErrors = locals.passwordErrors ?? [];
	const expirationLabel = isGuest && currentUser.guestExpiresAt
		? new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(new Date(currentUser.guestExpiresAt))
		: null;
%>

<main class="main profile" data-profile-page data-profile-role="<%= currentUser.role %>">
	<%- include("partials/shared/components/pageHeading", { heading: {
			eyebrow: translate("profile.eyebrow", { defaultValue: "Account" }),
			title: translate("profile.title", { defaultValue: "Profile" }),
			description: translate("profile.description", { defaultValue: "Review the identity and access level attached to this workspace." }),
		meta: roleLabel
	} }) %>

	<div class="profile-layout">
		<section class="profile-identity" aria-labelledby="profile-identity-heading">
			<div class="profile-identity__avatar" aria-hidden="true">
				<%- include("partials/shared/components/icons/namedIcon", { name: "user-round" }) %>
			</div>
			<div class="profile-identity__copy">
				<p class="profile-card__eyebrow"><%= translate("profile.currentIdentity", { defaultValue: "Current identity" }) %></p>
				<h2 id="profile-identity-heading"><%= currentUser.name %></h2>
				<p><%= isGuest ? translate("profile.temporaryWorkspace", { defaultValue: "Temporary workspace" }) : currentUser.email %></p>
			</div>
			<dl class="profile-facts">
				<div><dt><%= translate("profile.access", { defaultValue: "Access" }) %></dt><dd><%= roleLabel %></dd></div>
				<div><dt><%= translate("profile.storage", { defaultValue: "Storage" }) %></dt><dd><%= isGuest ? translate("profile.temporary", { defaultValue: "Temporary" }) : translate("profile.persistent", { defaultValue: "Persistent" }) %></dd></div>
			</dl>
		</section>

		<div class="profile-stack">
			<% if (!isGuest) { %>
				<section class="profile-card" aria-labelledby="authentication-methods-heading">
					<div class="profile-card__icon" aria-hidden="true">
						<%- include("partials/shared/components/icons/namedIcon", { name: "user-round" }) %>
					</div>
					<div>
						<p class="profile-card__eyebrow"><%= translate("profile.accountAccess", { defaultValue: "Account access" }) %></p>
						<h2 id="authentication-methods-heading"><%= translate("profile.authenticationMethods", { defaultValue: "Authentication methods" }) %></h2>
						<p><%= translate("profile.authenticationDescription", { defaultValue: "Connect sign-in methods intentionally. Provider email addresses never merge accounts." }) %></p>
						<% if (linkMessage) { %>
							<p class="profile-link-message profile-link-message--<%= linkMessage.type %>" role="status"><%= linkMessage.text %></p>
						<% } %>
						<ul class="profile-auth-methods">
							<li>
								<span><%= methods.password.label %></span>
								<strong><%= methods.password.status %></strong>
							</li>
							<li>
								<div>
									<span><%= methods.google.label %></span>
									<% if (methods.google.email) { %><small><%= methods.google.email %></small><% } %>
								</div>
								<div class="profile-auth-method__state">
									<strong><%= methods.google.status %></strong>
									<% if (methods.google.action) { %>
									<form method="POST" action="<%= methods.google.action.path %>">
										<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
										<button class="profile-card__link" type="submit" data-google-action><%= methods.google.action.label %></button>
									</form>
									<% } %>
								</div>
							</li>
						</ul>
						<% if (passwordMessage) { %><p class="profile-link-message" role="status"><%= passwordMessage.text %></p><% } %>
						<% if (passwordErrors.length) { %><div class="form-errors" role="alert"><ul><% passwordErrors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
						<% if (methods.password.showAddForm) { %>
							<form class="profile-password-form" method="POST" action="/profile/password">
								<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
								<%- include("partials/shared/components/form/field", { field: { id: "new-password", name: "password", label: translate("profile.newPassword", { defaultValue: "New password" }), type: "password", required: true, value: "", attributes: { autocomplete: "new-password" } } }) %>
								<%- include("partials/shared/components/form/field", { field: { id: "confirm-password", name: "confirmPassword", label: translate("profile.confirmPassword", { defaultValue: "Confirm password" }), type: "password", required: true, value: "", attributes: { autocomplete: "new-password" } } }) %>
								<%- include("partials/shared/components/button/button", { button: { label: translate("profile.addPassword", { defaultValue: "Add a password" }), type: "submit", variant: "primary" } }) %>
							</form>
						<% } %>
					</div>
				</section>
			<% } %>

			<% if (isGuest) { %>
				<section class="profile-card profile-card--notice" aria-labelledby="guest-workspace-heading">
					<div class="profile-card__icon" aria-hidden="true">
						<%- include("partials/shared/components/icons/namedIcon", { name: "calendar-x" }) %>
					</div>
					<div>
						<p class="profile-card__eyebrow"><%= translate("profile.temporaryData", { defaultValue: "Temporary data" }) %></p>
						<h2 id="guest-workspace-heading"><%= translate("profile.guestWorkspace", { defaultValue: "Guest workspace" }) %></h2>
						<p><%= translate("profile.guestDescription", { defaultValue: "Your programs, sessions, and private variants remain isolated from other guests, but they are automatically removed after expiration." }) %></p>
						<% if (expirationLabel) { %><p class="profile-card__status" role="status"><%= translate("profile.expires", { defaultValue: "Expires" }) %> <strong><%= expirationLabel %></strong></p><% } %>
						<a class="profile-card__link" href="/auth/login?tab=signup&amp;returnTo=/profile"><%= translate("profile.createPermanent", { defaultValue: "Create a permanent account" }) %></a>
					</div>
				</section>
			<% } %>

			<% if (isAdmin) { %>
				<section class="profile-card" aria-labelledby="admin-tools-heading">
					<div class="profile-card__icon" aria-hidden="true">
						<%- include("partials/shared/components/icons/namedIcon", { name: "wrench" }) %>
					</div>
					<div>
						<p class="profile-card__eyebrow"><%= translate("profile.administrator", { defaultValue: "Administrator" }) %></p>
						<h2 id="admin-tools-heading"><%= translate("profile.catalogTools", { defaultValue: "Exercise catalog tools" }) %></h2>
						<p><%= translate("profile.adminDescription", { defaultValue: "Your administrator access is limited to managing global exercises and sample variants." }) %></p>
						<a class="profile-card__link" href="/admin/library/exercises"><%= translate("profile.manageCatalog", { defaultValue: "Manage exercise catalog" }) %></a>
					</div>
				</section>
			<% } %>

			<section class="profile-card" aria-labelledby="session-controls-heading">
				<div class="profile-card__icon" aria-hidden="true">
					<%- include("partials/shared/components/icons/namedIcon", { name: "user-round-x" }) %>
				</div>
				<div>
					<p class="profile-card__eyebrow"><%= translate("profile.session", { defaultValue: "Session" }) %></p>
					<h2 id="session-controls-heading"><%= translate("profile.signOutSafely", { defaultValue: "Sign out safely" }) %></h2>
					<p><%= translate("profile.signOutDescription", { defaultValue: "End this browser session. Signing out does not grant access to or remove another account's private data." }) %></p>
					<form method="POST" action="/auth/logout">
						<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
						<%- include("partials/shared/components/button/button", { button: {
							label: translate("profile.signOut", { defaultValue: "Sign out" }),
							type: "submit",
							variant: "dangerGhost"
						} }) %>
					</form>
				</div>
			</section>
		</div>
	</div>
</main>
