<%
		const { profilePicker, createUserForm } = locals.components;
		const { clearSelectionAction } = profilePicker;
%>

<main class="main profile">
	<%- include("partials/profilePage/profilePicker/profilePicker", { profilePicker }) %>
</main>

<%- contentFor("overlays") %>
<%- include("partials/shared/components/modal/modal", { modal: {
	id: createUserForm.modal.id,
	title: createUserForm.modal.title,
	openOnLoad: createUserForm.modal.openOnLoad,
	showTitle: false,
	renderContent: () => include("partials/shared/components/form/form", { form: {
		...createUserForm.form,
		slots: {
			body: include("partials/profilePage/createUserForm/createUserFormBody", { createUserForm }),
			footer: include("partials/profilePage/createUserForm/createUserFormFooter", { createUserForm })
		}
	}})
	} }) %>

<% if (clearSelectionAction.isVisible) { %>
	<%- include("partials/shared/components/modal/modal", { modal: {
		id: clearSelectionAction.modal.id,
		title: clearSelectionAction.modal.title,
		showTitle: false,
		renderContent: () => include("partials/shared/components/form/form", { form: {
			...clearSelectionAction.form,
			slots: {
				footer: include("partials/profilePage/clearProfileSelectionFormFooter", { clearSelectionAction })
			}
		}})
	} }) %>
<% } %>
