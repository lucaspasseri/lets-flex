<% 
const {formatDate, addDays} = locals.helpers;

const currUserId = locals.sessionState?.userId ?? null;
const currProgramId = locals.sessionState?.programId ?? null;
const currCycleId = locals.sessionState?.cycleId ?? null;
const currSessionId = locals.sessionState?.sessionId ?? null;
const currDayId = locals.sessionState?.dayId ?? null;

const currProgram = locals.appState?.currentProgram ?? {};

const programArr = locals.data?.programArr ?? [];
const cycleArr = locals.data?.cycleArr ?? [];
const sessionArr = locals.data?.sessionArr ?? [];
const trainingDayArr = locals.data?.trainingDayArr ?? [];

const programBasicLineId = "programsPageProgramBasicLine";
const programBasicLineEntity = "program";
const createProgramModalId = "createProgramModal";
const chosenProgramPath = "/programs?programId=";

const cycleBasicLineId = "cyclesPageCycleBasicLine";
const cycleBasicLineEntity = "cycle";
const createCycleModalId = "createCycleModal";
const chosenCyclePath = `/programs?programId=${currProgramId}&cycleId=`;

const startDate = currProgram?.start_date && new Date(currProgram.start_date) || new Date();

const getClassName = (index, trainingDay, currCycleId) => {
	let className = "";

	if(index === 0){
		className += "startDate ";
	}

	if(trainingDay.cycle_id === null){
		className += "no-cycle";
		return className;
	}

	if(trainingDay.cycle_id === currCycleId){
		className += "day-selected";
		return className;
	}

	className += "cycle-not-selected";
	return className;
}

const dayArr = trainingDayArr.map((trainingDay, index) => {
	const hasCycleSelected = currCycleId === trainingDay.cycle_id && currCycleId !== null;
	const date =formatDate && addDays && formatDate(addDays(startDate, index ), "dd/MM");
	const className = getClassName(index, trainingDay, currCycleId);
	const href = `/programs/day?dayId=${trainingDay.training_day_id}`;

	return {
		id: index,
		trainingDayId: trainingDay.training_day_id,
		hasCycleSelected,
		date, 
		className,
		href
	}
});
%>

<main class="main programs">
	<div class="main-header">
		<% if(currUserId){ %>
			<h1>CHOOSE THE ACTIVE PROGRAM</h1>
				<%- include("partials/basicLine", {line: { basicLineId: programBasicLineId, entity: programBasicLineEntity, arr: programArr, modalId: createProgramModalId, currentItemId: currProgramId, path: chosenProgramPath }}) %>
			<% if(currProgramId) { %>
				<h2>Cycles</h2>
				<%- include("partials/basicLine", {line: { basicLineId: cycleBasicLineId, entity: cycleBasicLineEntity, arr: cycleArr, modalId: createCycleModalId, currentItemId: currCycleId, path: chosenCyclePath }}) %>
			<% } %>
		<% } else { %>
			<div class="no-active-program-container">
				<div class="content">
					<div class="image-container">
						<img src="../compasso.png" width="40" height="40" alt="compasso icon" />
					</div>
					<h2>NO ACTIVE USER</h2>
					<p>Your training architecture starts here. Create and activate your profile to enjoy the best features.</p>
					<a href="/profile">
						<svg class="icon">
							<use href="../plus.svg"></use>
						</svg>
						<p>CREATE YOUR USER PROFILE</p>
					</a>
				</div>
			</div>
		<% } %>
	</div>

	<% if(currUserId) { %>
		<div class="basic-calendar"> 
			<ul class="list">
				<% dayArr.forEach((day) => { %>
					<li class="training-day-item <%= day.className %>" data-calendar-day-id="<%= day.trainingDayId %>"> 
						<div class="container">
							<% if(day?.hasCycleSelected) { %>
								<a data-calendar-day-date="<%= day.date %>"  href="<%= day.href %>">
									<p>	<%= day.date %></p>
								</a>
							<% } else { %>
								<p >
									<%= day.date %>
								</p>
							<% } %>
						</div>
					</li>
				<% }) %>
			</ul>
		</div>
	<% } %>
</main>

<%- contentFor("overlays") %>

<%- include("partials/basicModal", {
	modal: {
		id: createProgramModalId,
		title: "Create program",
		description: "Fill in the program information below.",
		renderContent: () => include("partials/newProgramForm")
	}
}) %>

<%- include("partials/basicModal", {
	modal: {
		id: createCycleModalId,
		title: "Create cycle",
		description: "Fill in the cycle information below.",
		renderContent: () => include("partials/cycleForm")
	}
}) %>