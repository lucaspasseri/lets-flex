<%
	const {
		programSwitcher,
		cycleSwitcher,
		calendarNavigation,
		createProgramForm,
		createCycleForm,
		noActiveUser
	} = locals.components;
%>

<main class="main programs" data-programs-page>
	<% if (noActiveUser.isVisible) { %>
		<%- include("partials/programsPage/noActiveUser", { noActiveUser }) %>
	<% } else { %>
		<%- include("partials/programsPage/entitySwitcher/entitySwitcher", {
			entitySwitcher: programSwitcher,
			variant: "program"
		}) %>

		<% if (cycleSwitcher.isVisible) { %>
			<%- include("partials/programsPage/entitySwitcher/entitySwitcher", {
				entitySwitcher: cycleSwitcher,
				variant: "cycle"
			}) %>
		<% } %>

		<% if (calendarNavigation.isVisible) { %>
			<%- include("partials/programsPage/calendarNavigation/calendarNavigation", {
				calendarNavigation
			}) %>
		<% } %>
	<% } %>
</main>

<%- contentFor("overlays") %>

<% if (!noActiveUser.isVisible) { %>
	<%- include("partials/shared/components/modal/modal", { modal: {
		id: createProgramForm.modal.id,
		title: createProgramForm.modal.title,
		showTitle: false,
		renderContent: () => include("partials/shared/components/form/form", { form: {
			...createProgramForm.form,
			slots: {
				body: include("partials/programsPage/createProgramForm/createProgramFormBody", { createProgramForm }),
				footer: include("partials/programsPage/createProgramForm/createProgramFormFooter", { createProgramForm })
			}
		}})
	} }) %>
<% } %>

<% if (cycleSwitcher.isVisible) { %>
	<%- include("partials/shared/components/modal/modal", { modal: {
		id: createCycleForm.modal.id,
		title: createCycleForm.modal.title,
		showTitle: false,
		renderContent: () => include("partials/shared/components/form/form", { form: {
			...createCycleForm.form,
			slots: {
				body: include("partials/programsPage/createCycleForm/createCycleFormBody", { createCycleForm }),
				footer: include("partials/programsPage/createCycleForm/createCycleFormFooter", { createCycleForm })
			}
		}})
	} }) %>
<% } %>
