DATABASE_URL=postgresql://localhost/lets_flex
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-long-random-value
SESSION_MAX_AGE_MS=1296000000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
ALLOW_DATABASE_RESET=false
GUEST_TTL_DAYS=15
GUEST_CLEANUP_BATCH_SIZE=100
