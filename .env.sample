NODE_ENV=development
DATABASE_URL=postgresql://localhost/lets_flex
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-long-random-value
SESSION_MAX_AGE_MS=1296000000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MS=1800000
RESEND_API_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=Let’s Flex account@auth.paxeri.dev
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
ALLOW_DATABASE_RESET=false
ALLOW_DATABASE_MIGRATION=false
ALLOW_PRODUCTION_DATABASE_MIGRATION=false
GUEST_TTL_DAYS=15
GUEST_CLEANUP_BATCH_SIZE=100

OBJECT_STORAGE_PROVIDER=local
MEDIA_PUBLIC_URL=http://localhost:3000
R2_BUCKET_NAME=lets-flex-media-dev
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_DEVELOPMENT_BUCKET_NAME=lets-flex-media-dev
R2_SMOKE_TEST_CONFIRMATION=I_CONFIRM_DEVELOPMENT_BUCKET
