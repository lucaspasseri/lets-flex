{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext"
	},
	"include": [
		"app.js",
		"routes/**/*.js",
		"middlewares/**/*.js",
		"utils/**/*.js",
		"db/pool.js",
		"src/**/*.js",
		"views/**/*.js"
	],
	"exclude": ["node_modules", "public"]
}
